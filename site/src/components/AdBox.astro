---
interface Props {
  minHeight: string;
  label?: string;
}
const { minHeight, label = 'Advertisement · 광고' } = Astro.props;
---

<div class="ad-box" style={`min-height:${minHeight}`}>
  <span>{label}</span>
</div>

<style>
  .ad-box {
    width: 100%;
    background: var(--surface-low);
    border: 1px dashed var(--outline);
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    color: var(--text-sub);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-align: center;
    padding: 16px;
  }
</style>
