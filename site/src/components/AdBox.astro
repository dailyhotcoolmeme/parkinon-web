---
import { t } from '../i18n';

interface Props {
  minHeight: string;
  label?: string;
}
const locale = Astro.currentLocale ?? 'ko';
// 광고 자리 표시. 'Advertisement' 는 어느 언어판에서나 그대로 두고 뒤에 그 나라 말을 덧붙인다.
const { minHeight, label = `Advertisement · ${t(locale, 'ad.label')}` } = Astro.props;
---

<div class="ad-box" style={`min-height:${minHeight}`}>
  <span>{label}</span>
</div>

<style>
  .ad-box {
    width: 100%;
    background: var(--surface-low);
    border: 1px dashed var(--outline);
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    color: var(--text-sub);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-align: center;
    padding: 16px;
  }
</style>
