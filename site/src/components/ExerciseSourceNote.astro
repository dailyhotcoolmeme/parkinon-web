---
/*
 * 운동 영상 허브 상단의 출처·근거 안내 — 텍스트 세 줄(오너 확정 2026-08-07).
 * 연한 배경 둥근 박스로 감싼다(오너 지시 2026-08-07) — 톤은 `--secondary-container`
 * (라이트 #e8f5e9 연초록 / 다크 #1b4332, 기존 디자인 토큰. 새 색을 만들지 않았다).
 */
import type { ExerciseSource } from '../lib/exerciseSource';

interface Props {
  source: ExerciseSource;
}
const { source } = Astro.props;
---

<div class="source-note">
  <p class="intro">{source.intro.map((run) => (run.bold ? <b>{run.text}</b> : run.text))}</p>
  <div class="meta">
    <p>
      {source.citation}
      {source.link && (
        <>
          {' · '}
          <a href={source.link.href} target="_blank" rel="noopener">
            {source.link.label}
          </a>
        </>
      )}
    </p>
    <p>{source.disclaimer}</p>
  </div>
</div>

<style>
  .source-note {
    padding: 20px 22px;
    background: var(--secondary-container);
    border-radius: 14px;
    margin-bottom: 4px;
  }
  .intro {
    font-size: 15px;
    line-height: 1.75;
    color: var(--on-secondary-container);
  }
  /* 출처 + 상담 문구를 한 덩어리로 묶는다 — 둘 다 같은 크기·색, 줄 간격만 좁게 */
  .meta {
    margin-top: 14px;
  }
  .meta p {
    font-size: 12.5px;
    line-height: 1.6;
    color: var(--on-secondary-container);
    opacity: 0.8;
  }
  .meta p + p {
    margin-top: 3px;
  }
  .meta a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: currentColor;
    text-underline-offset: 2px;
  }
  .meta a:hover {
    opacity: 1;
  }
</style>
