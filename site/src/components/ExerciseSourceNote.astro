---
/*
 * 운동 영상 허브 상단의 출처·근거 안내.
 * 왼쪽 얇은 녹색 세로 바 + 옆에 텍스트(오너 지시 2026-08-07, 정확한 사양 그대로 구현).
 * 본문·상담 문구는 같은 글씨(크기·굵기·색 전부 동일), 출처만 보조 글씨(작게·연하게).
 * 아이콘·색 강조 없음.
 */
import type { ExerciseSource } from '../lib/exerciseSource';

interface Props {
  source: ExerciseSource;
}
const { source } = Astro.props;
---

<div class="source-note">
  <p class="body">{source.intro.map((run) => (run.bold ? <b>{run.text}</b> : run.text))}</p>
  <p class="body">{source.disclaimer}</p>
  <p class="cite">
    {source.citation}
    {source.link && (
      <>
        {' · '}
        <a href={source.link.href} target="_blank" rel="noopener">
          {source.link.label}
        </a>
      </>
    )}
  </p>
</div>

<style>
  .source-note {
    border-left: 4px solid var(--primary);
    padding: 2px 0 2px 18px;
    margin-bottom: 4px;
  }
  /*
   * 줄바꿈이 일어났을 때 실제 줄 간격(px)을 통일한다. line-height 를 1.75로 똑같이
   * 줘도 글자 크기가 다르면(본문 15px·출처 12.5px) 실제 간격은 26.25px vs 21.875px로
   * 서로 달라진다(오너 지적 2026-08-07). 그래서 비율이 아니라 **고정 px 값**을 준다.
   */
  .body {
    font-size: 15px;
    line-height: 26px;
    color: var(--text);
  }
  .body + .body {
    margin-top: 14px;
  }
  .cite {
    margin-top: 14px;
    font-size: 12.5px;
    line-height: 26px;
    color: var(--text-sub);
  }
  .cite a:hover {
    color: var(--primary);
  }
</style>
