---
/*
 * 운동 영상 허브 상단의 출처·근거 안내 — 텍스트 세 문단(오너 확정 2026-08-07).
 * 문단 전체에 박스를 씌우지 않는다. **문단 안의 핵심 수치에만** 연한 배경 칩을 준다
 * (오너 지시: "중요한 부분만 배경색 박스 넣으라고!!" → 수치(22%·31%)만 선택함).
 * 색은 기존 토큰 `--secondary-container`(라이트 연초록/다크 짝 포함) 그대로 쓴다.
 */
import type { ExerciseSource } from '../lib/exerciseSource';

interface Props {
  source: ExerciseSource;
}
const { source } = Astro.props;
---

<div class="source-note">
  <p class="intro">
    {source.intro.map((run) => (run.highlight ? <span class="num">{run.text}</span> : run.bold ? <b>{run.text}</b> : run.text))}
  </p>
  <div class="meta">
    <p>
      {source.citation}
      {source.link && (
        <>
          {' · '}
          <a href={source.link.href} target="_blank" rel="noopener">
            {source.link.label}
          </a>
        </>
      )}
    </p>
    <p>{source.disclaimer}</p>
  </div>
</div>

<style>
  .source-note {
    padding: 18px 0 22px;
    border-bottom: 1px solid var(--outline);
    margin-bottom: 4px;
  }
  .intro {
    font-size: 15px;
    line-height: 1.85;
    color: var(--text);
  }
  .num {
    display: inline-block;
    background: var(--secondary-container);
    color: var(--on-secondary-container);
    font-weight: 800;
    padding: 1px 6px;
    border-radius: 6px;
  }
  /* 출처 + 상담 문구를 한 덩어리로 묶는다 — 둘 다 같은 크기·색, 줄 간격만 좁게 */
  .meta {
    margin-top: 14px;
  }
  .meta p {
    font-size: 12.5px;
    line-height: 1.6;
    color: var(--text-sub);
  }
  .meta p + p {
    margin-top: 3px;
  }
  .meta a:hover {
    color: var(--primary);
  }
</style>
