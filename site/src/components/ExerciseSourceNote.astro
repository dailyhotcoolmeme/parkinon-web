---
/*
 * 운동 영상 허브 상단의 출처·근거 안내 — 텍스트 세 문단.
 * 배경 박스를 시도했다가(문단 전체 → 수치만) 오너가 최종적으로 "그냥 빼라"고 했다
 * (2026-08-07). 순수 텍스트로 둔다. 새로 박스·칩을 넣지 말 것.
 */
import type { ExerciseSource } from '../lib/exerciseSource';

interface Props {
  source: ExerciseSource;
}
const { source } = Astro.props;
---

<div class="source-note">
  <p class="intro">{source.intro.map((run) => (run.bold ? <b>{run.text}</b> : run.text))}</p>
  <div class="meta">
    <p>
      {source.citation}
      {source.link && (
        <>
          {' · '}
          <a href={source.link.href} target="_blank" rel="noopener">
            {source.link.label}
          </a>
        </>
      )}
    </p>
    <p>{source.disclaimer}</p>
  </div>
</div>

<style>
  .source-note {
    padding: 18px 0 22px;
    border-bottom: 1px solid var(--outline);
    margin-bottom: 4px;
  }
  .intro {
    font-size: 15px;
    line-height: 1.75;
    color: var(--text);
  }
  /* 출처 + 상담 문구를 한 덩어리로 묶는다 — 둘 다 같은 크기·색, 줄 간격만 좁게 */
  .meta {
    margin-top: 14px;
  }
  .meta p {
    font-size: 12.5px;
    line-height: 1.6;
    color: var(--text-sub);
  }
  .meta p + p {
    margin-top: 3px;
  }
  .meta a:hover {
    color: var(--primary);
  }
</style>
