---
/*
 * 운동 영상 허브 상단의 출처·근거 안내.
 *
 * 2026-08-07 재설계 — 첫 버전은 문장 세 개를 그냥 나열해 "보기 싫다"는 지적을 받았다.
 * 지금은 신호 강한 순서로 배치한다: 표시(신뢰) → 기관명(굵게) → 숫자(크게, 스캔하기 쉽게)
 * → 출처(작게) → 상담 문구(작게). 색은 primary 하나만 쓰고 박스·그라디언트를 쓰지 않는다.
 */
import type { ExerciseSource } from '../lib/exerciseSource';

interface Props {
  source: ExerciseSource;
}
const { source } = Astro.props;
---

<div class="source-note">
  <div class="badge">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="9"></circle>
      <path d="M8 12.5l2.5 2.5 5-5.5"></path>
    </svg>
    <span>{source.badge}</span>
  </div>

  <p class="org">{source.org}</p>

  {
    source.stats && (
      <div class="stats">
        {source.stats.map((s) => (
          <div class="stat">
            <b>{s.value}</b>
            <span>{s.label}</span>
          </div>
        ))}
      </div>
    )
  }

  <p class="cite">
    {source.citation}
    {source.link && (
      <>
        {' · '}
        <a href={source.link.href} target="_blank" rel="noopener">
          {source.link.label}
        </a>
      </>
    )}
  </p>
  <p class="disclaimer">{source.disclaimer}</p>
</div>

<style>
  .source-note {
    padding: 20px 0 24px;
    border-bottom: 1px solid var(--outline);
    margin-bottom: 4px;
  }
  .badge {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--primary);
  }
  .badge svg {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }
  .badge span {
    font-size: 12px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .org {
    margin-top: 10px;
    font-size: 16.5px;
    font-weight: 700;
    color: var(--text);
    line-height: 1.5;
  }
  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 32px;
    margin-top: 16px;
  }
  .stat {
    display: flex;
    flex-direction: column;
  }
  .stat b {
    font-size: 24px;
    font-weight: 800;
    color: var(--primary);
    line-height: 1.2;
  }
  .stat span {
    margin-top: 3px;
    font-size: 12.5px;
    color: var(--text-sub);
  }
  .cite {
    margin-top: 18px;
    font-size: 12.5px;
    color: var(--text-sub);
  }
  .cite a:hover {
    color: var(--primary);
  }
  .disclaimer {
    margin-top: 6px;
    font-size: 12.5px;
    color: var(--text-sub);
    opacity: 0.85;
  }

  @media (max-width: 480px) {
    .stats {
      gap: 8px 24px;
    }
    .stat b {
      font-size: 21px;
    }
  }
</style>
