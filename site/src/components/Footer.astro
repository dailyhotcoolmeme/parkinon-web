---
import { getRelativeLocaleUrl } from 'astro:i18n';
import symbolWhite from '../assets/images/logo-symbol-white.png';
import { navItemsFor } from '../lib/nav';
import { t } from '../i18n';
import Tr from '../i18n/Tr.astro';

const locale = Astro.currentLocale ?? 'ko';
// "바로가기"는 헤더 메뉴와 **같은 목록·같은 순서**여야 한다 → src/lib/nav.ts 를 공용으로 쓴다.
const navLinks = navItemsFor(locale);
// 푸터 "개인정보처리방침" = 웹사이트용(/ko/privacy). 앱용은 별도 문서라 라벨에 "앱"을 붙여 구분한다.
// /terms · /privacy 는 앱에서 넘어오는 기존 정적 페이지다(다른 프로젝트가 서빙).
// 언어 접두사를 붙이면 안 된다 — 앱에도 이 주소가 하드코딩돼 있다.
---

<footer class="site">
  <div class="footer-top">
    <div class="footer-brandrow">
      <div class="footer-brand">
        <span class="brand-badge"><img src={symbolWhite.src} alt="" /></span>
        <Tr k="brand.name" />
      </div>
      <p class="footer-disclaimer">
        <Tr k="footer.disclaimerLine1" /><br />
        <Tr k="footer.disclaimerLine2" />
      </p>
    </div>
    <div class="footer-col">
      <h4><Tr k="footer.quickLinks" /></h4>
      <div class="footer-links-grid">
        {navLinks.map((link) => <a href={link.href}>{link.label}</a>)}
      </div>
    </div>
    <div class="footer-col">
      <h4><Tr k="footer.support" /></h4>
      <a href={getRelativeLocaleUrl(locale, 'privacy')}><Tr k="footer.privacyWeb" /></a>
      <a href="mailto:admin@ourmine.co.kr"><Tr k="footer.contact" /></a>
    </div>
  </div>
  <div class="footer-bottom">
    <div class="footer-divider"></div>
    <button type="button" class="biz-toggle" id="bizToggle" aria-expanded="false" aria-controls="bizInfo">
      <span class="company"><Tr k="footer.company" /></span>
      <span><Tr k="footer.bizInfo" /></span>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"></path></svg>
    </button>
    {/* i18n-exempt:start — 아래 '값'들은 법인 등록 정보(대표자명·신고번호·주소)다. 번역 대상이 아니다.
        라벨은 사전을 거친다. 해외판에서 로마자 표기로 바꿀지는 오너 결정 사항이라 계획서 미결에 적어 뒀다. */}
    <div class="biz-info" id="bizInfo">
      <p><span class="k">{t(locale, 'footer.bizCeo')}</span> 한민석, 최성철 · <span class="k">{t(locale, 'footer.bizNumber')}</span> 342-81-04379</p>
      <p><span class="k">{t(locale, 'footer.bizMailOrder')}</span> 제2026-서울강동-1129호</p>
      <p><span class="k">{t(locale, 'footer.bizAddress')}</span> 서울특별시 강동구 양재대로85길 23, E&J빌딩 4층 4590호(성내동)</p>
      <p><span class="k">{t(locale, 'footer.bizPhone')}</span> 070-4513-1894 · <span class="k">{t(locale, 'footer.bizEmail')}</span> admin@ourmine.co.kr</p>
      <p><span class="k">{t(locale, 'footer.bizWebsite')}</span> <a href="https://www.ourmine.co.kr" target="_blank" rel="noopener">https://www.ourmine.co.kr</a></p>
    </div>
    {/* i18n-exempt:end */}
    <p class="footer-copyright">© 2026 OURMINE. All rights reserved.</p>
  </div>
</footer>

<style>
  footer.site {
    border-top: 1px solid var(--outline);
    margin-top: 36px;
    background: var(--surface-low);
  }
  .footer-top {
    padding: 22px var(--gutter) 6px;
    max-width: var(--max);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.3fr 1fr 1fr;
    gap: 16px;
  }
  @media (max-width: 760px) {
    .footer-top {
      grid-template-columns: 1fr;
      text-align: center;
      gap: 10px;
    }
  }
  .footer-brandrow {
    position: relative;
  }
  .footer-brand {
    font-family: var(--font-head);
    font-weight: 900;
    font-size: 15px;
    color: var(--secondary); /* 로고 아이콘 실제 색과 맞춤(Header.astro와 같은 이유) */
    margin-bottom: 6px;
    display: flex;
    align-items: center;
    gap: 7px;
  }
  @media (max-width: 760px) {
    .footer-brand {
      justify-content: center;
      margin-bottom: 0;
    }
  }
  /* 앱 톱바와 같은 회전 배지 — Header.astro 와 같은 이유·같은 타이밍(2026-08-10) */
  .brand-badge {
    width: 22px;
    height: 22px;
    border-radius: 5px;
    background: var(--secondary);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .brand-badge img {
    width: 15px;
    height: 15px;
    display: block;
    animation: brand-spin 9.5s ease-in-out infinite;
  }
  @keyframes brand-spin {
    0% {
      transform: rotate(0deg);
    }
    63% {
      transform: rotate(360deg);
    }
    100% {
      transform: rotate(360deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .brand-badge img {
      animation: none;
    }
  }
  .footer-disclaimer {
    /*
     * max-width(ch)로 폭을 제한했다가 한글 폭 계산이 어긋나 문장 안에서도 줄바꿈이
     * 되어 의도한 2줄이 아니라 4줄로 나온 적이 있다(2026-08-10) — <br/> 로 끊는
     * 지점을 이미 정확히 정했으니 폭은 그냥 열 너비에 맡긴다(추가 제한 불필요).
     */
    margin-top: 10px;
    white-space: nowrap;
    font-size: 11px;
    line-height: 1.6;
    color: var(--text-sub);
    opacity: 0.75;
  }
  @media (max-width: 760px) {
    .footer-brandrow {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
    }
    .footer-disclaimer {
      margin-top: 6px;
      max-width: none;
      text-align: center;
    }
  }
  .footer-links-grid {
    display: grid;
    grid-template-rows: repeat(2, auto);
    grid-auto-flow: column;
    column-gap: 22px;
    row-gap: 6px;
  }
  @media (max-width: 760px) {
    .footer-links-grid {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      align-items: center;
      gap: 4px 16px;
    }
  }
  .footer-col h4 {
    font-size: 12px;
    font-weight: 800;
    color: var(--text);
    margin: 0 0 8px;
    letter-spacing: 0.04em;
  }
  .footer-col a {
    display: block;
    font-size: 12.5px;
    color: var(--text-sub);
    margin-bottom: 6px;
  }
  .footer-col a:hover {
    color: var(--primary);
  }
  @media (max-width: 760px) {
    .footer-col {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      align-items: center;
      gap: 4px 16px;
    }
    .footer-col h4 {
      display: none;
    }
    .footer-col a {
      display: inline-block;
      margin-bottom: 0;
    }
  }
  .footer-bottom {
    padding: 6px var(--gutter) 14px;
    max-width: var(--max);
    margin: 0 auto;
  }
  .footer-divider {
    border-top: 1px solid var(--outline);
    margin: 10px 0;
  }
  @media (max-width: 760px) {
    .footer-bottom {
      text-align: center;
    }
    .biz-toggle {
      margin: 0 auto;
    }
  }
  .biz-toggle {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11.5px;
    color: var(--text-sub);
    /*
     * <button> 은 브라우저 기본 padding이 있어서, 이게 없으면 "주식회사" 글자
     * 시작점이 아래 펼쳐지는 사업자 정보·맨 아래 저작권 줄과 안 맞았다(오너 지적
     * 2026-08-10 — 둘 다 <p>라 기본 여백이 없는데 버튼만 있어서 삐뚤어짐).
     */
    padding: 0;
    border: none;
    background: none;
    font-family: inherit;
    cursor: pointer;
  }
  .biz-toggle:hover {
    color: var(--text);
  }
  .biz-toggle .company {
    font-weight: 700;
  }
  .biz-toggle svg {
    width: 13px;
    height: 13px;
    transition: transform 0.2s;
  }
  .biz-toggle[aria-expanded='true'] svg {
    transform: rotate(180deg);
  }
  .biz-info {
    overflow: hidden;
    max-height: 0;
    transition: max-height 0.2s ease;
    font-size: 11px;
    color: var(--text-sub);
    line-height: 1.6;
  }
  .biz-info.open {
    max-height: 240px;
  }
  .biz-info p {
    margin-top: 4px;
  }
  .biz-info .k {
    opacity: 0.7;
  }
  .biz-info a {
    color: inherit;
    text-decoration: underline;
  }
  .footer-copyright {
    margin-top: 8px;
    font-size: 11px;
    color: var(--text-sub);
    opacity: 0.75;
  }
</style>

<script>
  const bizToggle = document.getElementById('bizToggle')!;
  const bizInfo = document.getElementById('bizInfo')!;
  bizToggle.addEventListener('click', () => {
    const open = bizInfo.classList.toggle('open');
    bizToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
  });
</script>
