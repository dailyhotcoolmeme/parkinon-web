---
import { getRelativeLocaleUrl } from 'astro:i18n';
import symbolWhite from '../assets/images/logo-symbol-white.png';
import { navItemsFor } from '../lib/nav';
import { t } from '../i18n';
import Tr from '../i18n/Tr.astro';
import { business, mailOrderNo, supportTel, BIZ_NO, SUPPORT_EMAIL } from '../lib/business';
import { localeLinksFor } from '../lib/i18nLinks';
import { GATE_LANGUAGES } from '../lib/gate';

const locale = Astro.currentLocale ?? 'ko';
/*
 * 사업자 정보는 값 자체가 로케일별로 다르다(상호·대표자·주소는 국문/영문 표기가 따로 있다).
 * 예전엔 이 파일에 한국어 문자열을 직접 박아 두고 라벨만 사전을 거쳐서, 영어 페이지 아래에
 * 한국어 대표자명·주소가 그대로 나왔다(오너 지적 2026-08-12). 값은 lib/business.ts 한 곳에서만 온다.
 */
const biz = business(locale);
const tel = supportTel(locale);
// "바로가기"는 헤더 메뉴와 **같은 목록·같은 순서**여야 한다 → src/lib/nav.ts 를 공용으로 쓴다.
const navLinks = navItemsFor(locale);

/*
 * 언어 전환 — 2026-09-01 추가. 그전까지 사이트 어디에도 언어를 바꾸는 통로가 없었고
 * 대문(`/`)이 유일한 입구였다. 대문을 자동 전환으로 대체하면서 여기가 대신 그 역할을 한다.
 *
 * 링크는 **같은 글의 그 언어판**으로 간다. 번역이 없으면 그 언어의 홈으로 보낸다
 * (없는 주소로 보내 404 를 만들지 않는다 — lib/i18nLinks.ts 가 실제 파일 유무를 확인한다).
 *
 * 언어 이름은 **그 언어로** 적는다(日本語·Français). 사전을 거치면 자기 언어를 못 찾는다 —
 * 대문과 같은 이유라 대문 목록(lib/gate.ts)을 그대로 쓴다.
 */
const langName = new Map(GATE_LANGUAGES.map((g) => [g.code, g.name]));
const localeLinks = (await localeLinksFor(Astro.url.pathname)).filter((l) => langName.has(l.code));
// 푸터 "개인정보처리방침" = 웹사이트용(/ko/privacy). 앱용은 별도 문서라 라벨에 "앱"을 붙여 구분한다.
// /terms · /privacy 는 앱에서 넘어오는 기존 정적 페이지다(다른 프로젝트가 서빙).
// 언어 접두사를 붙이면 안 된다 — 앱에도 이 주소가 하드코딩돼 있다.
---

<footer class="site">
  <div class="footer-top">
    <div class="footer-brandrow">
      <div class="footer-brand">
        <span class="brand-badge"><img src={symbolWhite.src} alt="" /></span>
        <Tr k="brand.name" />
      </div>
      <p class="footer-disclaimer">
        <Tr k="footer.disclaimerLine1" /><br />
        <Tr k="footer.disclaimerLine2" />
      </p>
    </div>
    <div class="footer-col">
      <h4><Tr k="footer.quickLinks" /></h4>
      <div class="footer-links-grid">
        {navLinks.map((link) => <a href={link.href}>{link.label}</a>)}
      </div>
    </div>
    <div class="footer-col">
      <h4><Tr k="footer.support" /></h4>
      <a href={getRelativeLocaleUrl(locale, 'privacy')}><Tr k="footer.privacyWeb" /></a>
      <a href="mailto:admin@ourmine.co.kr"><Tr k="footer.contact" /></a>
    </div>
    {localeLinks.length > 1 && (
      <div class="footer-col">
        <h4><Tr k="footer.language" /></h4>
        {/*
          콤보박스(select)로 고른다 — 오너 지시 2026-09-01. 60대 이상이 주 독자라
          타이핑 없이 탭·선택으로만 끝나는 형태를 쓴다. 네이티브 select 라 모바일에서는
          OS 기본 선택 화면이 떠서 손가락으로 고르기 쉽다.

          값은 이동할 주소 그대로다. 고르는 즉시 이동하고, 같은 쿠키(pon_lang)를 남겨
          루트 자동 전환이 다음 방문에 이 선택을 존중하게 한다.
        */}
        <select class="footer-lang-select" aria-label={t(locale, 'footer.language')}>
          {localeLinks.map((l) => (
            <option value={l.href} data-lang={l.code} lang={l.code} selected={l.code === locale}>
              {langName.get(l.code)}
            </option>
          ))}
        </select>
        {/* 스크립트가 막혀 있으면 select 는 아무 일도 못 한다 — 그때도 언어를 바꿀 길은 남겨둔다. */}
        <noscript>
          <div class="footer-langs">
            {localeLinks.map((l) => (
              <a href={l.href} lang={l.code} hreflang={l.code}>
                {langName.get(l.code)}
              </a>
            ))}
          </div>
        </noscript>
      </div>
    )}
  </div>
  <div class="footer-bottom">
    <div class="footer-divider"></div>
    <button type="button" class="biz-toggle" id="bizToggle" aria-expanded="false" aria-controls="bizInfo">
      <span class="company">{biz.name}</span>
      <span><Tr k="footer.bizInfo" /></span>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"></path></svg>
    </button>
    {/* 한국 전자상거래법상 통신판매업자 표시의무 항목 — 어느 언어에서도 숨기지 않는다.
        값은 lib/business.ts 한 곳에서 온다(전화는 한국어에서만 나온다 — 그 파일 주석 참고). */}
    <div class="biz-info" id="bizInfo">
      <p><span class="k">{t(locale, 'footer.bizCeo')}</span> {biz.reps} · <span class="k">{t(locale, 'footer.bizNumber')}</span> {BIZ_NO}</p>
      <p><span class="k">{t(locale, 'footer.bizMailOrder')}</span> {mailOrderNo(locale)}</p>
      <p><span class="k">{t(locale, 'footer.bizAddress')}</span> {biz.address}</p>
      <p>
        {tel && <><span class="k">{t(locale, 'footer.bizPhone')}</span> {tel} · </>}
        <span class="k">{t(locale, 'footer.bizEmail')}</span> {SUPPORT_EMAIL}
      </p>
    </div>
    <p class="footer-copyright">© 2026 OURMINE. All rights reserved.</p>
  </div>
</footer>

{/*
  고른 언어를 1년짜리 쿠키에 적어둔다. 루트(`/`) 의 Pages Function 이 이 값을 **가장 먼저**
  보기 때문에, 한 번 직접 바꾼 사람은 다음 방문에 브라우저 언어로 도로 튕기지 않는다
  (2026-09-01, 자동 전환을 켜면서 같이 넣음 — 이게 없으면 자동 전환이 사용자를 가둔다).
  스크립트가 막혀 있어도 링크 자체는 그냥 동작한다 — 기억만 안 될 뿐이다.
*/}
<script is:inline>
  document.querySelectorAll('select.footer-lang-select').forEach(function (sel) {
    sel.addEventListener('change', function () {
      var opt = sel.options[sel.selectedIndex];
      if (!opt) return;
      try {
        document.cookie =
          'pon_lang=' + opt.dataset.lang + '; path=/; max-age=31536000; samesite=lax';
      } catch (e) {
        /* 쿠키가 막혀 있어도 이동은 그대로 진행한다 — 기억만 안 될 뿐이다 */
      }
      window.location.href = opt.value;
    });
  });
</script>

<style>
  footer.site {
    border-top: 1px solid var(--outline);
    margin-top: 36px;
    background: var(--surface-low);
  }
  .footer-top {
    padding: 22px var(--gutter) 6px;
    max-width: var(--max);
    margin: 0 auto;
    display: grid;
    /* 언어 칼럼이 늘면서 4칸이 됐다(2026-09-01). 언어는 짧아서 좁게 둔다. */
    grid-template-columns: 1.3fr 1fr 1fr 0.8fr;
    gap: 16px;
  }
  /*
   * 언어 콤보박스. 임상시험 검색의 select(높이 40 · 테두리 1.5px · 반경 8)와 같은 얼굴로 맞춘다.
   * 푸터 배경이 --surface-low 라 --bg 를 깔아야 입력 요소로 보인다.
   */
  .footer-lang-select {
    height: 40px;
    max-width: 200px;
    padding: 0 10px;
    border: 1.5px solid var(--outline);
    border-radius: 8px;
    background: var(--bg);
    color: var(--text);
    font-size: 14px;
    font-family: inherit;
  }
  /* 스크립트가 막혔을 때만 나오는 대체 링크 */
  .footer-langs {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
  }
  @media (max-width: 760px) {
    .footer-top {
      grid-template-columns: 1fr;
      text-align: center;
      gap: 10px;
    }
    .footer-langs {
      justify-content: center;
    }
  }
  .footer-brandrow {
    position: relative;
  }
  .footer-brand {
    font-family: var(--font-head);
    font-weight: 900;
    font-size: 15px;
    color: var(--secondary); /* 로고 아이콘 실제 색과 맞춤(Header.astro와 같은 이유) */
    margin-bottom: 6px;
    display: flex;
    align-items: center;
    gap: 7px;
  }
  @media (max-width: 760px) {
    .footer-brand {
      justify-content: center;
      margin-bottom: 0;
    }
  }
  /* 앱 톱바와 같은 회전 배지 — Header.astro 와 같은 이유·같은 타이밍(2026-08-10) */
  .brand-badge {
    width: 22px;
    height: 22px;
    border-radius: 5px;
    background: var(--secondary);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .brand-badge img {
    width: 15px;
    height: 15px;
    display: block;
    animation: brand-spin 9.5s ease-in-out infinite;
  }
  @keyframes brand-spin {
    0% {
      transform: rotate(0deg);
    }
    63% {
      transform: rotate(360deg);
    }
    100% {
      transform: rotate(360deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .brand-badge img {
      animation: none;
    }
  }
  .footer-disclaimer {
    /*
     * max-width(ch)로 폭을 제한했다가 한글 폭 계산이 어긋나 문장 안에서도 줄바꿈이
     * 되어 의도한 2줄이 아니라 4줄로 나온 적이 있다(2026-08-10) — <br/> 로 끊는
     * 지점을 이미 정확히 정했으니 폭은 그냥 열 너비에 맡긴다(추가 제한 불필요).
     *
     * ★ `white-space: nowrap` 을 뺐다(2026-09-02). <br/> 로 끊을 자리를 이미 정해
     *   놓았으니 nowrap 은 아무 일도 하지 않는 대신, **한 줄이 화면보다 길어지는
     *   언어에서 줄바꿈을 금지해 페이지 전체를 밀어냈다.** 스페인어는 390px 에서
     *   19px, 320px 에서 89px 가로 스크롤이 생겼고 영어·프랑스어·일본어도 320px 에서
     *   10~13px 밀렸다(한국어만 문장이 짧아 우연히 멀쩡했다). 가로 스크롤은 금지다.
     *   nowrap 없이도 <br/> 은 그대로 두 줄로 끊고, 화면이 좁으면 그때만 접힌다.
     */
    margin-top: 10px;
    font-size: 11px;
    line-height: 1.6;
    color: var(--text-sub);
    opacity: 0.75;
  }
  @media (max-width: 760px) {
    .footer-brandrow {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
    }
    .footer-disclaimer {
      margin-top: 6px;
      max-width: none;
      text-align: center;
    }
  }
  .footer-links-grid {
    display: grid;
    grid-template-rows: repeat(2, auto);
    grid-auto-flow: column;
    column-gap: 22px;
    row-gap: 6px;
  }
  @media (max-width: 760px) {
    .footer-links-grid {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      align-items: center;
      gap: 4px 16px;
    }
  }
  .footer-col h4 {
    font-size: 12px;
    font-weight: 800;
    color: var(--text);
    margin: 0 0 8px;
    letter-spacing: 0.04em;
  }
  .footer-col a {
    display: block;
    font-size: 12.5px;
    color: var(--text-sub);
    margin-bottom: 6px;
  }
  .footer-col a:hover {
    color: var(--primary);
  }
  @media (max-width: 760px) {
    .footer-col {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      align-items: center;
      gap: 4px 16px;
    }
    .footer-col h4 {
      display: none;
    }
    .footer-col a {
      display: inline-block;
      margin-bottom: 0;
    }
  }
  .footer-bottom {
    padding: 6px var(--gutter) 14px;
    max-width: var(--max);
    margin: 0 auto;
  }
  .footer-divider {
    border-top: 1px solid var(--outline);
    margin: 10px 0;
  }
  @media (max-width: 760px) {
    .footer-bottom {
      text-align: center;
    }
    .biz-toggle {
      margin: 0 auto;
    }
  }
  .biz-toggle {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11.5px;
    color: var(--text-sub);
    /*
     * <button> 은 브라우저 기본 padding이 있어서, 이게 없으면 "주식회사" 글자
     * 시작점이 아래 펼쳐지는 사업자 정보·맨 아래 저작권 줄과 안 맞았다(오너 지적
     * 2026-08-10 — 둘 다 <p>라 기본 여백이 없는데 버튼만 있어서 삐뚤어짐).
     */
    padding: 0;
    border: none;
    background: none;
    font-family: inherit;
    cursor: pointer;
  }
  .biz-toggle:hover {
    color: var(--text);
  }
  .biz-toggle .company {
    font-weight: 700;
  }
  .biz-toggle svg {
    width: 13px;
    height: 13px;
    transition: transform 0.2s;
  }
  .biz-toggle[aria-expanded='true'] svg {
    transform: rotate(180deg);
  }
  .biz-info {
    overflow: hidden;
    max-height: 0;
    transition: max-height 0.2s ease;
    font-size: 11px;
    color: var(--text-sub);
    line-height: 1.6;
  }
  .biz-info.open {
    max-height: 240px;
  }
  .biz-info p {
    margin-top: 4px;
  }
  .biz-info .k {
    opacity: 0.7;
  }
  .biz-info a {
    color: inherit;
    text-decoration: underline;
  }
  .footer-copyright {
    margin-top: 8px;
    font-size: 11px;
    color: var(--text-sub);
    opacity: 0.75;
  }
</style>

<script>
  const bizToggle = document.getElementById('bizToggle')!;
  const bizInfo = document.getElementById('bizInfo')!;
  bizToggle.addEventListener('click', () => {
    const open = bizInfo.classList.toggle('open');
    bizToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
  });
</script>
