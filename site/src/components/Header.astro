---
import { getRelativeLocaleUrl } from 'astro:i18n';
import symbolWhite from '../assets/images/logo-symbol-white.png';
import { navItemsFor, type NavKey } from '../lib/nav';
import { t } from '../i18n';
import Tr from '../i18n/Tr.astro';

interface Props {
  active?: NavKey;
}
const { active } = Astro.props;

/*
 * 모든 URL 에 언어 접두사가 붙는다(/ko/institutions). 링크를 손으로 적지 말고
 * getRelativeLocaleUrl 로 만들 것 — 번역판이 생겨도 현재 언어를 따라간다.
 */
const locale = Astro.currentLocale ?? 'ko';
/*
 * 메뉴 항목·순서·노출 범위는 `src/lib/nav.ts` 가 정본이다(푸터와 공용).
 * 언어판마다 개수가 달라서 여기에 배열을 적지 않는다 — 이유는 nav.ts 주석 참고.
 */
const navLinks = navItemsFor(locale);
const homeHref = getRelativeLocaleUrl(locale, '');
---

<header class="site">
  <div class="wrap nav">
    <a class="brand" href={homeHref}>
      <span class="brand-badge"><img src={symbolWhite.src} alt="" /></span>
      <Tr k="brand.name" />
    </a>
    <nav class="nav-links" id="navLinks">
      {
        navLinks.map((link) => (
          <a href={link.href} class={link.key === active ? 'active' : ''}>
            {link.label}
          </a>
        ))
      }
    </nav>
    <button class="search-btn" id="searchBtn" aria-label={t(locale, 'header.search')} aria-expanded="false">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
        ><circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg
      >
    </button>
    <button class="menu-btn" id="menuBtn" aria-label={t(locale, 'header.menu')} aria-expanded="false">
      <svg class="icon-menu" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
        ><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="12" x2="21" y2="12"></line><line
          x1="3"
          y1="18"
          x2="21"
          y2="18"></line></svg
      >
      <svg class="icon-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
        ><line x1="6" y1="6" x2="18" y2="18"></line><line x1="18" y1="6" x2="6" y2="18"></line></svg
      >
    </button>
  </div>
  <div class="search-panel" id="searchPanel" data-locale={locale} data-clinical-href={getRelativeLocaleUrl(locale, 'clinical')}>
    <div class="search-panel-inner">
      <form id="searchForm" role="search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
          ><circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg
        >
        <input type="text" id="searchInput" placeholder={t(locale, 'header.searchPlaceholder')} />
        <button type="submit" class="search-panel-submit">{t(locale, 'search.submit')}</button>
      </form>
      {/*
        검색 버튼(또는 Enter)을 눌러야 실행된다 — 타이핑할 때마다 서버를 안 건드린다
        (오너 승인 2026-08-16: 임상시험 페이지 검색과 같은 패턴). 결과는 페이지 이동 없이
        이 패널 안에 그대로 뜬다. 글은 빌드 타임 인덱스(/{locale}/search-index.json)를
        불러와 브라우저에서 substring 매칭, 임상시험·연구는 /api/search 를 부른다 —
        상세페이지가 없는 항목이라 클릭하면 /clinical/ 의 실시간 검색으로 넘어간다.
      */}
      <div class="search-panel-results" id="searchPanelResults" hidden>
        <p class="search-panel-empty" id="searchPanelEmpty" hidden>{t(locale, 'search.noResults')}</p>
        <div id="searchPanelSections"></div>
      </div>
    </div>
  </div>
</header>

<script type="application/json" id="searchLabels" set:html={JSON.stringify({
  sectionArticles: t(locale, 'search.sectionArticles'),
  sectionTrials: t(locale, 'clinical.feedTrials'),
  sectionResearch: t(locale, 'research.feedLabel'),
  viewAll: t(locale, 'search.loadMore'),
})} />

<script is:inline>
  /*
   * 메뉴가 한 줄에 안 들어가면 햄버거로 접는다.
   *
   * 고정 중단점 대신 **실제로 재서** 판단한다 — 라벨 길이가 언어마다 달라서
   * (한국어 449px · 영어 648px · 독일어 749px · 프랑스어 762px, 2026-08-07 실측)
   * 하나의 px 값으로는 어느 언어든 손해를 본다.
   *
   * 번들 스크립트는 defer 라 한 프레임 늦게 적용돼 메뉴가 깜빡인다 → is:inline 으로 둔다.
   */
  (function () {
    var header = document.querySelector('header.site');
    if (!header) return;
    var nav = header.querySelector('.nav');
    var links = header.querySelector('.nav-links');
    var brand = header.querySelector('.brand');
    var search = header.querySelector('.search-btn');
    var menuBtn = header.querySelector('.menu-btn');
    var pending = 0;

    function update() {
      pending = 0;
      // 가로 배치 상태에서 재야 진짜 필요 폭이 나온다.
      header.classList.remove('compact');
      var cs = getComputedStyle(nav);
      var gap = parseFloat(cs.columnGap || cs.gap) || 0;
      var need = brand.offsetWidth + gap + links.scrollWidth + gap + search.offsetWidth + 8;
      // 860px 이하는 폭이 남더라도 무조건 햄버거로 둔다 — 손가락으로 누르는 화면이라
      // 가로 메뉴가 들어간다고 해서 쓰기 좋은 건 아니다(기존 동작 유지).
      if (window.innerWidth <= 860 || need > nav.clientWidth) {
        header.classList.add('compact');
        links.classList.remove('open');
        if (menuBtn) menuBtn.setAttribute('aria-expanded', 'false');
      }
    }
    function schedule() {
      if (!pending) pending = requestAnimationFrame(update);
    }

    update();
    window.addEventListener('resize', schedule);
    // 웹폰트가 뒤늦게 적용되면 글자 폭이 달라진다 → 다시 잰다.
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(update);
  })();
</script>

<style>
  header.site {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--bg);
    border-bottom: 1px solid var(--outline);
  }
  .nav {
    display: flex;
    align-items: center;
    gap: 48px;
    padding-top: 16px;
    padding-bottom: 16px;
  }
  .brand {
    font-family: var(--font-head);
    font-weight: 900;
    font-size: 22px;
    /*
     * 아이콘 실제 색(로고 PNG 픽셀 실측 #4caf50)과 맞춘다 — 오너 지시 2026-08-10.
     * var(--primary)는 다크모드에서 밝은 초록(#66bb6a)으로 바뀌는데, 로고 PNG 자체는
     * 이미지라 색이 안 바뀐다. var(--secondary)는 라이트·다크 모두 #4caf50 고정이라
     * 로고와 항상 같은 색으로 보인다.
     */
    color: var(--secondary);
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  /*
   * 앱 톱바(TopBar.tsx)와 같은 표현 — 초록 배지 안 흰 심볼이 천천히 한 바퀴 돌고
   * 쉬었다가 다시 도는 것을 반복한다(오너 지시 2026-08-10: "아이폰 앱에서는 되는데
   * 그거 여기에도 적용시키자. 회전하는 이미지"). 앱은 Animated.timing(6초 회전 +
   * 3.5초 정지)을 코드로 구현했지만, 웹은 순수 CSS 애니메이션으로 같은 타이밍을 낸다.
   */
  .brand-badge {
    width: 30px;
    height: 30px;
    border-radius: 6px;
    background: var(--secondary);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .brand-badge img {
    width: 20px;
    height: 20px;
    display: block;
    animation: brand-spin 9.5s ease-in-out infinite;
  }
  @keyframes brand-spin {
    0% {
      transform: rotate(0deg);
    }
    63% {
      transform: rotate(360deg);
    }
    100% {
      transform: rotate(360deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .brand-badge img {
      animation: none;
    }
  }
  .nav-links {
    display: flex;
    gap: 32px;
    align-items: center;
  }
  .nav-links a {
    font-weight: 700;
    font-size: 18px;
    color: var(--text-sub);
    position: relative;
    /*
     * 메뉴는 절대 줄바꿈되지 않는다.
     * 한국어 라벨이 짧아서 안 드러났을 뿐, 실측하면 영어는 861px, 프랑스어·독일어는
     * 1024px 에서 두 줄로 접혔다(2026-08-07 CDP 측정). 줄바꿈 대신 햄버거로 넘긴다.
     */
    white-space: nowrap;
  }
  .nav-links a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -6px;
    height: 2px;
    background: transparent;
  }
  .nav-links a.active {
    color: var(--primary);
  }
  .nav-links a.active::after {
    background: var(--primary);
  }
  .search-btn {
    margin-left: auto;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    color: var(--text-sub);
    flex-shrink: 0;
  }
  .search-btn:hover {
    background: var(--surface-low);
    color: var(--text);
  }
  .search-btn svg {
    width: 22px;
    height: 22px;
  }
  .menu-btn {
    display: none;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    color: var(--text);
    flex-shrink: 0;
  }
  .menu-btn:hover {
    background: var(--surface-low);
  }
  .menu-btn svg {
    width: 26px;
    height: 26px;
  }
  .menu-btn .icon-close {
    display: none;
  }
  .menu-btn[aria-expanded='true'] .icon-menu {
    display: none;
  }
  .menu-btn[aria-expanded='true'] .icon-close {
    display: block;
  }
  /*
   * 좁아지면 햄버거로 접는다.
   *
   * 예전에는 `@media (max-width: 860px)` 하나로 판단했다. 그러면 라벨이 긴 언어
   * (독일어·프랑스어)는 데스크톱 폭에서도 메뉴가 두 줄로 접힌다.
   * 지금은 **폭이 실제로 모자랄 때** 스크립트가 .compact 를 붙인다 —
   * 전환 지점이 언어마다 알아서 달라진다.
   */
  .site.compact {
    & .nav {
      gap: 8px;
    }
    & .nav-links {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--surface);
      border-bottom: 1px solid var(--outline);
      box-shadow: 0 12px 24px -16px rgba(0, 0, 0, 0.15);
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 4px var(--gutter);
      display: none;
    }
    & .nav-links.open {
      display: flex;
    }
    & .nav-links a {
      font-size: 19px;
      padding: 16px 4px;
      border-bottom: 1px solid var(--outline);
      width: 100%;
      box-sizing: border-box;
    }
    /*
     * 데스크톱 밑줄(.nav-links a::after, bottom:-6px)을 모바일에서 그대로 쓰면
     * 초록 줄이 회색 구분선보다 4px 아래(다음 항목 영역)에 뜬다 — 실측 확인, 오너 지적 2026-08-06.
     * 모바일에서는 행 구분선 자체를 초록으로 바꿔서 위치를 정확히 맞춘다.
     */
    & .nav-links a::after {
      display: none;
    }
    & .nav-links a:last-child {
      border-bottom-color: transparent;
    }
    & .nav-links a.active {
      border-bottom: 2px solid var(--primary);
      margin-bottom: -1px; /* 1px → 2px 로 굵어진 만큼 상쇄해 행 높이를 유지 */
    }
    & .menu-btn {
      display: flex;
      margin-left: 8px;
    }
  }

  .search-panel {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: var(--surface);
    border-bottom: 1px solid var(--outline);
    box-shadow: 0 12px 24px -16px rgba(0, 0, 0, 0.15);
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.2s ease;
  }
  /*
   * 원래 120px(입력창 한 줄)이었는데, 톱바 검색이 글+임상시험+연구 결과를 이 패널
   * 안에 그대로 보여주도록 바뀌면서(오너 지시 2026-08-16: "톱바 검색 기능 작동
   * 안되는데") 결과 개수만큼 늘어나는 가변 높이를 담아야 한다. 화면을 완전히
   * 덮지 않게 상한을 두고, 넘치면 패널 안에서만 스크롤한다.
   */
  .search-panel.open {
    max-height: min(80vh, 640px);
    overflow-y: auto;
  }
  .search-panel-inner {
    max-width: var(--max);
    margin: 0 auto;
    padding: 16px var(--gutter);
  }
  #searchForm {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .search-panel-inner svg {
    width: 20px;
    height: 20px;
    color: var(--text-sub);
    flex-shrink: 0;
  }
  .search-panel-inner input {
    flex: 1;
    min-width: 0;
    border: none;
    outline: none;
    font-size: 17px;
    font-family: inherit;
    color: var(--text);
    background: none;
    height: 44px;
  }
  .search-panel-inner input::placeholder {
    color: var(--text-sub);
  }
  .search-panel-submit {
    flex-shrink: 0;
    height: 40px;
    padding: 0 18px;
    border-radius: 8px;
    border: none;
    background: var(--primary);
    color: #fff;
    font-weight: 700;
    font-size: 14px;
  }
  .search-panel-results {
    margin-top: 14px;
    padding-top: 14px;
    border-top: 1px solid var(--outline);
  }
  .search-panel-empty {
    color: var(--text-sub);
    font-size: 14px;
  }
</style>

{/*
  ⚠️ is:global 필수 — 검색 결과는 클라이언트 JS가 나중에 innerHTML로 끼워 넣는다.
  Astro는 템플릿에 실제로 적힌 태그에만 스코프 속성(data-astro-cid-*)을 붙이므로,
  스코프가 걸린 채로는 이 규칙들이 새로 생긴 결과 항목에 전혀 안 먹는다 — 똑같은
  문제를 clinical/index.astro 의 .trial-card/.research-card 에서 이미 겪었다
  (2026-08-08, 그 파일 630번째 줄 주석 참고). 실측(2026-08-16): 스코프를 안 풀었더니
  <a>가 기본값 display:inline 으로 나와 글 제목들이 줄바꿈 없이 한 덩어리로 붙었다.
  ⚠️⚠️ 여기엔 "동적으로 생기는 결과 항목" 클래스만 넣는다 — 다른 컴포넌트와 이름이
  겹치면 조용히 서로 덮어써서 사고가 난다(2026-08-08 실제 사고, .search-btn 사례).
  새 클래스를 추가하기 전에 src/components·src/layouts 안에 같은 이름이 있는지 검색할 것 —
  scripts/check-style-collisions.mjs 가 배포 전에 자동으로 검사해 막는다.
*/}
<style is:global>
  .search-result-section + .search-result-section {
    margin-top: 16px;
  }
  .search-result-section h3 {
    font-size: 13px;
    font-weight: 700;
    color: var(--text-sub);
    margin: 0 0 6px;
  }
  .search-result-item {
    display: block;
    padding: 8px 4px;
    font-size: 15px;
    color: var(--text);
    border-radius: 6px;
  }
  .search-result-item:hover {
    background: var(--surface-low);
  }
  .search-result-more {
    display: inline-block;
    margin-top: 4px;
    padding: 4px;
    font-size: 13.5px;
    font-weight: 700;
    color: var(--primary);
  }
</style>

<script>
  const menuBtn = document.getElementById('menuBtn')!;
  const navLinks = document.getElementById('navLinks')!;
  const searchBtn = document.getElementById('searchBtn')!;
  const searchPanel = document.getElementById('searchPanel')!;
  const searchInput = document.getElementById('searchInput') as HTMLInputElement;
  const searchForm = document.getElementById('searchForm') as HTMLFormElement;
  const searchResultsEl = document.getElementById('searchPanelResults')!;
  const searchEmptyEl = document.getElementById('searchPanelEmpty')!;
  const searchSectionsEl = document.getElementById('searchPanelSections')!;

  function closeMenu() {
    navLinks.classList.remove('open');
    menuBtn.setAttribute('aria-expanded', 'false');
  }
  function closeSearch() {
    searchPanel.classList.remove('open');
    searchBtn.setAttribute('aria-expanded', 'false');
    // 닫을 때마다 비워서, 다음에 열었을 때 지난 검색어·결과가 남아있지 않게 한다.
    searchResultsEl.hidden = true;
    searchSectionsEl.innerHTML = '';
    searchEmptyEl.hidden = true;
    searchInput.value = '';
  }

  /*
   * 톱바 검색 — 글 + 임상시험 + 연구 전부(오너 지시 2026-08-16). 글은 빌드 타임 정적
   * 인덱스를 한 번만 받아 캐시해두고 브라우저에서 substring 매칭한다(언어당 최대 80여
   * 편이라 이 정도로 충분하다). 임상시험·연구는 상세페이지가 없어서, 항목을 누르면
   * /clinical/ 페이지의 실시간 검색으로 그 검색어를 그대로 넘긴다(같은 오너 지시).
   */
  interface ArticleIndexEntry {
    title: string;
    description: string;
    url: string;
  }
  interface SearchLabels {
    sectionArticles: string;
    sectionTrials: string;
    sectionResearch: string;
    viewAll: string;
  }
  const searchLocale = searchPanel.dataset.locale || 'ko';
  const clinicalHref = searchPanel.dataset.clinicalHref || '';
  const SEARCH_LABELS: SearchLabels = JSON.parse(document.getElementById('searchLabels')!.textContent!);

  let articleIndexPromise: Promise<ArticleIndexEntry[]> | null = null;
  function getArticleIndex(): Promise<ArticleIndexEntry[]> {
    if (!articleIndexPromise) {
      articleIndexPromise = fetch(`/${searchLocale}/search-index.json`)
        .then((r) => r.json())
        .catch(() => []);
    }
    return articleIndexPromise;
  }

  function esc(s: string): string {
    return s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
  }

  function sectionHtml(label: string, items: { title: string; href: string }[], viewAllHref?: string, viewAllTotal?: number): string {
    if (!items.length) return '';
    const rows = items.map((it) => `<a class="search-result-item" href="${it.href}">${esc(it.title)}</a>`).join('');
    const more =
      viewAllHref && viewAllTotal && viewAllTotal > items.length
        ? `<a class="search-result-more" href="${viewAllHref}">${esc(SEARCH_LABELS.viewAll)} (${viewAllTotal})</a>`
        : '';
    return `<div class="search-result-section"><h3>${esc(label)}</h3>${rows}${more}</div>`;
  }

  async function runHeaderSearch(rawQuery: string) {
    const query = rawQuery.trim();
    if (!query) return;

    const [articleIndex, apiRes] = await Promise.all([
      getArticleIndex(),
      fetch(`/api/search?locale=${searchLocale}&q=${encodeURIComponent(query)}`)
        .then((r) => r.json())
        .catch(() => ({ trials: [], trialsTotal: 0, research: [], researchTotal: 0 })),
    ]);

    const qLower = query.toLowerCase();
    const articleMatches = articleIndex
      .filter((a) => a.title.toLowerCase().includes(qLower) || a.description.toLowerCase().includes(qLower))
      .slice(0, 5);

    // clinicalHref(getRelativeLocaleUrl 결과)가 이미 끝에 / 를 달고 오므로 여기서 또 붙이면
    // //?q= 처럼 슬래시가 겹친다(실측 2026-08-16).
    const trialsHref = `${clinicalHref}?q=${encodeURIComponent(query)}&feed=trials`;
    const researchHref = `${clinicalHref}?q=${encodeURIComponent(query)}&feed=research`;

    const html = [
      sectionHtml(
        SEARCH_LABELS.sectionArticles,
        articleMatches.map((a) => ({ title: a.title, href: a.url })),
      ),
      sectionHtml(
        SEARCH_LABELS.sectionTrials,
        (apiRes.trials ?? []).map((it: { title: string }) => ({ title: it.title, href: trialsHref })),
        trialsHref,
        apiRes.trialsTotal,
      ),
      sectionHtml(
        SEARCH_LABELS.sectionResearch,
        (apiRes.research ?? []).map((it: { title: string }) => ({ title: it.title, href: researchHref })),
        researchHref,
        apiRes.researchTotal,
      ),
    ].join('');

    searchResultsEl.hidden = false;
    searchSectionsEl.innerHTML = html;
    searchEmptyEl.hidden = html.length > 0;
  }

  searchForm.addEventListener('submit', (e) => {
    e.preventDefault();
    runHeaderSearch(searchInput.value);
  });

  menuBtn.addEventListener('click', () => {
    const open = navLinks.classList.toggle('open');
    menuBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
    if (open) closeSearch();
  });
  navLinks.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).tagName === 'A') closeMenu();
  });

  searchBtn.addEventListener('click', () => {
    if (searchPanel.classList.contains('open')) {
      closeSearch();
      return;
    }
    searchPanel.classList.add('open');
    searchBtn.setAttribute('aria-expanded', 'true');
    closeMenu();
    setTimeout(() => searchInput.focus(), 50);
  });

  document.addEventListener('click', (e) => {
    const target = e.target as Node;
    if (navLinks.classList.contains('open') && !navLinks.contains(target) && !menuBtn.contains(target)) {
      closeMenu();
    }
    if (searchPanel.classList.contains('open') && !searchPanel.contains(target) && !searchBtn.contains(target)) {
      closeSearch();
    }
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && searchPanel.classList.contains('open')) closeSearch();
  });
</script>
