---
/*
 * 카카오 애드핏 배너. **프로덕션 + 한국어 페이지에서만** 노출한다
 * (Layout.astro 의 `adsEnabled` 와 같은 기준). 애드핏은 국내 광고주 네트워크라 해외 언어
 * 페이지에 띄워봐야 채워지지 않는다 — 지금 이 컴포넌트를 쓰는 곳도 /ko/ 페이지뿐이지만,
 * 나중에 해외 페이지에 잘못 끼워 넣어도 조용히 빈 칸이 생기지 않게 여기서도 막아 둔다.
 * 로더 스크립트(ba.min.js)는 Layout.astro 의 </body> 바로 위에서 한 번만 불러온다
 * (애드핏 SDK 가이드 권장 위치) — 이 컴포넌트는 <ins> 광고 영역만 그린다.
 *
 * ⚠️ 본문(.article-body)에서 쓰는 컴포넌트가 아니다 — [category]/[slug].astro 에서
 * 세 줄 요약 뒤·본문 앞에 한 번 넣는다("본문 시작 직후" 슬롯, docs/website-plan.md 의도).
 */
import { t } from '../../i18n';

interface Props {
  unit: string;
  width: number;
  height: number;
}
const { unit, width, height } = Astro.props;
const locale = Astro.currentLocale ?? 'ko';
const adsEnabled = Astro.site?.host === 'parkinon.com' && locale === 'ko';
---

{adsEnabled && (
  <div class="adfit-banner">
    <span class="adfit-label">{t(locale, 'ad.label')}</span>
    <ins
      class="kakao_ad_area"
      style="display:none;"
      data-ad-unit={unit}
      data-ad-width={String(width)}
      data-ad-height={String(height)}
    ></ins>
  </div>
)}

<style>
  .adfit-banner {
    margin: 24px 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }
  .adfit-label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--text-sub);
  }
</style>
