---
/* 앱 추천 블록.
 *
 * ⚠️ 자리는 **글이 끝난 뒤**(출처 다음)다 — 오너 지시 2026-08-06:
 *    "해당 게시글은 끝내고 나서 추천해야 하니까."
 *
 * 스토어 버튼은 홈(`src/pages/ko/index.astro`)의 `.store-badge` 와 **같은 모양**이다
 * (오너 지시: "홈화면에 있는것처럼"). 홈 것을 고치면 여기도 같이 맞출 것.
 * 스토어 주소는 `src/lib/links.ts` 한 곳에서 관리한다(홈과 공용).
 */
import { Image } from 'astro:assets';
import shot1 from '../../assets/images/appshots/parkinon1.png';
import shot2 from '../../assets/images/appshots/parkinon2.png';
import shot3 from '../../assets/images/appshots/parkinon3.png';
import shot4 from '../../assets/images/appshots/parkinon4.png';
import shot5 from '../../assets/images/appshots/parkinon5.png';
import shot6 from '../../assets/images/appshots/parkinon6.png';
import shot7 from '../../assets/images/appshots/parkinon7.png';
import shot8 from '../../assets/images/appshots/parkinon8.png';
import shotEtc from '../../assets/images/appshots/parkinon_etc.png';
/*
 * 영어 앱 화면 — 미국 App Store 에 실제로 게재된 영어 스크린샷을 그대로 가져와,
 * iOS 상태바(194px)만 잘라내고 한국어판과 같은 360px 폭으로 맞춘 것이다(2026-08-12).
 * 원본 파일명이 스토어 등록명(01_medications 등)이라 한국어판(parkinon1..8)과 다르다.
 */
import enShotMed from '../../assets/images/appshots/en/01_medications.png';
import enShotTracking from '../../assets/images/appshots/en/02_tracking.png';
import enShotExercise from '../../assets/images/appshots/en/03_exercise.png';
import enShotReminders from '../../assets/images/appshots/en/04_reminders.png';
import enShotAddMed from '../../assets/images/appshots/en/05_add_medication.png';
import enShotMyInfo from '../../assets/images/appshots/en/06_premium.png';
import { PLAY_STORE_URL, appleStoreUrl } from '../../lib/links';
import { t, type DictKey } from '../../i18n';

/*
 * 글 주제에 맞는 앱 화면을 보여주기 위한 매핑(오너 지시 2026-08-09: "약복용 내용만 있는데
 * 각 상세페이지 내용과 맞는 걸로 바꾸자"). 글 frontmatter의 `appFeature` 값으로 고른다.
 */
const FEATURE_SHOTS = {
  effectTracking: shot2,
  exercise: shot3,
  record: shot4,
  medRegistration: shot5,
  family: shot6,
  reminder: shot7,
  familyDiary: shot8,
  community: shotEtc,
} as const;

/*
 * 언어별 앱 화면. 영어 페이지에 한국어 UI 스크린샷이 나가면 안 된다.
 */
const SHOTS_BY_LOCALE: Record<string, { default: ImageMetadata; features: Partial<Record<keyof typeof FEATURE_SHOTS, ImageMetadata>> }> = {
  ko: { default: shot1, features: FEATURE_SHOTS },
  /*
   * 영어판은 스토어에 게재된 6장만 있어서 한국어판(9장)과 1:1 대응이 안 된다.
   * 그렇다고 전부 기본 화면으로 폴백시키면 42편 중 34편이 같은 그림이 된다(오너 지적 2026-08-12).
   * → 없는 것은 **내용상 가장 가까운 실제 화면**에 붙인다. 매핑 근거는 화면을 직접 보고 정했다:
   *   06_premium 은 결제 화면이 아니라 '내정보' 탭이라 Family Diary·View my records·
   *   Medical visits 메뉴가 그대로 보인다 → record·family·familyDiary 에 쓸 수 있다.
   * ⚠️ community 는 스크린샷이 없는 게 아니라 **해외 앱에 기능 자체가 없다.**
   *   아래 UNAVAILABLE_FEATURES 에서 통째로 막는다.
   */
  en: {
    default: enShotMed,
    features: {
      // community 는 여기 넣지 않는다 — 아래 UNAVAILABLE_FEATURES 참고.
      effectTracking: enShotTracking,
      exercise: enShotExercise,
      reminder: enShotReminders,
      medRegistration: enShotAddMed,
      record: enShotMyInfo,
      family: enShotMyInfo,
      familyDiary: enShotMyInfo,
    },
  },
};

/*
 * 그 언어판 앱에 **기능 자체가 없는** 항목. 이미지가 없는 것과는 다른 문제다.
 *
 * 해외 로케일에는 커뮤니티(정보·나눔)가 아예 없다 — 앱이 그 탭 자리에 OverseasMedTab 을
 * 넣는다(parkinon-app/src/navigation/MainNavigator.tsx:56-58). 그런데 한국어 글 하나가
 * `appFeature: community` 를 쓰고 있어서, 그대로 번역하면 영어 독자에게
 * "정보·나눔 커뮤니티에서 경험을 나눠보세요" 라고 **없는 기능을 광고**하게 된다
 * (오너 지적 2026-08-12). 이미지만 폴백시키면 문구가 그대로 남아 못 막는다.
 *
 * 그래서 여기 있는 기능은 feature 를 통째로 무시하고 기본 홍보(이미지+문구)로 돌린다.
 * 번역자가 실수로 값을 넣어도 자동으로 막힌다.
 */
const UNAVAILABLE_FEATURES: Record<string, readonly (keyof typeof FEATURE_SHOTS)[]> = {
  en: ['community'],
};

interface Props {
  feature?: keyof typeof FEATURE_SHOTS;
  title?: string;
  body?: string;
}
const locale = Astro.currentLocale ?? 'ko';
const { feature, title: titleProp, body: bodyProp } = Astro.props;

const shotSet = SHOTS_BY_LOCALE[locale] ?? SHOTS_BY_LOCALE.ko;
// 이 언어판에 없는 기능이면 feature 를 버린다 → 이미지도 문구도 기본 홍보로 나간다.
const blocked = UNAVAILABLE_FEATURES[locale] ?? [];
const feat = feature && !blocked.includes(feature) ? feature : undefined;

const appShot = (feat ? shotSet.features[feat] : undefined) ?? shotSet.default;
const shotAlt = feat ? t(locale, `app.${feat}.alt` as DictKey) : t(locale, 'app.shotAlt');
const title = titleProp ?? (feat ? t(locale, `app.${feat}.title` as DictKey) : t(locale, 'app.promoTitle'));
const body = bodyProp ?? (feat ? t(locale, `app.${feat}.body` as DictKey) : t(locale, 'app.promoBody'));
---

<aside class="app">
  <div class="shot">
    <Image src={appShot} alt={shotAlt} widths={[200, 300, 420]} sizes="(max-width: 640px) 132px, 210px" />
  </div>

  <div class="text">
    <h3>{title}</h3>
    <p>{body}</p>
  </div>

  <div class="store-badges">
    <a class="store-badge" href={PLAY_STORE_URL} target="_blank" rel="noopener">
      <svg class="icon" viewBox="0 0 24 24" fill="#fff"><polygon points="5,3 5,21 20,12"></polygon></svg>
      <span class="big">Google Play</span>
    </a>
    <a class="store-badge" href={appleStoreUrl(locale)} target="_blank" rel="noopener">
      <svg class="icon" viewBox="0 0 384 512" fill="#fff"
        ><path
          d="M318 268c-1-56 46-83 48-84-26-38-67-43-81-44-34-3-67 20-84 20-18 0-44-20-73-19-37 1-72 22-91 55-39 68-10 168 28 223 19 27 41 57 71 56 28-1 39-18 74-18 34 0 45 18 74 18 31-1 50-27 69-54 22-31 31-61 31-63-1 0-59-23-60-90zM258 63c16-19 27-46 24-73-23 1-51 15-68 34-15 17-28 44-25 70 26 2 53-13 69-31z"
        ></path></svg
      >
      <span class="big">App Store</span>
    </a>
  </div>
</aside>

<style>
  /*
   * 데스크톱: 사진 왼쪽 · 글과 버튼 오른쪽.
   * 모바일: 사진을 작게 줄여 글과 나란히 두고, 버튼은 아래 한 줄을 통째로 쓴다.
   *   → 사진 한 장을 가운데 놓아 좌우가 휑하던 문제를 없앤다(오너 지적 2026-08-06).
   */
  .app {
    margin-top: 30px;
    display: grid;
    grid-template-columns: 210px 1fr;
    grid-template-areas:
      'shot text'
      'shot badges';
    align-content: center;
    gap: 14px 26px;
    background: var(--surface-low);
    border-radius: 16px;
    padding: 24px;
  }
  .shot {
    grid-area: shot;
    align-self: center;
  }
  .text {
    grid-area: text;
    align-self: end;
  }
  .store-badges {
    grid-area: badges;
    align-self: start;
    display: flex;
    gap: 10px;
    max-width: 420px;
  }
  .app :global(img) {
    width: 100%;
    height: auto;
    border-radius: 14px;
    box-shadow: 0 10px 24px -12px rgba(0, 0, 0, 0.35);
  }
  h3 {
    font-size: 18px;
    color: var(--text);
    /* 한국어는 낱말 중간에서 끊지 않는다 — 좁은 폭에서 "앱으/로"처럼 잘리는 것 방지 */
    word-break: keep-all;
  }
  p {
    margin-top: 8px;
    font-size: 15.5px;
    line-height: 1.75;
    color: var(--text-sub);
    word-break: keep-all;
  }

  /* 홈의 스토어 버튼과 같은 모양 */
  .store-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    background: #000;
    color: #fff;
    padding: 0 16px;
    border-radius: 8px;
    height: 44px;
    flex: 1 1 0;
    min-width: 0;
  }
  .store-badge .icon {
    width: 19px;
    height: 19px;
    flex-shrink: 0;
  }
  .store-badge .big {
    font-size: 15px;
    font-weight: 700;
    font-family: var(--font-head);
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .app {
      grid-template-columns: 132px 1fr;
      grid-template-areas:
        'shot text'
        'badges badges';
      gap: 16px;
      padding: 18px;
    }
    .text {
      align-self: center;
    }
    .store-badges {
      max-width: none;
    }
    h3 {
      font-size: 17px;
    }
    p {
      margin-top: 6px;
      font-size: 14.5px;
      line-height: 1.7;
    }
  }
</style>
