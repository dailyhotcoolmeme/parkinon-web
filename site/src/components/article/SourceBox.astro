---
/* 출처·기준일·문의 박스. 제도 글은 이게 없으면 안 된다(콘텐츠 원칙).
   글 상세 라우트가 frontmatter 값으로 자동 렌더하므로 MDX 본문에서 직접 쓸 일은 없다. */
interface Props {
  basisDate?: string;
  sources?: { name: string; url?: string }[];
  contact?: string;
}
const { basisDate, sources = [], contact } = Astro.props;
---

<div class="source">
  {basisDate && <b>{basisDate}</b>}
  {
    sources.length > 0 && (
      <p>
        출처 ·{' '}
        {sources.map((s, i) => (
          <>
            {i > 0 && ' / '}
            {s.url ? (
              <a href={s.url} target="_blank" rel="noopener">
                {s.name}
              </a>
            ) : (
              s.name
            )}
          </>
        ))}
      </p>
    )
  }
  {contact && <p>문의 · {contact}</p>}
  <p class="report">내용이 바뀐 것을 발견하시면 admin@ourmine.co.kr 로 알려주세요.</p>
</div>

<style>
  .source {
    margin-top: 36px;
    padding: 18px 20px;
    background: var(--surface-low);
    border-radius: 14px;
    font-size: 13px;
    color: var(--text-sub);
    line-height: 1.8;
  }
  b {
    color: var(--text);
    font-size: 13.5px;
  }
  p {
    margin-top: 2px;
  }
  a {
    text-decoration: underline;
  }
  a:hover {
    color: var(--primary);
  }
  .report {
    margin-top: 8px;
  }
</style>
