---
/* 출처·기준일·문의 박스. 제도 글은 이게 없으면 안 된다(콘텐츠 원칙).
   글 상세 라우트가 frontmatter 값으로 자동 렌더하므로 MDX 본문에서 직접 쓸 일은 없다. */
import { t } from '../../i18n';

interface Props {
  basisDate?: string;
  sources?: { name: string; url?: string }[];
  contact?: string;
}
const { basisDate, sources = [], contact } = Astro.props;
const locale = Astro.currentLocale ?? 'ko';
---

<div class="source">
  {basisDate && <b>{basisDate}</b>}
  {
    sources.length > 0 && (
      <p>
        {t(locale, 'source.title')} ·{' '}
        {sources.map((s, i) => (
          <>
            {i > 0 && ' / '}
            {s.url ? (
              <a href={s.url} target="_blank" rel="noopener">
                {s.name}
              </a>
            ) : (
              s.name
            )}
          </>
        ))}
      </p>
    )
  }
  {contact && <p>{t(locale, 'source.contact')} · {contact}</p>}
</div>

<style>
  /*
   * 박스를 씌우지 않는다 — 바로 아래 앱 추천 박스와 똑같은 회색 라운드 박스라 어색하다는
   * 오너 지적(2026-08-06). 얇은 선 하나로만 본문과 구분한다.
   */
  .source {
    margin-top: 36px;
    padding-top: 18px;
    border-top: 1px solid var(--outline);
    font-size: 13px;
    color: var(--text-sub);
    line-height: 1.8;
  }
  b {
    color: var(--text);
    font-size: 13.5px;
  }
  p {
    margin-top: 2px;
  }
  a {
    text-decoration: underline;
  }
  a:hover {
    color: var(--primary);
  }
</style>
