---
/* 절차 카드 (1-2-3). 시안 승인 2026-08-06.
   쓰는 법(MDX): <Steps steps={[{ title: '...', body: '...' }, ...]} /> */
interface Props {
  steps: { title: string; body: string }[];
}
const { steps } = Astro.props;
---

<ol class="steps">
  {
    steps.map((s, i) => (
      <li>
        <span class="n">{i + 1}</span>
        <div>
          <h3>{s.title}</h3>
          <p>{s.body}</p>
        </div>
      </li>
    ))
  }
</ol>

<style>
  .steps {
    list-style: none;
    margin: 18px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .steps li {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    background: var(--surface-low);
    border-radius: 14px;
    padding: 18px 20px;
  }
  .n {
    flex-shrink: 0;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--primary);
    color: #fff;
    font-weight: 800;
    font-size: 15px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  h3 {
    font-size: 16.5px;
    color: var(--text);
  }
  p {
    margin-top: 5px;
    font-size: 15px;
    line-height: 1.7;
    color: var(--text-sub);
  }
</style>
