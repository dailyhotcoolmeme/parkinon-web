---
/* 절차 카드 (1-2-3). 시안 승인 2026-08-06.
   쓰는 법(MDX): <Steps steps={[{ title: '...', body: '...' }, ...]} /> */
interface Props {
  steps: { title: string; body: string }[];
}
const { steps } = Astro.props;
---

<div class="steps" role="list">
  {
    steps.map((s, i) => (
      <div role="listitem">
        <span class="n">{i + 1}</span>
        <div>
          <div class="step-title">{s.title}</div>
          <div class="step-body">{s.body}</div>
        </div>
      </div>
    ))
  }
</div>

<style>
  /*
   * <ol>/<li> 가 아니라 <div role="list">/<div role="listitem"> 를 쓴다 — 태그 이름이
   * ol·li 면 이 컴포넌트가 렌더되는 본문(.article-body)의 전역 마크다운 리스트 스타일
   * (padding-left:22px)이 그대로 새어 들어온다(오너 발견 2026-08-09: 카드 왼쪽에 빈
   * 공간). 위 제목·본문을 h3·p 대신 div로 바꾼 것과 같은 이유·같은 해결책이다.
   * role 속성으로 스크린리더용 목록 의미는 그대로 유지한다.
   */
  .steps {
    margin: 18px 0 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .steps > [role='listitem'] {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    background: var(--surface-low);
    border-radius: 14px;
    padding: 18px 20px;
  }
  .n {
    flex-shrink: 0;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--primary);
    color: #fff;
    font-weight: 800;
    font-size: 15px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  /*
   * <h3>/<p> 대신 <div> 를 쓴다 — 이 제목·본문은 본문(.article-body) 안에서 렌더되는데,
   * .article-body 전역 스타일이 태그 기준(h3, p)으로 걸려 있어 같은 태그를 쓰면 그 스타일이
   * 그대로 새어 들어온다(오너 발견 2026-08-09: 번호와 제목 사이에 28px 틈이 생김 —
   * 전역 h3 규칙의 margin-top:28px 가 이 카드 제목까지 덮어썼던 것).
   */
  .step-title {
    font-size: 16.5px;
    font-weight: 700;
    color: var(--text);
  }
  .step-body {
    margin-top: 5px;
    font-size: 15px;
    line-height: 1.7;
    color: var(--text-sub);
  }
</style>
