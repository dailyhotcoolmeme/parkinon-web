---
/*
 * 전문 용어 인라인 설명 — 클리닉 페이지의 "임상 단계 물음표"(phase-help)와 같은 목적이다
 * (오너 확정 2026-08-08). 차이는 트리거가 옆에 붙는 "?" 아이콘이 아니라 용어 단어 자체에
 * 밑줄을 긋는 것이다.
 *
 * ⚠️ phase-help처럼 네이티브 <details>로 만들었다가 실패했다(2026-08-08) — 크롬은
 * <details>에 display:inline을 줘도 내부적으로 줄바꿈을 강제해서, 한 문장 안에 여러 개를
 * 나란히 쓰면(`LRRK2, GBA, SNCA`) 각각 자기 줄로 떨어졌다. phase-help는 트리거가 문장
 * 안이 아니라 <dd> 뒤에 붙는 배지 하나뿐이라 이 문제를 안 겪었을 뿐이다. 그래서 여기는
 * <details> 대신 순수 <span> + 아주 작은 JS 토글로 만든다 — 문장 중간에 여러 개를 나란히
 * 둬도 진짜 inline으로 흐른다.
 *
 * 쓰는 법(MDX): <Term brief="짧은 설명 한두 줄" href="/ko/lifestyle/glossary/#앵커">LRRK2</Term>
 * href는 선택 — 있으면 팝업 안에 "자세히 알아보기" 링크가 용어사전 해당 섹션으로 간다.
 * 새 용어를 쓸 때마다 glossary.mdx에도 그 용어의 자세한 설명 섹션(##)을 추가할 것.
 *
 * ⚠️ 한 문장 안에서 여러 개를 이어 쓸 때 각 <Term> 태그를 줄 앞에 새로 시작하지 말 것 —
 * MDX가 그걸 별개 블록으로 쪼갤 수 있다(2026-08-08 실제로 겪음). 한 줄로 이어서 쓸 것.
 *
 * ⚠️ 2026-08-08 — position:absolute(용어 기준) + JS로 "넘치면 왼쪽으로 당기기"를 했었는데,
 * 헤드리스 크롬 테스트에서는 매번 화면 안에 들어왔지만 오너 실기기에서는 계속 넘쳤다(원인
 * 특정 못함). 그래서 좁은 화면에서 "화면 하단 중앙 고정"으로 바꿨다가, 오너가 "용어 옆에
 * 뜨는 팝업"이라는 원래 디자인을 버린 잘못된 도피라며 격노하고 반려했다. 그래서 다시
 * 용어 옆에 뜨는 방식으로 되돌리되, 이번엔 position:absolute(부모 기준 상대 좌표라
 * 조상 요소의 overflow/transform 등에 영향받을 수 있음) 대신 **position:fixed +
 * getBoundingClientRect()로 계산한 뷰포트 절대 좌표**를 쓴다 — fixed는 조상이 무엇이든
 * 항상 뷰포트 기준이라 애매함이 없다(Popper.js 등 툴팁 라이브러리가 쓰는 표준 방식).
 * 화면 오른쪽/아래로 넘치면 JS가 좌표를 안으로 당기거나 위로 뒤집는다.
 */
import { t } from '../../i18n';

interface Props {
  brief: string;
  href?: string;
}
const { brief, href } = Astro.props;
const locale = Astro.currentLocale ?? 'ko';
const readMore = t(locale, 'term.readMore');
---

<span class="term" tabindex="0" role="button">
  <span class="term-label"><slot /></span>
  <span class="term-pop">
    {brief}
    {href && <a href={href}>{readMore}</a>}
  </span>
</span>

<style>
  .term {
    position: relative;
    cursor: pointer;
  }
  .term-label {
    text-decoration: underline;
    text-decoration-style: dotted;
    text-decoration-color: var(--text-sub);
    text-underline-offset: 3px;
  }
  .term.open .term-label {
    color: var(--primary);
    text-decoration-color: var(--primary);
  }
  .term-pop {
    display: none;
    position: fixed;
    z-index: 50;
    width: min(280px, calc(100vw - 24px));
    padding: 10px 12px;
    background: var(--surface);
    border: 1px solid var(--outline);
    border-radius: 8px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12);
    font-size: 12.5px;
    font-weight: 400;
    line-height: 1.55;
    color: var(--text);
    white-space: normal;
  }
  .term.open .term-pop {
    display: block;
  }
  .term-pop a {
    /* display: inline-block 만으로는 폭이 넉넉하면 설명 글 끝에 그대로 붙어버렸다
       (2026-08-08 오너 스크린샷 지적: "자세히보기 앞에서 줄바꿈 되어야지"). block으로
       바꿔서 폭과 무관하게 항상 새 줄에서 시작하게 한다. */
    display: block;
    margin-top: 8px;
    color: var(--primary);
    font-weight: 700;
  }
</style>

<script>
  /* 클릭 토글 + 바깥 클릭 시 닫기. <details>가 아니라 순수 span이라 토글을 직접 짠다. */
  const MARGIN = 8;

  function positionPopover(term: HTMLElement) {
    const pop = term.querySelector<HTMLElement>('.term-pop');
    if (!pop) return;
    // position:fixed는 조상 요소가 무엇이든 항상 뷰포트 기준 좌표라, 조상의 overflow나
    // 위치 지정 방식에 영향받지 않는다 — getBoundingClientRect()로 잰 좌표를 그대로 쓴다.
    const termRect = term.getBoundingClientRect();
    const popRect = pop.getBoundingClientRect();

    let left = termRect.left;
    const maxLeft = window.innerWidth - popRect.width - MARGIN;
    left = Math.max(MARGIN, Math.min(left, maxLeft));

    let top = termRect.bottom + 6;
    if (top + popRect.height > window.innerHeight - MARGIN) {
      // 아래쪽에 자리가 없으면 용어 위로 뒤집는다.
      top = termRect.top - popRect.height - 6;
    }
    top = Math.max(MARGIN, top);

    pop.style.left = `${left}px`;
    pop.style.top = `${top}px`;
  }

  function closeAllTerms() {
    document.querySelectorAll<HTMLElement>('.term.open').forEach((el) => el.classList.remove('open'));
  }

  function repositionOpenTerms() {
    document.querySelectorAll<HTMLElement>('.term.open').forEach(positionPopover);
  }

  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const clickedTerm = target.closest<HTMLElement>('.term');

    document.querySelectorAll<HTMLElement>('.term.open').forEach((el) => {
      if (el !== clickedTerm) el.classList.remove('open');
    });

    if (clickedTerm && !target.closest('a')) {
      const willOpen = !clickedTerm.classList.contains('open');
      clickedTerm.classList.toggle('open');
      if (willOpen) positionPopover(clickedTerm);
    }
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Enter' && e.key !== ' ') return;
    const target = e.target as HTMLElement;
    if (target.classList.contains('term')) {
      e.preventDefault();
      const willOpen = !target.classList.contains('open');
      target.classList.toggle('open');
      if (willOpen) positionPopover(target);
    }
  });
  /*
   * 스크롤/리사이즈 중에는 term 기준 좌표가 계속 바뀌므로 팝업 위치를 다시 계산한다
   * (position:fixed라 열어둔 채로 스크롤하면 화면 위 고정 위치와 용어 위치가 어긋난다).
   * ⚠️ 예전엔 "닫는다"였는데, 화면 아래쪽 용어를 탭하면 브라우저가 그 요소를 보이는
   * 영역으로 자동 스크롤시키면서 클릭 직후(약 15ms 뒤) 스크롤 이벤트가 한 번 발생했다 —
   * "스크롤하면 닫는다" 로직이 그 자기 스크롤 때문에 방금 연 팝업을 바로 닫아버리는
   * 문제가 있었다(2026-08-09, 이벤트 타임스탬프로 클릭→스크롤 순서 확인). 위치만
   * 다시 계산하면 이 문제가 없어지고, 스크롤 중에도 팝업이 용어를 계속 따라다닌다.
   */
  window.addEventListener('scroll', repositionOpenTerms, { passive: true });
  window.addEventListener('resize', repositionOpenTerms);
</script>
