---
import { getImage } from 'astro:assets';
import ogSource from '../assets/images/hero.jpg';
import logoImg from '../assets/images/logo.png';
import { t } from '../i18n';
import { localeLinksFor } from '../lib/i18nLinks';

type Locale = 'ko' | 'en' | 'fr' | 'ja';

interface Props {
  title: string;
  description?: string;
  /* og:type. 글 상세는 'article', 그 외는 'website' */
  ogType?: 'website' | 'article';
  /*
   * 구조화 데이터(JSON-LD)는 여기서 만든다 — 페이지는 재료만 넘긴다.
   * Google Article 문서: **필수 속성은 없고 "해당되는 것만" 넣으라**고 되어 있다.
   * 그래서 우리가 추적하지 않는 값(수정일 dateModified, 집필자 개인 이름)은 넣지 않는다.
   * 없는 정보를 지어내면 안 된다.
   */
  breadcrumbs?: { name: string; path: string }[];
  article?: { headline: string; datePublished: string; description?: string };
  /*
   * hreflang 을 **손으로** 지정할 때만 쓴다. 보통은 넘기지 않는다 —
   * 안 넘기면 아래에서 `lib/i18nLinks.ts` 가 경로를 보고 알아서 계산한다.
   * ⚠️ 넘길 거면 **실제로 존재하는 언어만** 넣을 것. 없는 번역까지 hreflang 을 걸면
   * 상호 링크가 성립하지 않아 Google 이 주석 전체를 무시한다(현지화 버전 문서).
   */
  translations?: Partial<Record<Locale, string>>;
}

const {
  title,
  description = t((Astro.currentLocale ?? 'ko') as Locale, 'site.description'),
  translations,
  ogType = 'website',
  breadcrumbs,
  article,
} = Astro.props;

const locale = (Astro.currentLocale ?? 'ko') as Locale;
const siteName = t(locale, 'brand.name');
const canonical = new URL(Astro.url.pathname, Astro.site);

/*
 * 공유 카드용 이미지 — OG 표준 비율 1.91:1 을 유지해 기존 hero 사진을 빌드 때 잘라 쓴다.
 * ⚠️ 1200x630(권장 크기)은 원본이 1000x667 이라 업스케일 없이는 불가능하다.
 *    억지로 늘리지 않고 원본 폭에 맞춘 1000x524 로 쓴다(대형 카드 최소 600x315 이상이라 유효).
 *    제대로 된 1200x630 브랜드 카드 이미지는 따로 만들어야 한다(디자인 필요).
 * 아래 값과 og:image:width/height 는 반드시 같아야 한다 — 실제와 다른 크기를 적지 말 것.
 */
const OG_W = 1000;
const OG_H = 524;
const ogImage = await getImage({ src: ogSource, width: OG_W, height: OG_H, format: 'jpeg' });
const ogImageUrl = new URL(ogImage.src, Astro.site).href;
const ogLocale = { ko: 'ko_KR', en: 'en_US', fr: 'fr_FR', ja: 'ja_JP' }[locale];
const langTag = { ko: 'ko-KR', en: 'en-US', fr: 'fr-FR', ja: 'ja-JP' }[locale];

const homeUrl = new URL(`/${locale}/`, Astro.site).href;
const publisher = {
  '@type': 'Organization',
  name: siteName,
  url: homeUrl,
  logo: new URL(logoImg.src, Astro.site).href,
};

const jsonLdList: Record<string, unknown>[] = [];
if (canonical.href === homeUrl) {
  jsonLdList.push({ '@context': 'https://schema.org', '@type': 'WebSite', name: siteName, url: homeUrl, inLanguage: langTag });
  jsonLdList.push({ '@context': 'https://schema.org', ...publisher });
}
if (breadcrumbs?.length) {
  jsonLdList.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbs.map((b, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: b.name,
      item: new URL(b.path, Astro.site).href,
    })),
  });
}
if (article) {
  jsonLdList.push({
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: article.headline,
    description: article.description ?? description,
    datePublished: article.datePublished,
    image: [ogImageUrl],
    inLanguage: langTag,
    author: publisher,
    publisher,
    mainEntityOfPage: canonical.href,
  });
}

/*
 * hreflang: 자기 자신 포함 전부 나열 + x-default. 절대 URL 이어야 한다.
 *
 * ⚠️ 예전에는 페이지가 `translations` prop 을 넘겨주기를 기다렸는데, **넘기는 페이지가
 * 하나도 없어서 2026-09-01 까지 사이트 전체에 hreflang 이 한 줄도 안 나갔다**(라이브에서
 * `rel="alternate"` 0개 확인). 그래서 지금은 **경로를 보고 스스로 계산한다** — 페이지가
 * 늘어도 따로 챙길 것이 없다. prop 으로 넘어온 값이 있으면 그쪽을 우선한다(예외 처리용).
 *
 * `exact: false`(번역이 없어 그 언어의 홈으로 보내는 경우)는 **넣지 않는다.** 같은 내용이
 * 아닌 주소를 번역판이라고 알리면 상호 링크가 성립하지 않아 Google 이 주석 전체를 무시한다.
 */
const autoLinks = translations ? [] : await localeLinksFor(Astro.url.pathname);
const autoPairs = autoLinks.filter((l) => l.exact).map((l) => [l.code, l.href] as [string, string]);
const pairs = translations ? Object.entries(translations) : autoPairs;
const alternates = pairs.length > 1 ? pairs : [];
/*
 * x-default = 대문 `/`.
 *
 * 여기는 원래 **한국어**를 가리키고 있었다(2026-09-02까지). x-default 는 "어느 언어에도
 * 안 맞는 사람에게 보여줄 주소"라서, 한국어를 가리키면 스페인어·포르투갈어를 쓰는 검색
 * 이용자에게 한국어 페이지가 대표로 잡힌다 — 해외 시장을 먼저 보는 이 사이트에서는 정반대다.
 * `/` 는 Accept-Language·나라를 보고 6개 언어로 302 하는 대문이고(`functions/index.ts`),
 * 이것이 Google 이 문서에서 x-default 의 표준 예로 드는 바로 그 형태다.
 */
const xDefault = translations?.ko ?? (alternates.length > 0 ? '/' : undefined);

/*
 * dev 배포(parkinon-site-dev.pages.dev)가 검색에 잡히면 본 사이트와 중복 콘텐츠가 된다.
 * 정식 도메인으로 빌드할 때만 색인을 허용한다 → PUBLIC_SITE_URL=https://parkinon.com
 *
 * 2026-08-16 ~ 08-31 에는 여기에 `&& locale === 'ko'` 가 붙어 있었다 — "애드센스 심사는
 * 한국어만 보이게" 해둔 기간이라 해외 언어에는 noindex 를 걸었다. 08-30 애드센스가
 * parkinon.com 을 거절했고 재심사를 한참 뒤로 미루기로 하면서, 오너 지시로 전 언어를
 * 열었다(2026-09-01) → 이제 색인은 도메인만 본다.
 */
const indexable = Astro.site?.host === 'parkinon.com';

/*
 * 광고(카카오 애드핏) 호출 조건은 색인과 **따로** 둔다.
 * - dev 배포에서는 테스트용 무효 노출이 잡히지 않게 아예 안 부른다.
 * - 애드핏은 국내 광고주 네트워크라 해외 언어 페이지에 띄워봐야 채워지지 않는다.
 *   그래서 언어를 연 뒤에도 광고는 **한국어 페이지에서만** 나가게 유지한다
 *   (2026-09-01 — 해외 언어 광고를 어떻게 할지는 오너가 따로 정할 사안).
 */
const adsEnabled = Astro.site?.host === 'parkinon.com' && locale === 'ko';
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="google-site-verification" content="lPNo9z49Q1kcJSg7R8GJNCPrx_b3qbvU-5r47uggVTQ" />
    <meta name="naver-site-verification" content="602531f8fbb0e2f0b1f6fb872ffa4db95a24b752" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#2E7D32" />
    <link rel="canonical" href={canonical.href} />
    {
      alternates.map(([code, path]) => (
        <link rel="alternate" hreflang={code} href={new URL(path, Astro.site).href} />
      ))
    }
    {xDefault && alternates.length > 0 && <link rel="alternate" hreflang="x-default" href={new URL(xDefault, Astro.site).href} />}
    {!indexable && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content={String(OG_W)} />
    <meta property="og:image:height" content={String(OG_H)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {jsonLdList.map((data) => <script is:inline type="application/ld+json" set:html={JSON.stringify(data)} />)}
    <title>{title}</title>
  </head>
  <body>
    <slot />
    {/*
      카카오 애드핏 로더. 애드핏 SDK 가이드 권장대로 </body> 바로 위에서 한 번만 불러온다.
      조건은 위 adsEnabled 참고 — 프로덕션 + 한국어 페이지에서만 부른다.
    */}
    {adsEnabled && (
      <script async type="text/javascript" src="https://t1.kakaocdn.net/kas/static/ba.min.js"></script>
    )}
  </body>
</html>

<style is:global>
  /* 폰트: CDN 대신 자체 호스팅 (site/public/fonts — public/fonts 에서 복사) */
  @font-face {
    font-family: 'Pretendard';
    src: url('/fonts/Pretendard-Regular.otf') format('opentype');
    font-weight: 400;
    font-display: swap;
  }
  @font-face {
    font-family: 'Pretendard';
    src: url('/fonts/Pretendard-Bold.otf') format('opentype');
    font-weight: 700;
    font-display: swap;
  }
  @font-face {
    font-family: 'Pretendard';
    src: url('/fonts/Pretendard-Bold.otf') format('opentype');
    font-weight: 800;
    font-display: swap;
  }
  /* 로고 옆 브랜드 글자를 더 두껍게(오너 지시 2026-08-10) — 800(Bold)까지만 있던 걸
     실제 900(Black) 파일을 새로 받아 추가했다. font-weight:900 만 주는 건 로드된
     굵기가 없어 800과 똑같이 렌더된다 — 진짜 굵기 파일이 있어야 차이가 난다. */
  @font-face {
    font-family: 'Pretendard';
    src: url('/fonts/Pretendard-Black.otf') format('opentype');
    font-weight: 900;
    font-display: swap;
  }

  /*
   * 디자인 토큰 — 앱 실제 브랜드 컬러 재사용 (website-plan.md "디자인" 확정 사항,
   * 2026-08-03: 웹 전용 색을 새로 짓지 말 것). 스크래치패드 목업(parkinon_home_v4 등)과
   * 동일한 값 — 페이지를 이식할 때 이 파일의 토큰만 참조하면 목업과 그대로 맞는다.
   */
  :root {
    --primary: #2e7d32;
    --primary-container: #4caf50;
    --on-primary-container: #ffffff;
    --secondary: #4caf50;
    --secondary-container: #e8f5e9;
    --on-secondary-container: #2e7d32;
    --tertiary: #ff9800;
    --tertiary-dark: #8a4f00;
    --tertiary-container: #ffe9c7;
    --bg: #ffffff;
    --surface: #ffffff;
    --surface-low: #f5f5f5;
    --surface-high: #eeeeee;
    --outline: #eeeeee;
    --text: #111111;
    --text-sub: #666666;
    --font-head: 'Pretendard', 'Apple SD Gothic Neo', 'Malgun Gothic', -apple-system, sans-serif;
    --font-body: 'Pretendard', 'Apple SD Gothic Neo', 'Malgun Gothic', -apple-system, sans-serif;
    --max: 1280px;
    --gutter: 24px;
  }
  @media (max-width: 760px) {
    :root {
      --gutter: 16px;
    }
  }
  :root[data-theme='dark'] {
    --bg: #10140e;
    --surface: #171b13;
    --surface-low: #1c2117;
    --surface-high: #242a1e;
    --outline: #333a2b;
    --text: #eef1ea;
    --text-sub: #adb5a4;
    --primary: #66bb6a;
    --primary-container: #2e7d32;
    --on-primary-container: #ffffff;
    --secondary-container: #1b4332;
    --on-secondary-container: #c1ecd4;
    --tertiary-container: #4a2a0f;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) {
      --bg: #10140e;
      --surface: #171b13;
      --surface-low: #1c2117;
      --surface-high: #242a1e;
      --outline: #333a2b;
      --text: #eef1ea;
      --text-sub: #adb5a4;
      --primary: #66bb6a;
      --primary-container: #2e7d32;
      --on-primary-container: #ffffff;
      --secondary-container: #1b4332;
      --on-secondary-container: #c1ecd4;
      --tertiary-container: #4a2a0f;
    }
  }

  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: var(--font-body);
    -webkit-font-smoothing: antialiased;
    /*
     * 근본 원인(2026-08-09, 오너 지적): 브라우저 기본값(word-break: normal)은 한글
     * 음절 사이를 "아무 데서나 끊어도 되는 지점"으로 취급해서(한자·가나와 같은 취급),
     * 좁은 화면에서 "발병" 같은 단어가 "발/병"으로 쪼개진다. 지금까지 이 문제를
     * 발견할 때마다 컴포넌트 하나씩 word-break:keep-all을 따로 붙여왔는데(AppPromo,
     * index.astro, clinical 페이지, 이번 article 템플릿...), 새 컴포넌트를 만들 때마다
     * 또 잊어버리고 반복될 수밖에 없는 방식이었다. word-break는 상속되는 속성이라
     * body에 한 번만 지정하면 이후 새로 만드는 화면까지 전부 자동으로 적용된다 —
     * 컴포넌트별 개별 지정은 이제 중복이지만 지워도 되고 안 지워도 무해하다.
     *
     * ⚠️⚠️ 2026-08-14 — 일본어판을 만들면서 이 값이 재앙이 됐다(오너 지적: "일본어
     * 모바일에서 모든 페이지가 다 이상하다"). 한국어는 단어 사이에 **띄어쓰기가 있어서**
     * keep-all이어도 공백에서 줄이 바뀐다. 일본어는 띄어쓰기가 없다 — keep-all이면
     * 문장 전체가 **끊을 수 없는 한 덩어리**가 되어, 그 문장이 들어간 상자의 최소 폭이
     * 문장 길이만큼 벌어진다. 360px 화면에서 문서 폭이 804~1030px까지 벌어져서 페이지
     * 전체가 반쪽으로 찌그러졌다(홈 feature-card 788px, 제도 글 표 1014px 실측).
     * 그래서 **언어별로 값을 나눈다** — 한국어·영어는 그대로 keep-all, 일본어만 normal
     * (normal이어야 일본어가 글자 사이에서 정상적으로 줄바꿈된다).
     */
    word-break: var(--word-break);
  }
  /*
   * 언어별 줄바꿈 기준. Layout이 <html lang={locale}> 을 찍으므로 여기서 갈린다.
   * 새 컴포넌트에서 word-break를 직접 쓰지 말 것 — 쓰면 일본어에서 또 같은 사고가 난다.
   */
  html {
    --word-break: keep-all;
  }
  html[lang='ja'] {
    --word-break: normal;
  }
  h1,
  h2,
  h3,
  h4 {
    font-family: var(--font-head);
    font-weight: 800;
    margin: 0;
    /*
     * ⚠️ 2026-08-09 — 예전엔 text-wrap: balance가 있었다. 이게 진짜 원인이었다:
     * 여러 줄 제목의 줄 길이를 비슷하게 맞추려고, 줄이 다 안 찼는데도 브라우저가
     * 일부러 일찍 끊어버린다("반드시" 다음에 152px가 남았는데도 거기서 끊긴 것).
     * word-break: keep-all과 별개 문제였다 — keep-all은 "단어 중간에서 끊지 않는다"만
     * 보장하고, balance는 "줄을 다 안 채우고 끊는다"를 강제로 만든다. 오너가 원하는
     * 동작(그냥 꽉 채우고 남는 것만 다음 줄로)과 정반대라 지운다.
     */
  }
  p {
    margin: 0;
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  img {
    max-width: 100%;
    display: block;
  }
  button {
    font-family: inherit;
    cursor: pointer;
    border: none;
    background: none;
  }
  .wrap {
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }
  button:disabled,
  input:disabled {
    cursor: default;
  }

  /*
   * 페이지 셸 — 광고 세로 레일 + 본문. website-plan.md "광고 상세" 확정 사항:
   * ≥1648px 양쪽 160px 레일, 1280~1647px 우측만 300px 레일, <1280px 레일 없음(풀폭).
   * 모든 콘텐츠 페이지(허브/상세)가 공유하는 구조라 레이아웃 파일에 둔다.
   */
  .layout {
    display: flex;
    gap: 24px;
    max-width: 1648px;
    margin: 0 auto;
    padding: 0;
    align-items: flex-start;
  }
  main.col {
    flex: 1;
    min-width: 0;
    padding: 28px var(--gutter) 56px;
    max-width: 1280px;
    margin: 0 auto;
  }
  /*
   * 콘텐츠 본문 + 오른쪽 사이드 패널 그리드 — 허브·상세가 **같은 정의를 쓴다**.
   * 예전에는 허브가 전체 폭(1fr+300), 상세가 760+300 가운데 정렬이라 허브→상세로 넘어갈 때
