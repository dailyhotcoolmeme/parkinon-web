---
import { getImage } from 'astro:assets';
import ogSource from '../assets/images/hero.jpg';
import logoImg from '../assets/images/logo.png';

type Locale = 'ko' | 'en' | 'fr' | 'ja';

interface Props {
  title: string;
  description?: string;
  /* og:type. 글 상세는 'article', 그 외는 'website' */
  ogType?: 'website' | 'article';
  /*
   * 구조화 데이터(JSON-LD)는 여기서 만든다 — 페이지는 재료만 넘긴다.
   * Google Article 문서: **필수 속성은 없고 "해당되는 것만" 넣으라**고 되어 있다.
   * 그래서 우리가 추적하지 않는 값(수정일 dateModified, 집필자 개인 이름)은 넣지 않는다.
   * 없는 정보를 지어내면 안 된다.
   */
  breadcrumbs?: { name: string; path: string }[];
  article?: { headline: string; datePublished: string; description?: string };
  /*
   * 이 글의 다른 언어판 경로. 예: { ko: '/ko/institutions', en: '/en/institutions' }
   * ⚠️ **실제로 존재하는 언어만** 넘길 것. 없는 번역까지 hreflang 을 걸면 상호 링크가
   * 성립하지 않아 Google 이 주석 전체를 무시할 수 있다(현지화 버전 문서).
   * 번역이 하나뿐이면(=한국어만) hreflang 을 아예 내보내지 않는다.
   */
  translations?: Partial<Record<Locale, string>>;
}

const {
  title,
  description = 'ParkinON — 파킨슨병과 함께하는 하루하루, 조금 더 수월하게',
  translations,
  ogType = 'website',
  breadcrumbs,
  article,
} = Astro.props;

const locale = (Astro.currentLocale ?? 'ko') as Locale;
const canonical = new URL(Astro.url.pathname, Astro.site);

/*
 * 공유 카드용 이미지 — OG 표준 비율 1.91:1 을 유지해 기존 hero 사진을 빌드 때 잘라 쓴다.
 * ⚠️ 1200x630(권장 크기)은 원본이 1000x667 이라 업스케일 없이는 불가능하다.
 *    억지로 늘리지 않고 원본 폭에 맞춘 1000x524 로 쓴다(대형 카드 최소 600x315 이상이라 유효).
 *    제대로 된 1200x630 브랜드 카드 이미지는 따로 만들어야 한다(디자인 필요).
 * 아래 값과 og:image:width/height 는 반드시 같아야 한다 — 실제와 다른 크기를 적지 말 것.
 */
const OG_W = 1000;
const OG_H = 524;
const ogImage = await getImage({ src: ogSource, width: OG_W, height: OG_H, format: 'jpeg' });
const ogImageUrl = new URL(ogImage.src, Astro.site).href;
const ogLocale = { ko: 'ko_KR', en: 'en_US', fr: 'fr_FR', ja: 'ja_JP' }[locale];
const langTag = { ko: 'ko-KR', en: 'en-US', fr: 'fr-FR', ja: 'ja-JP' }[locale];

const homeUrl = new URL(`/${locale}/`, Astro.site).href;
const publisher = {
  '@type': 'Organization',
  name: '파킨온',
  url: homeUrl,
  logo: new URL(logoImg.src, Astro.site).href,
};

const jsonLdList: Record<string, unknown>[] = [];
if (canonical.href === homeUrl) {
  jsonLdList.push({ '@context': 'https://schema.org', '@type': 'WebSite', name: '파킨온', url: homeUrl, inLanguage: langTag });
  jsonLdList.push({ '@context': 'https://schema.org', ...publisher });
}
if (breadcrumbs?.length) {
  jsonLdList.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbs.map((b, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: b.name,
      item: new URL(b.path, Astro.site).href,
    })),
  });
}
if (article) {
  jsonLdList.push({
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: article.headline,
    description: article.description ?? description,
    datePublished: article.datePublished,
    image: [ogImageUrl],
    inLanguage: langTag,
    author: publisher,
    publisher,
    mainEntityOfPage: canonical.href,
  });
}

// hreflang: 자기 자신 포함 전부 나열 + x-default(기본 언어). 절대 URL 이어야 한다.
const alternates = translations && Object.keys(translations).length > 1 ? Object.entries(translations) : [];
const xDefault = translations?.ko;

/*
 * dev 배포(parkinon-site-dev.pages.dev)가 검색에 잡히면 본 사이트와 중복 콘텐츠가 된다.
 * 정식 도메인으로 빌드할 때만 색인을 허용한다 → PUBLIC_SITE_URL=https://parkinon.com
 */
const indexable = Astro.site?.host === 'parkinon.com';
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#2E7D32" />
    <link rel="canonical" href={canonical.href} />
    {
      alternates.map(([code, path]) => (
        <link rel="alternate" hreflang={code} href={new URL(path, Astro.site).href} />
      ))
    }
    {xDefault && alternates.length > 0 && <link rel="alternate" hreflang="x-default" href={new URL(xDefault, Astro.site).href} />}
    {!indexable && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="파킨온" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content={String(OG_W)} />
    <meta property="og:image:height" content={String(OG_H)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {jsonLdList.map((data) => <script is:inline type="application/ld+json" set:html={JSON.stringify(data)} />)}
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  /* 폰트: CDN 대신 자체 호스팅 (site/public/fonts — public/fonts 에서 복사) */
  @font-face {
    font-family: 'Pretendard';
    src: url('/fonts/Pretendard-Regular.otf') format('opentype');
    font-weight: 400;
    font-display: swap;
  }
  @font-face {
    font-family: 'Pretendard';
    src: url('/fonts/Pretendard-Bold.otf') format('opentype');
    font-weight: 700;
    font-display: swap;
  }
  @font-face {
    font-family: 'Pretendard';
    src: url('/fonts/Pretendard-Bold.otf') format('opentype');
    font-weight: 800;
    font-display: swap;
  }

  /*
   * 디자인 토큰 — 앱 실제 브랜드 컬러 재사용 (website-plan.md "디자인" 확정 사항,
   * 2026-08-03: 웹 전용 색을 새로 짓지 말 것). 스크래치패드 목업(parkinon_home_v4 등)과
   * 동일한 값 — 페이지를 이식할 때 이 파일의 토큰만 참조하면 목업과 그대로 맞는다.
   */
  :root {
    --primary: #2e7d32;
    --primary-container: #4caf50;
    --on-primary-container: #ffffff;
    --secondary: #4caf50;
    --secondary-container: #e8f5e9;
    --on-secondary-container: #2e7d32;
    --tertiary: #ff9800;
    --tertiary-dark: #8a4f00;
    --tertiary-container: #ffe9c7;
    --bg: #ffffff;
    --surface: #ffffff;
    --surface-low: #f5f5f5;
    --surface-high: #eeeeee;
    --outline: #eeeeee;
    --text: #111111;
    --text-sub: #666666;
    --font-head: 'Pretendard', 'Apple SD Gothic Neo', 'Malgun Gothic', -apple-system, sans-serif;
    --font-body: 'Pretendard', 'Apple SD Gothic Neo', 'Malgun Gothic', -apple-system, sans-serif;
    --max: 1280px;
    --gutter: 24px;
  }
  @media (max-width: 760px) {
    :root {
      --gutter: 16px;
    }
  }
  :root[data-theme='dark'] {
    --bg: #10140e;
    --surface: #171b13;
    --surface-low: #1c2117;
    --surface-high: #242a1e;
    --outline: #333a2b;
    --text: #eef1ea;
    --text-sub: #adb5a4;
    --primary: #66bb6a;
    --primary-container: #2e7d32;
    --on-primary-container: #ffffff;
    --secondary-container: #1b4332;
    --on-secondary-container: #c1ecd4;
    --tertiary-container: #4a2a0f;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) {
      --bg: #10140e;
      --surface: #171b13;
      --surface-low: #1c2117;
      --surface-high: #242a1e;
      --outline: #333a2b;
      --text: #eef1ea;
      --text-sub: #adb5a4;
      --primary: #66bb6a;
      --primary-container: #2e7d32;
      --on-primary-container: #ffffff;
      --secondary-container: #1b4332;
      --on-secondary-container: #c1ecd4;
      --tertiary-container: #4a2a0f;
    }
  }

  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: var(--font-body);
    -webkit-font-smoothing: antialiased;
  }
  h1,
  h2,
  h3,
  h4 {
    font-family: var(--font-head);
    font-weight: 800;
    margin: 0;
    text-wrap: balance;
  }
  p {
    margin: 0;
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  img {
    max-width: 100%;
    display: block;
  }
  button {
    font-family: inherit;
    cursor: pointer;
    border: none;
    background: none;
  }
  .wrap {
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }
  button:disabled,
  input:disabled {
    cursor: default;
  }

  /*
   * 페이지 셸 — 광고 세로 레일 + 본문. website-plan.md "광고 상세" 확정 사항:
   * ≥1648px 양쪽 160px 레일, 1280~1647px 우측만 300px 레일, <1280px 레일 없음(풀폭).
   * 모든 콘텐츠 페이지(허브/상세)가 공유하는 구조라 레이아웃 파일에 둔다.
   */
  .layout {
    display: flex;
    gap: 24px;
    max-width: 1648px;
    margin: 0 auto;
    padding: 0;
    align-items: flex-start;
  }
  main.col {
    flex: 1;
    min-width: 0;
    padding: 28px var(--gutter) 56px;
    max-width: 1280px;
    margin: 0 auto;
  }
  /*
   * 콘텐츠 본문 + 오른쪽 사이드 패널 그리드 — 허브·상세가 **같은 정의를 쓴다**.
   * 예전에는 허브가 전체 폭(1fr+300), 상세가 760+300 가운데 정렬이라 허브→상세로 넘어갈 때
   * 좌우 폭이 64px씩 달라졌다(오너 지적 2026-08-06). 폭이 갈라지지 않게 여기 한 군데서만 정의한다.
   * 본문은 760px 까지, 남는 폭은 사이드가 가져간다 → 오른쪽에 빈 공간이 안 남는다.
   * 사이드를 감추는 브레이크포인트는 ArticleSide 컴포넌트가 갖고 있다(1080px).
   */
  .content-body {
    display: grid;
    grid-template-columns: minmax(0, 760px) minmax(300px, 1fr);
    column-gap: 44px;
    align-items: start;
  }
  @media (max-width: 1080px) {
    .content-body {
      grid-template-columns: minmax(0, 760px);
      justify-content: center;
    }
  }
  /* 상세는 breadcrumb·article 이 왼쪽 칸에 세로로 쌓이고 사이드가 두 줄에 걸친다 */
  .detail-body {
    grid-template-rows: auto 1fr;
  }
  .detail-body > .breadcrumb {
    grid-column: 1;
    grid-row: 1;
  }
  .detail-body > article {
    grid-column: 1;
    grid-row: 2;
  }
  .detail-body > .article-side {
    grid-column: 2;
    grid-row: 1 / span 2;
  }
  .ad-rail {
    display: none;
    flex-shrink: 0;
    position: sticky;
    top: 80px;
  }
  @media (min-width: 1648px) {
    .ad-rail {
      display: block;
      width: 160px;
    }
    .layout {
      padding: 0;
    }
  }
  @media (min-width: 1280px) and (max-width: 1647px) {
    .ad-rail.right {
      display: block;
      width: 300px;
    }
  }
</style>
