---
import { getCollection } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { inLocale, inCategory, sortByDateDesc, slugOf, categoryOf, categoryLabel, formatDate } from '../../lib/articles';
import { EN_COUNTRIES, visibleIn } from '../../lib/articleCountry';

import heroImg from '../../assets/images/hero.jpg';

/*
 * 영어 앱 화면 — 미국 App Store 게재분. 한국어 홈과 장수가 다르다(6종).
 * ⚠️ 커뮤니티(정보·나눔) 화면은 넣지 않는다 — 해외 앱에는 그 탭이 아예 없다
 *   (parkinon-app/src/navigation/MainNavigator.tsx:56-58). 없는 기능을 보여주면 거짓 광고다.
 */
import shot1 from '../../assets/images/appshots/en/01_medications.png';
import shot2 from '../../assets/images/appshots/en/02_tracking.png';
import shot3 from '../../assets/images/appshots/en/03_exercise.png';
import shot4 from '../../assets/images/appshots/en/04_reminders.png';
import shot5 from '../../assets/images/appshots/en/05_add_medication.png';
import shot6 from '../../assets/images/appshots/en/06_premium.png';

import { PLAY_STORE_URL, appleStoreUrl } from '../../lib/links';
import { t, type DictKey } from '../../i18n';
const locale = Astro.currentLocale ?? 'en';

const appShots = [
  { img: shot1, cap: 'Medication records', alt: 'Parkinon app — recording your medication' },
  { img: shot2, cap: 'Body & mood records', alt: 'Parkinon app — recording body state and mood' },
  { img: shot3, cap: 'Exercise records', alt: 'Parkinon app — recording exercise' },
  { img: shot4, cap: 'Reminders & effect tracking', alt: 'Parkinon app — dose reminders and effect-tracking times' },
  { img: shot5, cap: 'Adding your medications', alt: 'Parkinon app — adding and managing medications' },
  { img: shot6, cap: 'Records & family diary', alt: 'Parkinon app — records menu and family diary' },
];

const featureList = [
  {
    emoji: '💊',
    title: 'Medication records',
    desc: "We remind you when it's time to take your medication.<br/>Check it off and the record builds itself.",
  },
  {
    emoji: '😊',
    title: 'Body & mood records',
    desc: 'Log how your body and mood feel after a dose, timed to your own medication schedule.<br/>As those records build up, they become something concrete to bring to your care team when doses are being adjusted.',
  },
  {
    emoji: '🏃',
    title: 'Exercise records',
    desc: 'Logging what you did today makes it easier to keep going.<br/>Your care partner can see how much you have been moving, too.',
  },
  {
    emoji: '👨‍👩‍👧',
    title: 'Family linking',
    desc: 'When you log something, your care partner is notified.<br/>They can see whether medication was taken and how you are feeling, so they can help without having to ask.<br/>Even living apart, they know how you are doing.',
  },
  {
    emoji: '📔',
    title: 'Family diary',
    desc: 'Leave a short note about your day, and it can later be collected into an e-book.<br/>Your care partner can write in it too, so you keep each other going.',
  },
  {
    emoji: '📋',
    title: 'Records & charts',
    desc: 'Everything you have logged, in one place.<br/>Charts turn those entries into trends you can actually see.',
  },
];

/*
 * 홈 "오늘의 파킨온 소식" — 예전엔 다섯 줄 다 손으로 지어낸 가짜 글이었다(제목도
 * href="#"도 실제로 없는 글). 오너 지시(2026-08-10: "이미 세부 메뉴들 컨텐츠 있으니까
 * 그걸로 갈아끼워야지") — 실제 글 컬렉션에서 가져온다.
 *
 * ⚠️ 메인 카드는 **무조건 소식(news) 카테고리**여야 한다 — 섹션 제목 자체가
 * "오늘의 파킨온 소식"이다. 처음엔 전체 카테고리 중 최신 글을 그냥 가져와서 제도·지원
 * 글이 메인에 뜨는 사고가 났다(오너 지적 2026-08-10: "왜 메인이 제도지원으로 바뀌었냐,
 * 소식이 메인이 되어야 하는데"). 옆 5줄은 소식이 아니어도 되니 전체 최신 글로 채운다.
 */
const allArticles = sortByDateDesc(await getCollection('articles', inLocale(locale)));
const newsArticles = sortByDateDesc(await getCollection('articles', inCategory(locale, 'news')));
const featured = newsArticles[0];

/*
 * 옆 5줄은 **접속한 나라에 맞춰** 달라진다 (오너 지시 2026-08-13).
 *   "뉴질랜드 사람인데 홈화면에 미국 정보가 나오면 안된다. 물론 전세계 공통된 정보는 괜찮다"
 *
 * 실제로 이걸 넣기 전 영어판 홈의 최신 8건이 전부 미국 제도 글이었다 — 뉴질랜드에서
 * 접속하면 자기와 상관없는 목록만 보이는 상태였다.
 *
 * 정적 사이트라 서버는 나라를 모른다. 그래서 **나라 수만큼 목록을 미리 렌더해 두고**
 * 아래 <script> 가 `/api/geo` 로 알아낸 나라의 것만 남긴다. 지오를 못 알아내면
 * 첫 번째 나라(미국) 목록이 그대로 보인다 — 자바스크립트가 꺼져 있어도 빈 화면이 되지 않는다.
 *
 * 나라를 타지 않는 글(증상·생활 요령·연구 소식)은 `visibleIn` 이 항상 통과시키므로
 * 어느 목록에나 들어간다. 그게 "전세계 공통된 정보"다.
 */
const DEFAULT_COUNTRY = EN_COUNTRIES[0].code;
const rowsByCountry = EN_COUNTRIES.map((c) => ({
  code: c.code,
  rows: allArticles.filter((e) => e.id !== featured.id && visibleIn(e, c.code)).slice(0, 5),
}));

const tagLabel = (e: (typeof allArticles)[number]) =>
  categoryOf(e) === 'news' ? e.data.tag : `${categoryLabel(locale, categoryOf(e))} · ${e.data.tag}`;

const articleHref = (e: (typeof allArticles)[number]) => getRelativeLocaleUrl(locale, `${categoryOf(e)}/${slugOf(e)}`);

/*
 * 홈 "둘러보기" — 예전엔 제도·지원/생활 요령 2개만 있었다. 지금은 5개 메뉴가 다 실제
 * 콘텐츠를 갖췄으니 전부 보여준다(순서는 헤더·푸터와 같은 src/lib/nav.ts 기준).
 * 아이콘은 기존 두 카드(제도=Feather "home", 생활=Feather "heart")와 같은 선 아이콘
 * 세트(Feather Icons, MIT)에서 골라 통일했다.
 */
/*
 * "둘러보기" 카드는 **그 언어판에 실제로 열려 있는 메뉴만** 보여야 한다.
 * 영어 메뉴는 4개다(src/lib/nav.ts 의 AVAILABLE.en) — 운동 영상만 빠진다(영상이 국내
 * 자료라 영어권에 의미가 없다). 카드를 메뉴에 없는 것까지 옮기면 404 로 이어진다.
 * ⚠️ 제도·지원은 2026-08-13 에 4개국 39편이 갖춰져 카드를 추가했다. 그전까지는
 *   한국 제도뿐이라 빼 두었는데, 메뉴는 열렸는데 카드만 없는 상태가 한동안 남아 있었다.
 */
const axisCards = [
  {
    href: getRelativeLocaleUrl(locale, 'news'),
    cat: 'News',
    desc: "Parkinson's research and treatment news, rewritten in plain language — a new piece every couple of days.",
    icon: ['M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z', 'M14 2v6h6', 'M16 13H8', 'M16 17H8'],
  },
  {
    href: getRelativeLocaleUrl(locale, 'lifestyle'),
    cat: 'Daily living',
    desc: 'Fall prevention, meals and sleep, mood, and how not to burn out as a care partner — practical information for the everyday difficulties.',
    icon: ['M12 21s-7-4.35-9.5-8.5C1 9 2.5 5.5 6 5c2-.3 3.5.8 6 3.5C14.5 5.8 16 4.7 18 5c3.5.5 5 4 3.5 7.5C19 16.65 12 21 12 21z'],
  },
  {
    href: getRelativeLocaleUrl(locale, 'clinical'),
    cat: 'Clinical Trials & Research',
    desc: 'Trials currently recruiting, by country, alongside the latest research — all in one place.',
    icon: ['M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2', 'M8 2h8v4H8z'],
  },
  {
    href: getRelativeLocaleUrl(locale, 'institutions'),
    cat: 'Benefits & support',
    // 아이콘은 기존 카드와 같은 Feather 세트(MIT)의 "home".
    desc: 'What you can claim where you live — disability payments, medicine costs, home care and equipment, country by country.',
    icon: ['M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z', 'M9 22V12h6v10'],
  },
];
---

<Layout title="Parkinon — living well with Parkinson's, day to day">
  <Header />

  <section class="hero-full" style={`background-image:url(${heroImg.src});`}>
    <div class="hero-full-inner">
      <h1>Making each day with Parkinson&rsquo;s a little easier</h1>
      <p>From medication timing to preventing falls and finding support &mdash; only the things that actually help you and your care partner.</p>
      <div class="actions">
        <a class="btn btn-primary" href={articleHref(featured)}>Read today&rsquo;s pick</a>
        <a class="btn btn-ghost-light" href={getRelativeLocaleUrl(locale, 'lifestyle')}>Browse daily living</a>
      </div>
    </div>
  </section>

  <div class="layout">
    <main class="col">
      <section>
        <div class="news-head">
          <h2>Today&rsquo;s ParkinON News</h2>
        </div>
        <div class="news-layout">
          <a class="feature-card" href={articleHref(featured)}>
            <div class="thumb">
              <Image src={featured.data.hero} alt={featured.data.heroAlt} />
              <span class="tag">{tagLabel(featured)}</span>
            </div>
            <h3>{featured.data.title}</h3>
            <p class="excerpt">{featured.data.description}</p>
            <p class="meta" id="featureDate" data-template={t(locale, 'home.todayDate' as DictKey)}></p>
          </a>
          {
            rowsByCountry.map(({ code, rows }) => (
              <div class="news-list" data-country={code} hidden={code !== DEFAULT_COUNTRY}>
                {rows.map((row) => (
                  <a class="news-row" href={articleHref(row)}>
                    <div class="thumb">
                      <Image src={row.data.thumbnail ?? row.data.hero} alt={row.data.heroAlt} />
                    </div>
                    <div>
                      <span class:list={['tag', { alt: categoryOf(row) === 'news' }]}>{tagLabel(row)}</span>
                      <h4>{row.data.title}</h4>
                    </div>
                  </a>
                ))}
              </div>
            ))
          }
        </div>
      </section>

      <section>
        <div class="axes-head">
          <h2>Browse</h2>
        </div>
        <div class="axes-grid">
          {
            axisCards.map((c) => (
              <a class="axis-card" href={c.href}>
                <div class="axis-ic">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    {c.icon.map((d) => <path d={d} />)}
                  </svg>
                </div>
                <div>
                  <div class="cat">{c.cat}</div>
                  <p class="desc">{c.desc}</p>
                  <div class="go">See more &rarr;</div>
                </div>
              </a>
            ))
          }
        </div>
      </section>

      <section class="cta">
        <div class="cta-text">
          <h2>Manage it anywhere, with the Parkinon app</h2>
          <p>Daily records and reminders, in your hand. Large type and a plain, uncluttered design, so it stays easy to use.</p>
          <div class="store-badges">
            <a class="store-badge" href={PLAY_STORE_URL} target="_blank" rel="noopener">
              <svg class="icon" viewBox="0 0 24 24" fill="#fff"><polygon points="5,3 5,21 20,12"></polygon></svg>
              <span class="big">Google Play</span>
            </a>
            <a class="store-badge" href={appleStoreUrl(locale)} target="_blank" rel="noopener">
              <svg class="icon" viewBox="0 0 384 512" fill="#fff"
                ><path
                  d="M318 268c-1-56 46-83 48-84-26-38-67-43-81-44-34-3-67 20-84 20-18 0-44-20-73-19-37 1-72 22-91 55-39 68-10 168 28 223 19 27 41 57 71 56 28-1 39-18 74-18 34 0 45 18 74 18 31-1 50-27 69-54 22-31 31-61 31-63-1 0-59-23-60-90zM258 63c16-19 27-46 24-73-23 1-51 15-68 34-15 17-28 44-25 70 26 2 53-13 69-31z"
                ></path></svg
              >
              <span class="big">App Store</span>
            </a>
          </div>
          <div class="feature-list">
            {
              featureList.map((f) => (
                <div>
                  <div class="f-head">
                    <span class="f-emoji">{f.emoji}</span>
                    <b>{f.title}</b>
                  </div>
                  <p class="f-desc" set:html={f.desc} />
                </div>
              ))
            }
          </div>
          <button type="button" class="app-preview-toggle" id="appPreviewToggle" aria-expanded="false" aria-controls="appPreviewPanel">
            <span>See app screens</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"></path></svg>
          </button>
          <div class="app-preview-panel" id="appPreviewPanel">
            <div class="app-shots">
              {
                appShots.map((s) => (
                  <div class="shot">
                    <div class="shot-cap">{s.cap}</div>
                    <Image src={s.img} alt={s.alt} />
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </section>
    </main>
  </div>

  <Footer />
</Layout>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border-radius: 8px;
    padding: 0 22px;
    font-weight: 800;
    font-size: 14px;
    white-space: nowrap;
    height: 42px;
    transition: opacity 0.15s;
  }
  .btn:hover {
    opacity: 0.88;
  }
  .btn-primary {
    background: var(--primary);
    color: #fff;
  }
  .btn-ghost-light {
    background: rgba(255, 255, 255, 0.16);
    color: #fff;
    border: 1.5px solid rgba(255, 255, 255, 0.55);
  }

  .hero-full {
    position: relative;
    width: 100%;
    min-height: 460px;
    display: flex;
    align-items: flex-end;
    background-size: cover;
    background-position: center;
    background-color: var(--surface-low);
  }
  .hero-full::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(10, 20, 12, 0.78), rgba(10, 20, 12, 0.15) 55%, rgba(10, 20, 12, 0) 80%);
  }
  .hero-full-inner {
    position: relative;
    z-index: 1;
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 var(--gutter) 52px;
    width: 100%;
    box-sizing: border-box;
  }
  .hero-full-inner h1 {
    font-size: 42px;
    font-weight: 800;
    color: #fff;
    line-height: 1.22;
    letter-spacing: -0.015em;
    max-width: 16ch;
  }
  .hero-full-inner p {
    margin-top: 16px;
    font-size: 16px;
    color: rgba(255, 255, 255, 0.92);
    max-width: 46ch;
    line-height: 1.65;
  }
  .hero-full-inner .actions {
    display: flex;
    gap: 10px;
    margin-top: 24px;
    flex-wrap: wrap;
  }
  .hero-full-inner .actions .btn {
    height: 46px;
    padding: 0 24px;
  }
  @media (max-width: 640px) {
    .hero-full {
      min-height: 400px;
    }
    .hero-full-inner h1 {
      font-size: 30px;
      max-width: 14ch;
    }
  }

  .news-head {
    margin-bottom: 20px;
  }
  .news-head h2 {
    font-size: 24px;
    color: var(--text);
  }
  .news-layout {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 28px;
    margin-bottom: 56px;
  }
  @media (max-width: 900px) {
    .news-layout {
      grid-template-columns: 1fr;
    }
  }

  .feature-card {
    display: block;
  }
  .feature-card :global(.thumb) {
    position: relative;
    border-radius: 8px;
    overflow: hidden;
    aspect-ratio: 16 / 10;
  }
  .feature-card :global(.thumb img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .feature-card .tag {
    position: absolute;
    top: 14px;
    left: 14px;
    background: #fff;
    color: var(--tertiary-dark);
    font-size: 11.5px;
    font-weight: 800;
    padding: 5px 12px;
    border-radius: 4px;
    letter-spacing: 0.02em;
  }
  .feature-card h3 {
    font-size: 24px;
    margin-top: 16px;
    color: var(--text);
    line-height: 1.4;
    letter-spacing: -0.005em;
  }
  .feature-card .excerpt {
    margin-top: 8px;
    font-size: 14.5px;
    color: var(--text-sub);
    line-height: 1.65;
    max-width: 56ch;
  }
  .feature-card .meta {
    margin-top: 12px;
    font-size: 12.5px;
    color: var(--text-sub);
    opacity: 0.8;
  }
  .news-list[hidden] {
    display: none;
  }
  .news-list {
    display: flex;
    flex-direction: column;
  }
  .news-row {
    display: grid;
    grid-template-columns: 104px 1fr;
    gap: 16px;
    padding: 16px 0;
    border-bottom: 1px solid var(--outline);
  }
  .news-row:first-child {
    padding-top: 0;
  }
  .news-row:last-child {
    border-bottom: none;
  }
  .news-row :global(.thumb) {
    width: 104px;
    height: 78px;
    border-radius: 6px;
    overflow: hidden;
    flex-shrink: 0;
  }
  .news-row :global(.thumb img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .news-row .tag {
    font-size: 11px;
    font-weight: 800;
    color: var(--tertiary-dark);
    display: block;
    margin-bottom: 6px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .news-row h4 {
    font-size: 15px;
    line-height: 1.4;
    color: var(--text);
  }

  .axes-head {
    margin-bottom: 18px;
  }
  .axes-head h2 {
    font-size: 24px;
    color: var(--text);
  }
  .axes-grid {
    display: grid;
    /* 5개 카드라 2열은 마지막 줄이 1개만 남아 비대칭이 된다(2026-08-10, 5개로 늘어남) —
       3열로 3+2 로 나눠 덜 어색하게 한다. */
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-bottom: 56px;
  }
  @media (max-width: 1000px) {
    .axes-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 640px) {
    .axes-grid {
      grid-template-columns: 1fr;
    }
  }
  .axis-card {
    background: var(--surface);
    border: 1px solid var(--outline);
    border-radius: 8px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    transition: border-color 0.15s ease;
  }
  .axis-card:hover {
    border-color: var(--primary);
  }
  .axis-ic {
    width: 26px;
    height: 26px;
    flex-shrink: 0;
    color: var(--primary);
  }
  .axis-ic svg {
    width: 100%;
    height: 100%;
  }
  .axis-card .cat {
    font-size: 16.5px;
    font-weight: 700;
    color: var(--text);
    line-height: 1.4;
    margin-top: 16px;
  }
  .axis-card .desc {
    font-size: 13.5px;
    color: var(--text-sub);
    line-height: 1.6;
    margin-top: 8px;
  }
  .axis-card .go {
    font-size: 12.5px;
    font-weight: 700;
    color: var(--primary);
    margin-top: 16px;
  }

  @media (max-width: 760px) {
    .news-layout {
      margin-bottom: 64px;
    }
    .axes-grid {
      margin-bottom: 64px;
    }
  }

  .cta {
    padding: 12px 0 8px;
  }
  .cta h2 {
    font-size: 26px;
    color: var(--text);
    line-height: 1.3;
  }
  .cta p {
    margin-top: 12px;
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-sub);
  }
  .store-badges {
    display: flex;
    gap: 12px;
    margin-top: 22px;
