---
import { getCollection } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import ArticleSide from '../../../components/ArticleSide.astro';
import { slugOf, formatDate, sortByDateDesc, inCategory } from '../../../lib/articles';
import { EN_COUNTRIES, countryOf, assertAllCountried } from '../../../lib/articleCountry';
import { t, type DictKey } from '../../../i18n';
import familyImg from '../../../assets/images/family.jpg';
import AdBanner from '../../../components/article/AdBanner.astro';

const locale = Astro.currentLocale ?? 'en';

/*
 * 목록은 **글 파일에서 자동으로** 만든다. 손으로 배열을 적지 말 것 —
 * 예전에는 글을 하나 추가할 때 글 페이지·허브 목록·사이드 패널 세 군데를 고쳐야 했고,
 * 하나만 빠뜨려도 링크가 죽었다. (website-plan.md "글 저장 방식과 발행 흐름")
 */
const posts = sortByDateDesc(
  await getCollection('articles', inCategory(locale, 'institutions'))
);

/* 나라를 못 가려낸 글이 있으면 여기서 빌드가 멈춘다 — 조용히 어느 탭에도 안 나오는 것보다 낫다. */
assertAllCountried(posts);

/*
 * 국가 탭 (오너 지시 2026-08-13). **"전체" 탭은 두지 않는다** —
 *   "어짜피 미국 사람이 뉴질랜드 제도 볼 일이 없을테니"
 * 서버는 첫 번째 나라(미국)를 선택한 상태로 렌더하고, 접속 국가에 맞춰 **맨 앞으로 옮기고
 * 선택**하는 것은 아래 <script> 가 한다(임상시험 페이지와 같은 방식, `/api/geo`).
 * 자바스크립트가 없거나 지오를 못 알아내도 미국 탭이 열린 채로 정상 동작한다.
 */
const DEFAULT_COUNTRY = EN_COUNTRIES[0].code;
const countryTabs = EN_COUNTRIES.map((c) => ({
  code: c.code,
  label: t(locale, c.labelKey as DictKey),
  count: posts.filter((p) => countryOf(p) === c.code).length,
}));

/* 옆 패널도 기본 나라 것만 — 미국 사용자에게 뉴질랜드 글을 권하지 않는다. */
const sideLinks = posts
  .filter((e) => countryOf(e) === DEFAULT_COUNTRY)
  .slice(0, 6)
  .map((e) => ({
    title: e.data.title,
    date: formatDate(e.data.publishedAt),
    href: getRelativeLocaleUrl(locale, `institutions/${slugOf(e)}`),
  }));

---

<Layout
  title="Benefits & support — ParkinON"
  breadcrumbs={[
    { name: 'Home', path: '/en/' },
    { name: 'Benefits & support', path: '/en/institutions/' },
  ]}
>
  <Header active="institutions" />

  <div class="layout">
    <main class="col">
      <section class="hub-hero-full" style={`background-image:url(${familyImg.src});`}>
        <div class="hub-hero-full-inner">
          <h1>Benefits &amp; support</h1>
          <p>
            The national programmes people with Parkinson&rsquo;s can apply for, country by country &mdash;
            what you qualify for, what you get, and how to apply. Every page states the date its figures
            were checked, because these programmes change each year.
          </p>
        </div>
      </section>

      <nav class="breadcrumb">
        <a href={getRelativeLocaleUrl(locale, '')}>Home</a><span class="sep">/</span><span>Benefits &amp; support</span>
      </nav>

      {/*
       * 태그 필터탭은 두지 않는다(오너 지적 2026-08-09: "태그마다 글이 1개씩인데 나누는 이유가
       * 뭐냐"). 대신 **나라**로 가른다 — 나라마다 글이 6~13편씩 쌓여서 거를 것이 생겼고,
       * 다른 나라 제도는 읽을 이유가 없다.
       */}
      <nav class="hub-tabs" id="countryTabs" aria-label="Country">
        {
          countryTabs.map((c) => (
            <button
              class:list={['tab', { active: c.code === DEFAULT_COUNTRY }]}
              data-country={c.code}
              aria-pressed={c.code === DEFAULT_COUNTRY ? 'true' : 'false'}
            >
              {c.label} <span class="n">{c.count}</span>
            </button>
          ))
        }
      </nav>

      <div class="ad-slot-mobile">
        <AdBanner size="rect" />
      </div>
      <div class="ad-slot-pc">
        <AdBanner size="leaderboard" />
      </div>

      <div class="content-body">
        <div class="hub-list" id="hubList">
          {
            posts.map((post) => (
              <a
                class="hub-row"
                data-country={countryOf(post)}
                hidden={countryOf(post) !== DEFAULT_COUNTRY}
                href={getRelativeLocaleUrl(locale, `institutions/${slugOf(post)}`)}
              >
                <span class="tag">{post.data.tag}</span>
                <h3>{post.data.title}</h3>
                <p>{post.data.description}</p>
                <div class="hashtags">
                  {post.data.hashtags.map((h) => <span>{h}</span>)}
                </div>
                <p class="meta">{formatDate(post.data.publishedAt)}</p>
              </a>
            ))
          }
        </div>

        <ArticleSide links={sideLinks} linksTitle="More in Benefits & support" />
      </div>

    </main>

    <aside class="ad-rail right">
      <AdBanner size="skyscraper" />
    </aside>
  </div>

  <Footer />
</Layout>

<style>
  .breadcrumb {
    font-size: 13px;
    color: var(--text-sub);
    margin-bottom: 18px;
  }
  .breadcrumb a:hover {
    color: var(--primary);
  }
  .breadcrumb .sep {
    margin: 0 6px;
    opacity: 0.6;
  }

  /* 탭은 생활 요령 허브와 같은 모양이다 — 같은 허브인데 다르게 보이면 안 된다. */
  .hub-tabs {
    display: flex;
    flex-wrap: nowrap;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    gap: 22px;
    margin: 22px 0 30px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--outline);
  }
  .hub-tabs::-webkit-scrollbar {
    display: none;
  }
  .tab {
    flex-shrink: 0;
    position: relative;
    font: inherit;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    font-size: 15.5px;
    font-weight: 700;
    color: var(--text-sub);
    white-space: nowrap;
  }
  .tab.active {
    color: var(--primary);
  }
  .tab.active::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -17px;
    height: 2px;
    background: var(--primary);
  }
  .tab .n {
    font-size: 12px;
    font-weight: 700;
    opacity: 0.65;
    margin-left: 2px;
  }

  .hub-list {
    display: flex;
    flex-direction: column;
  }
  .hub-row {
    display: block;
    padding: 24px 0;
    border-bottom: 1px solid var(--outline);
  }
  .hub-row[hidden] {
    display: none;
  }
  /*
   * 위쪽 여백은 **보이는 첫 줄**에서만 없앤다. CSS 로는 "앞에 보이는 형제가 없는 요소"를
   * 고를 수 없어서(:first-child 는 숨김 여부를 보지 않는다) 스크립트가 .is-first 를 붙인다.
   * 이걸 안 하면 탭을 바꿀 때마다 목록 맨 위 여백이 들쭉날쭉해진다.
   */
  .hub-row.is-first {
    padding-top: 0;
  }
  .hub-row .tag {
    font-size: 11px;
    font-weight: 800;
    color: var(--primary);
    display: block;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .hub-row h3 {
    font-size: 18.5px;
    margin-top: 10px;
    color: var(--text);
    line-height: 1.4;
  }
  .hub-row p {
    margin-top: 6px;
    font-size: 14px;
    line-height: 1.65;
    color: var(--text-sub);
    max-width: 70ch;
  }
  .hub-row .meta {
    margin-top: 10px;
    font-size: 12px;
    color: var(--text-sub);
    opacity: 0.75;
  }
  /*
   * flex-wrap 이어야 한다 — `{tags.map(h => <span>{h}</span>)}` 는 태그 사이에 **공백을
   * 하나도 안 낳는다.** inline 으로 두면 브라우저가 끊을 자리가 없어 태그 전부가 한 덩어리가
   * 되고, 그 덩어리 길이가 그대로 문서 폭이 된다(2026-09-02 실측: 320px 화면에서
   * 스페인어 `#DesarrolloDeMedicamentos` 때문에 375px, 프랑스어도 같은 길이다.
   * 한국어·일본어는 태그가 짧아 우연히 안 걸렸을 뿐이다).
   */
  .hashtags {
    margin-top: 8px;
    font-size: 12px;
    color: var(--primary);
    display: flex;
    flex-wrap: wrap;
    column-gap: 7px;
    row-gap: 2px;
  }
  .hub-more {
    display: flex;
    justify-content: center;
    margin-top: 36px;
  }
  .hub-more .btn {
    height: 48px;
    padding: 0 28px;
    background: var(--surface-low);
    color: var(--text);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    font-weight: 800;
    font-size: 14px;
  }
</style>


<script>
  /*
   * 국가 탭 (오너 지시 2026-08-13).
   *   "사용자가 접속한 국가 기준으로 탭이 앞에 나오고 선택되게 해라.
   *    어짜피 미국 사람이 뉴질랜드 제도 볼 일이 없을테니"
   *
   * 서버는 미국 탭을 선택한 채로 렌더한다. 여기서 두 가지를 한다.
   *   1) 탭 클릭 → 그 나라 글만 보인다
   *   2) `/api/geo`(Cloudflare CF-IPCountry, 쿠키 없음)로 접속 국가를 알아내
   *      **그 탭을 맨 앞으로 옮기고 선택**한다
   *
   * 못 알아내거나 우리가 다루지 않는 나라면 아무것도 하지 않는다 — 미국 탭이 열린 채로
   * 정상 동작한다. 자바스크립트가 꺼져 있어도 마찬가지다(글이 사라지지 않는다).
   */
  const tabsEl = document.getElementById('countryTabs');
  const listEl = document.getElementById('hubList');
  if (tabsEl && listEl) {
    const tabs = Array.from(tabsEl.querySelectorAll<HTMLButtonElement>('.tab'));
    const rows = Array.from(listEl.querySelectorAll<HTMLAnchorElement>('.hub-row'));

    const show = (code: string) => {
      tabs.forEach((t) => {
        const on = t.dataset.country === code;
        t.classList.toggle('active', on);
        t.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
      let first = true;
      rows.forEach((r) => {
        const on = r.dataset.country === code;
        r.hidden = !on;
        // 보이는 첫 줄에만 위 여백을 없앤다(CSS 로는 고를 수 없다 — style 주석 참고).
        r.classList.toggle('is-first', on && first);
        if (on) first = false;
      });
    };

    tabs.forEach((t) => t.addEventListener('click', () => show(t.dataset.country!)));
    show(tabs.find((t) => t.classList.contains('active'))?.dataset.country ?? tabs[0].dataset.country!);

    (async () => {
      try {
        const res = await fetch('/api/geo');
        const { country } = (await res.json()) as { country: string | null };
        const code = country?.toLowerCase();
        const tab = tabs.find((t) => t.dataset.country === code);
        if (!tab) return; // 모르는 나라 → 기본값 유지
        tabsEl.prepend(tab); // 자기 나라를 맨 앞으로
        show(tab.dataset.country!);
      } catch {
        /* 지오를 못 부르면 기본값 그대로 둔다 */
      }
    })();
  }
</script>
