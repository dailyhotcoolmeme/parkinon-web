{/*
  ⚠️ 날짜·토글 문구는 절대 여기서 새로 짓지 않는다 — 서버가 t()로 미리 번역해 data-*
  속성에 심어둔 템플릿을 그대로 갖다 쓴다(2026-08-08 오너 전수조사 지시로, 예전엔
  "~월 ~일의 추천"/"오늘 · ..."/"접기" 가 여기 한글로 직접 박혀 있었다 — src/pages는
  check-i18n.mjs 검사에서 빠져 있어서 안 잡혔었고, 지금은 <script> 블록도 검사한다). */}
<script>
  const today = new Date();
  const pad = (n: number) => (n < 10 ? '0' + n : '' + n);

  const featureDateEl = document.getElementById('featureDate')!;
  featureDateEl.textContent = (featureDateEl.dataset.template ?? '')
    .replace('{y}', String(today.getFullYear()))
    .replace('{m}', pad(today.getMonth() + 1))
    .replace('{d}', pad(today.getDate()));

  const appPreviewToggle = document.getElementById('appPreviewToggle')!;
  const appPreviewPanel = document.getElementById('appPreviewPanel')!;
  appPreviewToggle.addEventListener('click', () => {
    const open = appPreviewPanel.classList.toggle('open');
    appPreviewToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
  });
</script>
