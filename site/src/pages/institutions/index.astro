---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import AdBox from '../../components/AdBox.astro';
import ArticleSide from '../../components/ArticleSide.astro';
import familyImg from '../../assets/images/family.jpg';

interface PostRow {
  ad?: false;
  tag: string;
  title: string;
  excerpt: string;
  hashtags: string[];
  date: string;
  href?: string;
}
interface AdRow {
  ad: true;
}
type Row = PostRow | AdRow;

const tabs = ['전체', '산정특례', '장애등록', '장기요양', '의료비 공제', '보조기기'];

const rows: Row[] = [
  {
    tag: '산정특례',
    title: '파킨슨병 산정특례, 신청 자격과 혜택 총정리',
    excerpt: '진단서와 함께 신청하면 본인부담률이 크게 낮아집니다. 대상 기준과 신청 시 챙겨야 할 서류를 정리했습니다.',
    hashtags: ['#산정특례', '#건강보험', '#본인부담률'],
    date: '2026.07.28',
    href: '/institutions/copayment-reduction-guide',
  },
  {
    tag: '장애등록',
    title: '장애등록 절차와 준비 서류 한눈에 보기',
    excerpt: '진단 후 언제부터 등록할 수 있는지, 어느 병원에서 진단서를 받아야 하는지부터 순서대로 안내합니다.',
    hashtags: ['#장애등록', '#장애인등록', '#서류'],
    date: '2026.07.25',
  },
  {
    tag: '장기요양',
    title: '장기요양보험 등급 신청, 어떻게 시작하나요',
    excerpt: '공단 방문조사부터 등급 판정까지 걸리는 기간과, 등급별로 받을 수 있는 서비스를 비교했습니다.',
    hashtags: ['#장기요양보험', '#등급신청', '#방문조사'],
    date: '2026.07.22',
  },
  {
    tag: '의료비 공제',
    title: '파킨슨병 치료비 세금공제 놓치지 않는 법',
    excerpt: '연말정산에서 놓치기 쉬운 의료비 세액공제 항목과, 미리 챙겨두면 좋은 영수증 종류를 정리했습니다.',
    hashtags: ['#의료비공제', '#연말정산', '#세액공제'],
    date: '2026.07.19',
  },
  { ad: true },
  {
    tag: '보조기기',
    title: '보조기기 지원사업, 어떤 걸 받을 수 있나요',
    excerpt: '보행보조기, 욕실 안전용품 등 지원 품목과 본인부담금, 신청 기관을 정리했습니다.',
    hashtags: ['#보조기기', '#지원사업', '#낙상예방'],
    date: '2026.07.16',
  },
  {
    tag: '산정특례',
    title: '산정특례 갱신 시기와 재신청 방법',
    excerpt: '적용 기간이 끝나기 전에 챙겨야 할 재등록 절차와, 놓쳤을 때 대처하는 방법을 안내합니다.',
    hashtags: ['#산정특례', '#갱신', '#재신청'],
    date: '2026.07.12',
  },
  {
    tag: '장애등록',
    title: '장애등록증으로 받을 수 있는 교통·통신 혜택',
    excerpt: '지하철·버스 할인부터 통신요금 감면까지, 등록증 하나로 받을 수 있는 생활 혜택을 모았습니다.',
    hashtags: ['#장애등록증', '#교통할인', '#통신요금감면'],
    date: '2026.07.09',
  },
  {
    tag: '장기요양',
    title: '요양보호사 방문 서비스 신청 가이드',
    excerpt: '등급 판정 이후 실제로 방문 요양 서비스를 시작하기까지의 절차를 순서대로 정리했습니다.',
    hashtags: ['#장기요양', '#요양보호사', '#방문요양'],
    date: '2026.07.05',
  },
  { ad: true },
  {
    tag: '의료비 공제',
    title: '본인부담상한제, 환급까지 받는 절차',
    excerpt: '1년간 낸 의료비가 기준을 넘으면 초과분을 돌려받을 수 있습니다. 신청 시기와 방법을 안내합니다.',
    hashtags: ['#본인부담상한제', '#환급', '#의료비'],
    date: '2026.07.02',
  },
  {
    tag: '보조기기',
    title: '보행보조기·욕실 안전용품 지원 신청',
    excerpt: '낙상 위험을 줄이는 보조기기 품목별 지원 한도와, 실제 신청 후기를 바탕으로 한 팁을 담았습니다.',
    hashtags: ['#보행보조기', '#욕실안전', '#낙상예방'],
    date: '2026.06.28',
  },
  {
    tag: '산정특례',
    title: '산정특례 대상 질환 코드 확인하는 법',
    excerpt: '진단서에 적힌 상병코드가 산정특례 대상인지 스스로 확인하는 방법을 정리했습니다.',
    hashtags: ['#산정특례', '#상병코드'],
    date: '2026.06.24',
  },
];

const sideLinks = rows.filter((r): r is PostRow => !r.ad).slice(0, 6);
---

<Layout title="제도·지원 — 파킨온">
  <Header active="institutions" />

  <div class="layout">
    <aside class="ad-rail left">
      <AdBox minHeight="600px" />
    </aside>

    <main class="col">
      <section class="hub-hero-full" style={`background-image:url(${familyImg.src});`}>
        <div class="hub-hero-full-inner">
          <h1>제도·지원</h1>
          <p>
            파킨슨병 환자와 가족이 받을 수 있는 국가 지원 제도를 정리했습니다. 산정특례부터 장애등록, 장기요양등급,
            의료비 세금공제, 보조기기 지원까지 — 신청 자격과 절차를 확인하세요.
          </p>
        </div>
      </section>

      <nav class="breadcrumb">
        <a href="/">홈</a><span class="sep">/</span><span>제도·지원</span>
      </nav>

      <div class="hub-tabs">
        {tabs.map((t, i) => <a class:list={['tab', { active: i === 0 }]} href="#">{t}</a>)}
      </div>

      <div class="content-body">
        <div class="hub-list">
          {
            rows.map((row) =>
              row.ad ? (
                <div class="native-ad-row">
                  <span class="ad-label">광고</span>
                  <AdBox minHeight="90px" />
                </div>
              ) : (
                <a class="hub-row" href={row.href ?? '#'}>
                  <span class="tag">{row.tag}</span>
                  <h3>{row.title}</h3>
                  <p>{row.excerpt}</p>
                  <div class="hashtags">
                    {row.hashtags.map((h) => <span>{h}</span>)}
                  </div>
                  <p class="meta">{row.date}</p>
                </a>
              )
            )
          }
        </div>

        <ArticleSide links={sideLinks} linksTitle="제도·지원 다른 글" />
      </div>

      <div class="hub-more">
        <button class="btn">글 더 보기</button>
      </div>
    </main>

    <aside class="ad-rail right">
      <AdBox minHeight="600px" />
    </aside>
  </div>

  <Footer />
</Layout>

<style>
  .breadcrumb {
    font-size: 13px;
    color: var(--text-sub);
    margin-bottom: 18px;
  }
  .breadcrumb a:hover {
    color: var(--primary);
  }
  .breadcrumb .sep {
    margin: 0 6px;
    opacity: 0.6;
  }
  .hub-hero-full {
    position: relative;
    width: auto;
    margin: -28px calc(-1 * var(--gutter)) 24px;
    min-height: 240px;
    display: flex;
    /*
     * 위쪽 정렬 + 고정 padding-top 으로 제목 시작 위치를 못박는다(오너 지적 2026-08-06).
     * 아래쪽 정렬이면 설명이 몇 줄이냐에 따라 제목이 24px 씩 위아래로 움직여서
     * 허브 3개의 제목 높이가 서로 안 맞는다(제도·지원만 3줄이라 혼자 올라가 있었다).
     * 114px = 기존 2줄 화면의 제목 위치 그대로. 설명이 길어지면 아래로 늘어난다.
     */
    align-items: flex-start;
    background-size: cover;
    background-position: center;
    background-color: var(--surface-low);
  }
  .hub-hero-full::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(10, 20, 12, 0.75), rgba(10, 20, 12, 0.12) 60%, rgba(10, 20, 12, 0) 85%);
  }
  .hub-hero-full-inner {
    position: relative;
    z-index: 1;
    padding: 114px var(--gutter) 28px;
    width: 100%;
    box-sizing: border-box;
  }
  .hub-hero-full-inner h1 {
    font-size: 32px;
    font-weight: 800;
    color: #fff;
    line-height: 1.25;
  }
  .hub-hero-full-inner p {
    margin-top: 10px;
    font-size: 15px;
    color: rgba(255, 255, 255, 0.92);
    /*
     * 폭·최소높이는 허브 3개의 제목 시작 위치를 맞추려고 정한 값이다(오너 지적 2026-08-06).
     * 히어로는 아래쪽 정렬이라 설명이 3줄이 되면 제목만 24px 위로 올라간다.
     * 실측: 최대폭 560~719px 구간에서 세 페이지 설명이 모두 2줄 → 가운데값 640px 채택.
     * (500px 이면 제도·지원만 3줄, 720px 이면 생활 요령만 1줄이 되어 다시 어긋난다.)
     * min-height 는 앞으로 짧은 문구가 들어와도 2줄 자리를 유지시키는 안전장치.
     */
    max-width: 640px;
    min-height: 48px;
    line-height: 1.6;
  }
  @media (max-width: 640px) {
    .hub-hero-full {
      min-height: 200px;
    }
    /* 모바일도 같은 이유로 고정. 58px = 기존 3줄 화면의 제목 위치 그대로 */
    .hub-hero-full-inner {
      padding-top: 58px;
    }
    .hub-hero-full-inner h1 {
      font-size: 26px;
    }
  }
  .hub-tabs {
    display: flex;
    gap: 6px;
    overflow-x: auto;
    border-bottom: 1px solid var(--outline);
    margin-bottom: 32px;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .hub-tabs::-webkit-scrollbar {
    display: none;
  }
  .tab {
    flex: 0 0 auto;
    font-size: 15px;
    font-weight: 700;
    color: var(--text-sub);
    padding: 12px 14px;
    border-bottom: 2.5px solid transparent;
    white-space: nowrap;
  }
  .tab.active {
    color: var(--primary);
    border-color: var(--primary);
  }
  .hub-list {
    display: flex;
    flex-direction: column;
  }
  .hub-row {
    display: block;
    padding: 24px 0;
    border-bottom: 1px solid var(--outline);
  }
  .hub-row:first-child {
    padding-top: 0;
  }
  .hub-row .tag {
    font-size: 11px;
    font-weight: 800;
    color: var(--primary);
    display: block;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .hub-row h3 {
    font-size: 18.5px;
    margin-top: 10px;
    color: var(--text);
    line-height: 1.4;
  }
  .hub-row p {
    margin-top: 6px;
    font-size: 14px;
    line-height: 1.65;
    color: var(--text-sub);
    max-width: 70ch;
  }
  .hub-row .meta {
    margin-top: 10px;
    font-size: 12px;
    color: var(--text-sub);
    opacity: 0.75;
  }
  .hashtags {
    margin-top: 8px;
    font-size: 12px;
    color: var(--text-sub);
    opacity: 0.7;
  }
  .hashtags span {
    margin-right: 7px;
  }
  .native-ad-row {
    padding: 24px 0;
    border-bottom: 1px solid var(--outline);
  }
  .native-ad-row .ad-label {
    font-size: 11px;
    font-weight: 800;
    color: var(--text-sub);
    background: var(--surface-high);
    padding: 3px 11px;
    border-radius: 4px;
    display: inline-block;
    margin-bottom: 10px;
  }
  .hub-more {
    display: flex;
    justify-content: center;
    margin-top: 36px;
  }
  .hub-more .btn {
    height: 48px;
    padding: 0 28px;
    background: var(--surface-low);
    color: var(--text);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    font-weight: 800;
    font-size: 14px;
  }
</style>
