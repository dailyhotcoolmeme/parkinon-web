---
/*
 * 임상시험 허브 (할 일 0-6, 2026-08-08 시작 → 2026-08-08 Supabase 전환).
 *
 * 데이터는 Supabase(`clinical_trials`류, `research_papers`류) — **빌드 타임에 한 번만** 읽는다
 * (런타임 호출 없음, 정적 페이지). 원문은 ClinicalTrials.gov·PubMed API를 직접 부르지 않는다 —
 * `scripts/crawl-trials.mjs`/`scripts/crawl-pubmed.mjs`(매일 도는 깃허브 액션)가 미리 받아서
 * Supabase에 채워둔다. 오염 제거·저널 축약명 함정·국가 태깅 로직은 그 두 스크립트에 있다.
 * 여기서는 이미 정리된 데이터를 읽어서 화면에 그리기만 한다.
 *
 * 기본은 "전체"를 보여주고, 국가 버튼으로 특정 나라만 볼 수 있게 한다. 국가 목록은 제도
 * 1급 7개국과 같다.
 *
 * ⚠️ 사실 항목만 정형화하고 해석하지 않는다(계획서 "신설 축도 의학 정보는 다루지 않는다
 * 안에 있다"). 제목·상·주관·위치·연락처·원문 링크만 보여준다. "이 시험이 좋다/맞다"는
 * 말은 하지 않는다.
 */
import { getRelativeLocaleUrl } from 'astro:i18n';
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import AdBox from '../../../components/AdBox.astro';
import labImg from '../../../assets/images/lab.jpg';
import Tr from '../../../i18n/Tr.astro';
import { t, tv, type DictKey } from '../../../i18n';
import { fetchAllRecruitingTrials, trialsForCountry, trialsForAll, TRIAL_COUNTRIES } from '../../../lib/clinicalTrials';
import { fetchResearchPapersForCountry, fetchResearchPapers } from '../../../lib/pubmed';

const locale = Astro.currentLocale ?? 'ko';

/*
 * 임상 단계 물음표 팝오버의 "자세히 알아보기" 링크.
 * 항목마다 페이지를 따로 파지 않는다는 정책(website-plan.md "용어 설명" 절)에 따라
 * 독립 페이지가 아니라 생활 요령의 **모아보는 글 한 편**
 * (`src/content/articles/ko/lifestyle/glossary.mdx`)안의 그 항목으로 anchor 링크한다.
 * ⚠️ 앵커 id는 Astro가 그 글의 h2 텍스트로 자동 생성한 것이다 — 그 글의 해당 제목을
 * 바꾸면 이 문자열도 같이 고쳐야 한다.
 */
const phaseGlossaryUrl = getRelativeLocaleUrl(locale, 'lifestyle/glossary') + '#임상시험-1상2상3상-무슨-뜻인가요';

/*
 * 기본 국가 = "전체"(오너 확정 2026-08-08: "한국이 메인이 아니다" — 여러 번 반복된 지적).
 * 방문자 위치를 알아내면(아래 지오로케이션 스크립트) 그 나라로 바꾸고, 못 알아내거나
 * 목록에 없는 나라면 "전체"에 그대로 둔다. ⚠️ "전체" 옵션이 없는 다른 화면을 만들 때는
 * 한국을 기본값으로 두지 말고 미국을 기본값으로 할 것 — 같은 원칙이 이미 여러 번 얘기됐다.
 */
const defaultCountry = 'all';

/*
 * Supabase 조회라 NCBI 비인증 요청 한도(3건/초, ClinicalTrials.gov 직접 호출 시절에 429를
 * 겪었던 문제)와 무관하다 — 전부 Promise.all 로 동시에 부른다.
 */
const allTrials = await fetchAllRecruitingTrials(locale);
const countryEntries = await Promise.all(
  TRIAL_COUNTRIES.map(async (c) => ({
    ...c,
    label: t(locale, `country.${c.code}` as DictKey),
    data: trialsForCountry(allTrials, c.apiName),
    research: await fetchResearchPapersForCountry(c.code, locale),
  }))
);

/*
 * 나라 순서(오너 확정 2026-08-08): "전체"는 항상 맨 앞, 그 뒤로는 임상시험+연구 건수가
 * 많은 나라부터. "접속한 사람의 국가를 맨 앞에" 부분은 방문자 위치를 알아내는 별도
 * 기술(Cloudflare 지오로케이션, `functions/api/geo.js`)로 클라이언트에서 처리한다
 * (아래 <script> 참고) — 여기 서버 쪽 정렬은 건수 기준까지만.
 */
countryEntries.sort((a, b) => b.data.total + b.research.total - (a.data.total + a.research.total));

const allEntry = {
  code: 'all' as const,
  apiName: '',
  label: t(locale, 'country.all' as DictKey),
  data: trialsForAll(allTrials),
  research: await fetchResearchPapers(locale),
};
const byCountry = [allEntry, ...countryEntries];

const phaseLabel = (phaseKey: string | null) => (phaseKey ? t(locale, `phase.${phaseKey}` as DictKey) : null);

/* PubMed 발행유형(pubTypes) 원문 문자열 → 뱃지 사전 키. 여기 없는 유형(예: "Journal Article")은 뱃지를 안 단다. */
const PUBTYPE_BADGE: Record<string, DictKey> = {
  'Meta-Analysis': 'research.pubtype.metaAnalysis',
  'Clinical Trial, Phase III': 'research.pubtype.phase3',
  'Clinical Trial, Phase IV': 'research.pubtype.phase4',
  'Randomized Controlled Trial': 'research.pubtype.rct',
  'Systematic Review': 'research.pubtype.systematicReview',
  'Observational Study': 'research.pubtype.observational',
};
const badgesFor = (pubTypes: string[]) => pubTypes.map((p) => PUBTYPE_BADGE[p]).filter((k): k is DictKey => Boolean(k));

/* 발표일도 번역 대상이다(오너 확정 2026-08-08) — PubMed 영어 월 축약("Aug")을 그대로
   보여주지 않고 언어판에 맞게 새로 조립한다. */
const MONTH_EN = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
function pubDateText(paper: { pubYear: string | null; pubMonth: number | null }) {
  if (!paper.pubYear) return '';
  if (locale === 'en') {
    return paper.pubMonth ? `${MONTH_EN[paper.pubMonth - 1]} ${paper.pubYear}` : paper.pubYear;
  }
  return paper.pubMonth ? `${paper.pubYear}년 ${paper.pubMonth}월` : `${paper.pubYear}년`;
}

const phaseDesc = (phaseKey: string | null) => (phaseKey ? t(locale, `phaseDesc.${phaseKey}` as DictKey) : null);

/* 시작일·종료일 중 있는 것만 이어붙인다. 둘 다 없으면 이 줄 자체를 안 그린다(astro 쪽에서 처리). */
function durationText(trial: { startDate: string | null; startDateEstimated: boolean; completionDate: string | null; completionDateEstimated: boolean }) {
  const estimated = t(locale, 'clinical.estimated' as DictKey);
  const start = trial.startDate ? trial.startDate + (trial.startDateEstimated ? ` (${estimated})` : '') : null;
  const end = trial.completionDate ? trial.completionDate + (trial.completionDateEstimated ? ` (${estimated})` : '') : null;
  if (start && end) return `${start} ~ ${end}`;
  return start ?? end;
}
---

<Layout
  title="임상시험·연구 — 파킨온"
  breadcrumbs={[
    { name: '홈', path: '/ko/' },
    { name: '임상시험·연구', path: '/ko/clinical/' },
  ]}
>
  <Header active="clinical" />

  <div class="layout">
    <aside class="ad-rail left">
      <AdBox minHeight="600px" />
    </aside>

    <main class="col">
      <section class="hub-hero-full" style={`background-image:url(${labImg.src});`}>
        <div class="hub-hero-full-inner">
          <h1>임상시험·연구</h1>
          <p><Tr k="clinical.tagline" /></p>
        </div>
      </section>

      <nav class="breadcrumb">
        <a href={getRelativeLocaleUrl(locale, '')}>홈</a><span class="sep">/</span><span>임상시험·연구</span>
      </nav>

      {/*
        국가 전환 = 완전히 다른 나라의 데이터로 넘어가는 것이다. 필터(운동 영상 난이도처럼
        한 목록을 거르는 것)와 성격이 달라서 알약 버튼을 쓰지 않는다(오너 지적 2026-08-08:
        "니처럼 알약으로 메뉴탭 하는 곳이 있나" — 실제로 WHO 국가 목록·위키백과 언어 전환
        둘 다 평범한 텍스트 링크였다). 이 사이트 헤더 메뉴와 같은 밑줄 방식으로 통일한다.
      */}
      <nav class="country-select" id="countryTabs">
        {
          byCountry.map((c) => (
            <button
              class:list={['country-link', { active: c.code === defaultCountry }]}
              data-country={c.code}
              data-total={c.data.total}
              data-research-total={c.research.total}
            >
              {c.label}
            </button>
          ))
        }
      </nav>

      {/*
        국가 탭 밑에 "임상시험/연구" 중 뭘 볼지 고르는 두 번째 단계다(오너 확정 2026-08-08).
        연구도 국가 탭에 따라 나뉜다(저자 소속기관 기반, src/lib/pubmed.ts 주석 참고) —
        국가 탭을 바꾸면 임상시험·연구 패널과 두 숫자가 같이 바뀐다.
        이 단계는 "필터"라 알약 스타일을 써도 된다고 오너가 확인함(국가 탭과는 다른 성격).
      */}
      <nav class="feed-tabs" id="feedTabs">
        <button class="pill active" data-feed="trials">
          <Tr k="clinical.feedTrials" /> <span class="n" id="trialsFeedCount">{byCountry.find((c) => c.code === defaultCountry)?.data.total ?? 0}</span>
        </button>
        <button class="pill" data-feed="research">
          <Tr k="research.feedLabel" /> <span class="n" id="researchFeedCount">{byCountry.find((c) => c.code === defaultCountry)?.research.total ?? 0}</span>
        </button>
      </nav>

      {/*
        제목·문의처는 ClinicalTrials.gov 원문 그대로라 항상 영어다. 한국어판만의 문제가
        아니다 — 프랑스어·독일어·일본어판도 똑같이 겪는다.
        ⚠️ 처음엔 "왜 영어로 나오는지"를 설명하는 문구를 달았는데, 오너가 바로 잡았다:
        "이걸 주 사용자인 고령자가 봐서 뭐하게?" — 왜 영어인지 알아도 고령자는 여전히
        못 읽는다. 우리 번역 원칙을 설명하는 건 우리 편의고, 독자에게는 쓸모가 없다.
        그래서 **설명이 아니라 행동 지침**으로 바꿨다 — "이 화면을 그대로 담당 의사·
        간호사에게 보여주고 상담하라"는 것. 영어를 못 읽어도 할 수 있는 행동이다.
        사전(src/i18n)에 한 번만 넣어 모든 언어가 공유한다. 영어판(locale === 'en')
        에는 안 띄운다 — 그 페이지는 원문과 언어가 같아서 이 문제 자체가 없다.
      */}
      <div id="trialsFeed">
      {locale !== 'en' && <p class="lang-notice"><Tr k="clinical.englishNotice" /></p>}

      <div id="countryPanels">
        {
          byCountry.map((c) => (
            <div class="country-panel" data-country={c.code} hidden={c.code !== defaultCountry}>
              {c.data.shown.length === 0 ? (
                <p class="empty"><Tr k="clinical.noTrials" /></p>
              ) : (
                <div class="trial-list">
                  {c.data.shown.map((trial) => (
                    <details class="trial-card">
                      <summary>
                        <span class="badge"><Tr k="clinical.recruiting" /></span>
                        <h3>{trial.titleTranslated ?? trial.title}</h3>
                      </summary>
                      <a class="view-link" href={trial.url} target="_blank" rel="noopener">
                        <Tr k="clinical.viewOriginal" /> ({trial.nctId})
                      </a>
                      <dl>
                        {phaseLabel(trial.phaseKey) && (
                          <>
                            <dt><Tr k="clinical.phase" /></dt>
                            <dd>
                              {phaseLabel(trial.phaseKey)}
                              <details class="phase-help">
                                <summary aria-label={t(locale, 'clinical.phaseHelp' as DictKey)}>?</summary>
                                <p>
                                  {phaseDesc(trial.phaseKey)}
                                  <a href={phaseGlossaryUrl}><Tr k="clinical.phaseMore" /></a>
                                </p>
                              </details>
                            </dd>
                          </>
                        )}
                        {durationText(trial) && (
                          <>
                            <dt><Tr k="clinical.duration" /></dt>
                            <dd>{durationText(trial)}</dd>
                          </>
                        )}
                        {trial.sponsor && (
                          <>
                            <dt><Tr k="clinical.sponsor" /></dt>
                            <dd>{trial.sponsor}</dd>
                          </>
                        )}
                        <dt><Tr k="clinical.location" /></dt>
                        <dd>
                          <ul class="cell-list">
                            {trial.locations.slice(0, 5).map((l) => (
                              <li>
                                {l.facility}
                                {l.city && ` (${l.city})`}
                              </li>
                            ))}
                          </ul>
                          {trial.locations.length > 5 && (
                            <p class="more">{tv(locale, 'clinical.moreLocations', { n: String(trial.locations.length - 5) })}</p>
                          )}
                        </dd>
                        {trial.contacts.length > 0 && (
                          <>
                            <dt><Tr k="clinical.contact" /></dt>
                            <dd>
                              <ul class="cell-list">
                                {trial.contacts.map((c) => (
                                  <li>{[c.name, c.phone, c.email].filter(Boolean).join(' · ')}</li>
                                ))}
                              </ul>
                            </dd>
                          </>
                        )}
                      </dl>
                    </details>
                  ))}
                </div>
              )}
              {c.data.overflowUrl && (
                <p class="overflow">
                  {tv(locale, 'clinical.overflowNote', { shown: String(c.data.shown.length), total: String(c.data.total) })}
                  {' · '}
                  <a href={c.data.overflowUrl} target="_blank" rel="noopener"><Tr k="clinical.seeAll" /></a>
                </p>
              )}
            </div>
          ))
        }
      </div>

      </div>

      <div id="researchFeed" hidden>
        <p class="research-tagline"><Tr k="research.tagline" /></p>

        <div id="researchPanels">
          {
            byCountry.map((c) => (
              <div class="research-panel" data-country={c.code} hidden={c.code !== defaultCountry}>
                {c.research.shown.length === 0 ? (
                  <p class="empty"><Tr k="research.noPapers" /></p>
                ) : (
                  <div class="research-list">
                    {c.research.shown.map((paper) => {
                      const badges = badgesFor(paper.pubTypes);
                      return (
                        <details class="research-card">
                          <summary>
                            <div class="badges">
                              {badges.map((b) => <span class="badge"><Tr k={b} /></span>)}
                            </div>
                            <h3>{paper.titleTranslated ?? paper.title}</h3>
                            <p class="research-meta">
                              <Tr k="research.journal" />: {paper.journal} · <Tr k="research.published" />: {pubDateText(paper)}
                            </p>
                          </summary>
                          {paper.abstractTranslated ? (
                            <div class="research-abstract">
                              {paper.abstractTranslated.map((sec) => (
                                <div class="abstract-section">
                                  {sec.label && <p class="abstract-label">{sec.label}</p>}
                                  <p class="abstract-text">{sec.text}</p>
                                </div>
                              ))}
                            </div>
                          ) : (
                            <p class="pending"><Tr k="research.translationPending" /></p>
                          )}
                          <p class="paid-notice"><Tr k="research.paidNotice" /></p>
                          <div class="research-links">
                            <a href={paper.pubmedUrl} target="_blank" rel="noopener"><Tr k="research.readAbstract" /></a>
                            {paper.fullTextUrl && (
                              <a href={paper.fullTextUrl} target="_blank" rel="noopener"><Tr k="research.readFullText" /></a>
                            )}
                          </div>
                        </details>
                      );
                    })}
                  </div>
                )}
                {c.research.overflowUrl && (
                  <p class="overflow">
                    {tv(locale, 'research.overflowNote', { shown: String(c.research.shown.length), total: String(c.research.total) })}
                    {' · '}
                    <a href={c.research.overflowUrl} target="_blank" rel="noopener"><Tr k="research.seeAll" /></a>
                  </p>
                )}
              </div>
            ))
          }
        </div>
      </div>
    </main>

    <aside class="ad-rail right">
      <AdBox minHeight="600px" />
    </aside>
  </div>

  <Footer />
</Layout>

<style>
  .breadcrumb {
    font-size: 13px;
    color: var(--text-sub);
    margin-bottom: 18px;
  }
  .breadcrumb a:hover {
    color: var(--primary);
  }
  .breadcrumb .sep {
    margin: 0 6px;
    opacity: 0.6;
  }

  /*
   * 국가 선택 — 헤더 메뉴(.nav-links a)와 같은 밑줄 방식. 알약 배경을 쓰지 않는다.
   * WHO 국가 목록·위키백과 언어 전환도 이런 평범한 텍스트 링크였다(2026-08-08 조사).
   */
  .country-select {
    display: flex;
    /* 줄바꿈하지 않는다 — 모바일에서 두 줄로 접히는 대신 옆으로 스와이프해서 본다
       (오너 지시 2026-08-08). 데스크톱은 폭이 넉넉해 스크롤이 실제로 일어나지 않는다. */
    flex-wrap: nowrap;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    gap: 22px;
    margin: 22px 0 30px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--outline);
  }
  .country-select::-webkit-scrollbar {
    display: none;
  }
  .country-link {
    flex-shrink: 0;
    position: relative;
    font-size: 15.5px;
    font-weight: 700;
    color: var(--text-sub);
    white-space: nowrap;
  }
  .country-link .n {
    font-size: 12.5px;
    font-weight: 600;
    color: var(--text-sub);
    opacity: 0.75;
  }
  .country-link.active {
    color: var(--primary);
  }
  .country-link.active::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -17px;
    height: 2px;
    background: var(--primary);
  }

  /*
   * 임상시험/연구 전환 — 국가 탭(완전히 다른 데이터로 전환)과 달리 이건 필터라서
   * 알약 스타일을 쓴다(오너 확인 2026-08-08).
   */
  .feed-tabs {
    display: flex;
    gap: 8px;
    margin: 18px 0 26px;
  }
  .pill {
    font-size: 14.5px;
    font-weight: 600;
    color: var(--text-sub);
    background: var(--bg);
    border: 1.5px solid var(--outline);
    border-radius: 20px;
    padding: 8px 16px;
  }
  .pill.active {
    background: var(--primary);
    border-color: var(--primary);
    color: #fff;
    font-weight: 700;
  }
  .pill .n {
    font-size: 12.5px;
    opacity: 0.85;
  }

  .lang-notice {
    margin: -8px 0 24px;
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--text-sub);
    opacity: 0.85;
  }

  .trial-list {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .trial-card {
    display: block;
    padding: 20px 0;
    border-bottom: 1px solid var(--outline);
    color: var(--text);
  }
  .trial-card:first-child {
    padding-top: 0;
  }
  /*
   * 제목만 보이고 내용은 펼쳐야 보인다(오너 확정 2026-08-08). 네이티브 details/summary —
   * 임상 단계 물음표 팝오버와 같은 방식, 새 토글 JS를 만들지 않는다.
   * 아이콘만으로 상태를 표시하지 않는다(아이콘만 버튼 금지 규칙) — 글자로 "더 보기/접기"를 단다.
   */
  /* ⚠️ 전부 > (직계 자식)로 건다 — 안 그러면 요약 안의 임상 단계 물음표(phase-help)도
     똑같이 summary라서 여기 걸려 "더 보기/접기" 글자가 새어 들어간다(2026-08-08 발견). */
  .trial-card > summary {
    cursor: pointer;
    list-style: none;
  }
  .trial-card > summary::-webkit-details-marker {
    display: none;
  }
  .trial-card > summary::after {
    content: '더 보기 ▾';
    display: inline-block;
    margin-top: 10px;
    font-size: 12.5px;
    font-weight: 700;
    color: var(--primary);
  }
  .trial-card[open] > summary::after {
    content: '접기 ▴';
  }
  .badge {
    display: inline-block;
    font-size: 11px;
    font-weight: 800;
    color: var(--primary);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .trial-card h3 {
    margin-top: 8px;
    font-size: 17px;
    line-height: 1.5;
    color: var(--text);
    /* 한글 어절 중간에서 줄바꿈되던 것을 막는다(오너 지적 2026-08-08) — 이 사이트 다른
       제목들과 같은 규칙(AppPromo.astro, index.astro). */
    word-break: keep-all;
  }
  .trial-card dl {
    margin-top: 12px;
    display: grid;
    grid-template-columns: 72px 1fr;
    gap: 6px 12px;
    font-size: 13.5px;
    line-height: 1.6;
  }
  .trial-card dt {
    color: var(--text-sub);
    font-weight: 600;
  }
  .trial-card dd {
    margin: 0;
    color: var(--text);
    word-break: break-word;
  }
  /* 위치·문의는 항목이 여러 개일 수 있다 — 한 줄로 이어붙이지 않고 목록으로 나눈다 */
  .trial-card .cell-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .trial-card .more {
    margin: 4px 0 0;
    font-size: 12.5px;
    color: var(--text-sub);
    opacity: 0.8;
  }
  .view-link {
    display: inline-block;
    margin-top: 12px;
    font-size: 12.5px;
    color: var(--text-sub);
  }
  .view-link:hover {
    color: var(--primary);
  }

  /* 임상 단계 물음표 — 눌러서 여는 팝오버. dt 안에 넣어도 <dl> 레이아웃이 깨지지 않게
     display:inline-block, position:relative로 그 안에서만 절대 배치한다. */
  .phase-help {
    display: inline-block;
    position: relative;
    margin-left: 4px;
    vertical-align: middle;
  }
  .phase-help summary {
    list-style: none;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--surface-high);
    color: var(--text-sub);
    font-size: 10.5px;
    font-weight: 700;
    line-height: 16px;
    text-align: center;
    cursor: pointer;
  }
  .phase-help summary::-webkit-details-marker {
    display: none;
  }
  .phase-help[open] summary {
    color: var(--on-primary-container);
    background: var(--primary);
  }
  .phase-help p {
    position: absolute;
    top: 22px;
    left: 0;
    z-index: 5;
    width: 230px;
    margin: 0;
    padding: 10px 12px;
    background: var(--surface);
    border: 1px solid var(--outline);
    border-radius: 8px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12);
    font-size: 12.5px;
    font-weight: 400;
    line-height: 1.55;
    color: var(--text);
    white-space: normal;
  }
  .phase-help p a {
    display: inline-block;
    margin-top: 6px;
    color: var(--primary);
    font-weight: 700;
  }

  .empty {
    font-size: 15px;
    color: var(--text-sub);
    padding: 32px 0;
    text-align: center;
  }
  .overflow {
    margin-top: 18px;
    font-size: 13px;
    color: var(--text-sub);
  }
  .overflow a:hover {
    color: var(--primary);
  }

  .research-tagline {
    margin-top: 8px;
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--text-sub);
  }
  .research-list {
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin-top: 24px;
  }
  .research-card {
    padding: 20px 0;
    border-bottom: 1px solid var(--outline);
  }
  .research-card:first-child {
    padding-top: 0;
  }
  .research-card > summary {
    cursor: pointer;
    list-style: none;
  }
  .research-card > summary::-webkit-details-marker {
    display: none;
  }
  .research-card > summary::after {
    content: '자세히 보기 ▾';
    display: inline-block;
    margin-top: 10px;
    font-size: 12.5px;
    font-weight: 700;
    color: var(--primary);
  }
  .research-card[open] > summary::after {
    content: '접기 ▴';
  }
  .research-card .badges {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }
  .research-card h3 {
    margin-top: 8px;
    font-size: 17px;
    line-height: 1.5;
    color: var(--text);
    word-break: keep-all;
  }
  .research-meta {
    margin-top: 6px;
    font-size: 12.5px;
    color: var(--text-sub);
  }
  .research-abstract {
    margin-top: 12px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: 14px;
    line-height: 1.75;
    color: var(--text);
  }
  /*
   * 배경/방법/결과/논의 — 세로 녹색줄은 항목명(제목) 줄에만 붙는다(오너 확정 2026-08-08).
   * 내용 문단까지 줄이 이어지지 않는다. 논문마다 초록 구조가 비슷하니 전부 이 틀을 쓴다.
   */
  .abstract-label {
    border-left: 3px solid var(--primary);
    padding-left: 14px;
    font-weight: 700;
    color: var(--text);
  }
  .abstract-text {
    margin-top: 4px;
    padding-left: 17px;
  }
  .pending {
    margin-top: 12px;
    font-size: 13.5px;
    color: var(--text-sub);
  }
  .paid-notice {
    margin-top: 12px;
    font-size: 12px;
    color: var(--text-sub);
    opacity: 0.85;
  }
  .research-links {
    margin-top: 12px;
    display: flex;
    gap: 16px;
  }
  .research-links a {
    font-size: 12.5px;
    color: var(--text-sub);
  }
  .research-links a:hover {
    color: var(--primary);
  }

  @media (max-width: 480px) {
    .trial-card dl {
      grid-template-columns: 1fr;
      gap: 2px 0;
    }
    .trial-card dt {
      margin-top: 8px;
    }
  }
</style>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('#countryTabs .country-link');
  const trialPanels = document.querySelectorAll<HTMLDivElement>('#countryPanels .country-panel');
  const researchPanels = document.querySelectorAll<HTMLDivElement>('#researchPanels .research-panel');
  const trialsFeedCount = document.querySelector<HTMLSpanElement>('#trialsFeedCount');
  const researchFeedCount = document.querySelector<HTMLSpanElement>('#researchFeedCount');

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      tabs.forEach((t) => t.classList.remove('active'));
      tab.classList.add('active');
      const country = tab.dataset.country;
      trialPanels.forEach((panel) => {
        panel.hidden = panel.dataset.country !== country;
      });
      researchPanels.forEach((panel) => {
        panel.hidden = panel.dataset.country !== country;
      });
      if (trialsFeedCount) trialsFeedCount.textContent = tab.dataset.total ?? '0';
      if (researchFeedCount) researchFeedCount.textContent = tab.dataset.researchTotal ?? '0';
    });
  });

  /* 임상시험/연구 전환 — 국가 탭과는 별개 축. 국가 탭은 두 피드 모두에 영향을 준다. */
  const feedTabs = document.querySelectorAll<HTMLButtonElement>('#feedTabs .pill');
  const trialsFeed = document.querySelector<HTMLDivElement>('#trialsFeed');
  const researchFeed = document.querySelector<HTMLDivElement>('#researchFeed');

  feedTabs.forEach((btn) => {
    btn.addEventListener('click', () => {
      feedTabs.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      const feed = btn.dataset.feed;
      if (trialsFeed) trialsFeed.hidden = feed !== 'trials';
      if (researchFeed) researchFeed.hidden = feed !== 'research';
    });
  });

  /* 임상 단계 물음표 팝오버(<details>) — 바깥을 눌러도 안 닫히던 것을 고친다.
     네이티브 <details> 는 summary 를 다시 눌러야만 닫힌다. */
  document.addEventListener('click', (e) => {
    document.querySelectorAll<HTMLDetailsElement>('.phase-help[open]').forEach((d) => {
      if (!d.contains(e.target as Node)) d.removeAttribute('open');
    });
  });

  /*
   * 방문자 나라를 국가 탭 맨 앞(전체 다음)으로 보내고 그 탭을 활성화한다(오너 확정
   * 2026-08-08: "한국이 메인이 아니다"). `/api/geo`(Cloudflare Pages Function, CF-IPCountry
   * 헤더)로 알아내고, 못 알아내거나 목록에 없는 나라면 조용히 "전체" 기본값을 유지한다.
   */
  (async () => {
    try {
      const res = await fetch('/api/geo');
      const { country } = (await res.json()) as { country: string | null };
      const code = country?.toLowerCase();
      const validCodes = ['kr', 'us', 'jp', 'fr', 'de', 'it', 'au'];
      if (!code || !validCodes.includes(code)) return;

      const allBtn = document.querySelector<HTMLButtonElement>('#countryTabs [data-country="all"]');
      const myBtn = document.querySelector<HTMLButtonElement>(`#countryTabs [data-country="${code}"]`);
      if (!allBtn || !myBtn) return;

      allBtn.after(myBtn);
      myBtn.click();
    } catch {
      /* 지오로케이션 실패 시 조용히 "전체" 기본값 유지 — 오류를 화면에 보여주지 않는다. */
    }
  })();
</script>
