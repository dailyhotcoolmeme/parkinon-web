<style>
  /* 스코프 있음 — 검색+필터 뼈대. 국가 탭보다 위(오너 지시 2026-08-08). */
  .search-bar {
    margin: 20px 0 8px;
    padding: 16px;
    background: var(--surface-low);
    border-radius: 12px;
  }
  .search-row {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .search-input {
    flex: 1 1 200px;
    min-width: 0;
    height: 40px;
    padding: 0 12px;
    border: 1.5px solid var(--outline);
    border-radius: 8px;
    background: var(--bg);
    color: var(--text);
    font-size: 14px;
  }
  .search-select,
  .search-filters select,
  .search-filters input {
    height: 40px;
    padding: 0 10px;
    border: 1.5px solid var(--outline);
    border-radius: 8px;
    background: var(--bg);
    color: var(--text);
    font-size: 13.5px;
  }
  .search-btn,
  .search-btn-ghost {
    height: 40px;
    padding: 0 18px;
    border-radius: 8px;
    font-weight: 700;
    font-size: 14px;
  }
  .search-btn {
    background: var(--primary);
    color: #fff;
    border: none;
  }
  .search-btn-ghost {
    background: none;
    border: 1.5px solid var(--outline);
    color: var(--text-sub);
  }
  .search-filters {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 10px;
  }
  /* [hidden]이 display:flex 에 덮여쓰던 것을 되돌린다(2026-08-08 실측 — 임상시험/연구
     필터가 동시에 보였음). display 속성을 직접 쓰는 요소는 항상 [hidden] 도 같이 챙길 것. */
  .search-filters[hidden] {
    display: none;
  }
  .date-filter {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12.5px;
    color: var(--text-sub);
  }
  .date-filter-range {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .date-filter input {
    /* 90px 이면 네이티브 날짜칸의 "연도. 월. 일." 표시 중 "월"이 잘렸다(2026-08-08 실측). */
    width: 128px;
  }
  #filterYearFrom,
  #filterYearTo {
    width: 80px;
  }

  .load-more {
    display: block;
    margin: 20px auto 0;
    height: 44px;
    padding: 0 24px;
    background: var(--surface-low);
    border: none;
    border-radius: 8px;
    font-weight: 700;
    font-size: 14px;
    color: var(--text);
  }
  .load-more[hidden] {
    display: none;
  }
  .search-result-count {
    /* 16px → 24px. .lang-notice/.research-tagline과 똑같이 "첫 카드 바로 앞 문구"
       관계인데 값이 달랐다(2026-08-08 오너 스크린샷 지적).
       margin-top: 16px — .search-bar 자체 margin-bottom(8px, 국가탭과도 공유하는
       값이라 여기서 못 바꾼다)과 합쳐 24px가 되게 해서, 위쪽 여백=아래쪽 여백(24=24)
       으로 대칭을 맞춘다(오너 지적: "위 간격이랑 밑 간격이랑 동일해야한다고!" —
       독립된 안내문구는 위·아래가 같아야 한다는 규칙, feedback_symmetric_spacing_
       standalone_line 참고).
       line-height: 1.6 — .lang-notice/.research-tagline과 같은 값. 원래 선언이
       없어서 브라우저 기본값(normal)을 쓰고 있었다 — 검색어가 길어져 두 줄이 되면
       줄간격이 다른 보조문구들과 달라 보였을 것이다. */
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--text-sub);
    margin-top: 16px;
    margin-bottom: 24px;
  }

  @media (max-width: 480px) {
    .search-row {
      flex-direction: column;
    }
    .search-input,
    .search-select,
    .search-btn,
    .search-btn-ghost {
      width: 100%;
      /* flex-direction 이 column 이 되면 flex-basis(200px)가 가로 대신 높이에 적용돼
         입력창이 200px 높이로 늘어졌다(2026-08-08 실측) — flex 자체를 꺼서 막는다. */
      flex: none;
    }

    /* 기본 = 검색어 칸만 한 줄. 탭하면(.expanded) 나라·버튼·필터가 펼쳐진다
       (오너 지시 2026-08-08: "검색어 박스만 한줄로 보였다가 검색어 누르면 펼쳐지게"). */
    #searchBar:not(.expanded) .search-select,
    #searchBar:not(.expanded) .search-btn,
    #searchBar:not(.expanded) .search-btn-ghost,
    #searchBar:not(.expanded) .search-filters {
      display: none;
    }

    /* 필터 항목 수가 줄마다 달라(2개·3개) 마지막 줄이 혼자 남으면 오른쪽에 빈 공간이
       생기고, 고정 80px 칸에는 "연도부터" 문구가 잘렸다(2026-08-08 오너 스크린샷 지적).
       모든 필터 항목을 flex-grow 로 늘어나게 해 혼자 남아도 그 줄을 끝까지 채운다 —
       항목이 2개든 3개든 같은 규칙 하나로 처리되어 케이스별 예외가 없다. */
    .search-filters > * {
      flex: 1 1 140px;
      min-width: 0;
    }
    /* 기간·연도 필터는 라벨+입력 두 칸을 담아서 다른 항목과 줄을 나눠 쓰면 비좁아진다
       (2026-08-08 실측 — "임상 단계 전체"와 한 줄을 나눠 쓰면서 날짜칸이 아이콘만
       남을 정도로 눌렸다). 이웃 필터 개수와 무관하게 항상 혼자 한 줄 전체를 쓰게 한다.
       ⚠️ 반드시 `.search-filters > .date-filter`로 쓸 것 — Astro 스코프가 결합자
       양쪽에 [data-astro-cid-*]를 붙여서, 위 `.search-filters > *`가 홑클래스
       `.date-filter`보다 우선순위가 더 높다(2026-08-08 실측 — flex:100%를 줬는데도
       조용히 안 먹고 140px로 눌린 채 넘어갔다). 부모까지 같이 써서 우선순위를 맞춘다. */
    .search-filters > .date-filter {
      flex: 1 1 100%;
      flex-wrap: wrap;
    }
    .date-filter-range {
      flex: 1 1 100%;
      width: 100%;
    }
    .date-filter input,
    #filterYearFrom,
    #filterYearTo {
      flex: 1;
      width: auto;
      min-width: 110px;
    }
  }
</style>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('#countryTabs .country-link');
  const trialPanels = document.querySelectorAll<HTMLDivElement>('#countryPanels .country-panel');
  const researchPanels = document.querySelectorAll<HTMLDivElement>('#researchPanels .research-panel');
  const trialsFeedCount = document.querySelector<HTMLSpanElement>('#trialsFeedCount');
  const researchFeedCount = document.querySelector<HTMLSpanElement>('#researchFeedCount');

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      tabs.forEach((t) => t.classList.remove('active'));
      tab.classList.add('active');
      const country = tab.dataset.country;
      trialPanels.forEach((panel) => {
        panel.hidden = panel.dataset.country !== country;
      });
      researchPanels.forEach((panel) => {
        panel.hidden = panel.dataset.country !== country;
      });
      if (trialsFeedCount) trialsFeedCount.textContent = tab.dataset.total ?? '0';
      if (researchFeedCount) researchFeedCount.textContent = tab.dataset.researchTotal ?? '0';
    });
  });

  /* 임상시험/연구 전환 — 국가 탭과는 별개 축. 국가 탭은 두 피드 모두에 영향을 준다. */
  const feedTabs = document.querySelectorAll<HTMLButtonElement>('#feedTabs .pill');
  const trialsFeed = document.querySelector<HTMLDivElement>('#trialsFeed');
  const researchFeed = document.querySelector<HTMLDivElement>('#researchFeed');

  feedTabs.forEach((btn) => {
    btn.addEventListener('click', () => {
      feedTabs.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      const feed = btn.dataset.feed;
      if (trialsFeed) trialsFeed.hidden = feed !== 'trials';
      if (researchFeed) researchFeed.hidden = feed !== 'research';
    });
  });

  /* 임상 단계 물음표 팝오버(<details>) — 바깥을 눌러도 안 닫히던 것을 고친다.
     네이티브 <details> 는 summary 를 다시 눌러야만 닫힌다. */
  document.addEventListener('click', (e) => {
    document.querySelectorAll<HTMLDetailsElement>('.phase-help[open]').forEach((d) => {
      if (!d.contains(e.target as Node)) d.removeAttribute('open');
    });
  });

  /*
   * 방문자 나라를 국가 탭 맨 앞(전체 다음)으로 보내고 그 탭을 활성화한다(오너 확정
   * 2026-08-08: "한국이 메인이 아니다"). `/api/geo`(Cloudflare Pages Function, CF-IPCountry
   * 헤더)로 알아내고, 못 알아내거나 목록에 없는 나라면 조용히 "전체" 기본값을 유지한다.
   */
  (async () => {
    try {
      const res = await fetch('/api/geo');
      const { country } = (await res.json()) as { country: string | null };
      const code = country?.toLowerCase();
      const validCodes = ['kr', 'us', 'jp', 'fr', 'de', 'it', 'au'];
      if (!code || !validCodes.includes(code)) return;

      const allBtn = document.querySelector<HTMLButtonElement>('#countryTabs [data-country="all"]');
      const myBtn = document.querySelector<HTMLButtonElement>(`#countryTabs [data-country="${code}"]`);
      if (!allBtn || !myBtn) return;

      allBtn.after(myBtn);
      myBtn.click();
    } catch {
      /* 지오로케이션 실패 시 조용히 "전체" 기본값 유지 — 오류를 화면에 보여주지 않는다. */
    }
  })();
</script>

<script>
  import { paragraphizeAbstract } from '../../../lib/abstractFormat';

  /*
   * 검색+더보기 — functions/api/trials.js, functions/api/research.js 를 방문 중에 실시간
   * 호출한다(오너 확정 2026-08-08). 새 카드를 그릴 때 쓰는 라벨은 #clientLabels(위 JSON,
   * 서버에서 사전 값을 미리 번역해 내려준 것)에서 가져온다 — 여기서 한글을 새로 짓지 않는다.
   */
  interface ClientLabels {
    locale: string;
    phaseGlossaryUrl: string;
    phaseLabels: Record<string, string>;
    phaseDescs: Record<string, string>;
    pubtypeLabels: Record<string, string>;
    ui: Record<string, string>;
  }
  const LABELS: ClientLabels = JSON.parse(document.getElementById('clientLabels')!.textContent!);
  // 서버 렌더와 같은 함수 — 여기서 새로 짓지 않는다(모듈 스크립트라 import 가능).

  const MONTH_EN = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

  function esc(s: string) {
    return String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  function durationTextClient(t: { startDate: string | null; startDateEstimated: boolean; completionDate: string | null; completionDateEstimated: boolean }) {
    const est = LABELS.ui.estimated;
    const start = t.startDate ? t.startDate + (t.startDateEstimated ? ` (${est})` : '') : null;
    const end = t.completionDate ? t.completionDate + (t.completionDateEstimated ? ` (${est})` : '') : null;
    if (start && end) return `${start} ~ ${end}`;
    return start ?? end;
  }

  /* ⚠️ "년"/"월"을 여기 직접 쓰지 않는다 — LABELS.ui.dateYearMonth/dateYearOnly(사전 값,
     서버에서 미리 번역해 내려줌)를 거친다. 예전엔 여기 한글을 직접 박아 놨었다
     (2026-08-08 오너 전수조사로 발견 — src/pages는 check-i18n.mjs 검사에서 빠져 있어서
     안 잡혔다). pubDateText(서버쪽 동일 함수)와 항상 같은 방식을 쓸 것. */
  function pubDateTextClient(paper: { pubYear: string | null; pubMonth: number | null }) {
    if (!paper.pubYear) return '';
    if (!paper.pubMonth) return LABELS.ui.dateYearOnly.replace('{y}', paper.pubYear);
    const month = LABELS.locale === 'en' ? MONTH_EN[paper.pubMonth - 1] : String(paper.pubMonth);
    return LABELS.ui.dateYearMonth.replace('{y}', paper.pubYear).replace('{m}', month);
  }

  function trialCardHtml(trial: any): string {
    const title = esc(trial.titleTranslated ?? trial.title);
    const phaseLabel = trial.phaseKey ? LABELS.phaseLabels[trial.phaseKey] : null;
    const phaseDesc = trial.phaseKey ? LABELS.phaseDescs[trial.phaseKey] : null;
    const duration = durationTextClient(trial);
    let dl = '';
    if (phaseLabel) {
      dl += `<dt>${esc(LABELS.ui.phase)}</dt><dd>${esc(phaseLabel)}
        <details class="phase-help"><summary aria-label="${esc(LABELS.ui.phaseHelp)}">?</summary>
        <p>${esc(phaseDesc ?? '')} <a href="${LABELS.phaseGlossaryUrl}">${esc(LABELS.ui.phaseMore)}</a></p>
        </details></dd>`;
    }
    if (duration) dl += `<dt>${esc(LABELS.ui.duration)}</dt><dd>${esc(duration)}</dd>`;
    if (trial.sponsor) dl += `<dt>${esc(LABELS.ui.sponsor)}</dt><dd>${esc(trial.sponsor)}</dd>`;
    return `<details class="trial-card">
      <summary><span class="badge">${esc(LABELS.ui.recruiting)}</span><h3>${title}</h3></summary>
      <a class="view-link" href="${trial.url}" target="_blank" rel="noopener">${esc(LABELS.ui.viewOriginal)} (${esc(trial.nctId)})</a>
      <dl>${dl}</dl>
    </details>`;
  }

  function researchCardHtml(paper: any): string {
    const title = esc(paper.titleTranslated ?? paper.title);
    const badges = (paper.pubTypes ?? []).map((pt: string) => LABELS.pubtypeLabels[pt]).filter(Boolean);
    const badgesHtml = badges.map((b: string) => `<span class="badge">${esc(b)}</span>`).join('');
    const sections = paper.abstractTranslated ?? paper.abstract ?? [];
    const abstractHtml = sections
      .map((sec: any) => {
        const paras: string[] = paragraphizeAbstract(sec.text);
        const parasHtml = paras.map((p) => `<p class="abstract-text">${esc(p)}</p>`).join('');
        return `<div class="abstract-section">${sec.label ? `<p class="abstract-label">${esc(sec.label)}</p>` : ''}${parasHtml}</div>`;
      })
      .join('');
    return `<details class="research-card">
      <summary>
        <div class="badges">${badgesHtml}</div>
        <h3>${title}</h3>
        <p class="research-meta">${esc(LABELS.ui.journal)}: ${esc(paper.journal)} · ${esc(LABELS.ui.published)}: ${esc(pubDateTextClient(paper))}</p>
      </summary>
      <div class="research-abstract">${abstractHtml}</div>
      <p class="paid-notice">${esc(LABELS.ui.paidNotice)}</p>
      <div class="research-links">
        <a href="${paper.pubmedUrl}" target="_blank" rel="noopener">${esc(LABELS.ui.readAbstract)}</a>
        ${paper.fullTextUrl ? `<a href="${paper.fullTextUrl}" target="_blank" rel="noopener">${esc(LABELS.ui.readFullText)}</a>` : ''}
      </div>
    </details>`;
  }

  /* 국가 탭 브라우징 화면의 "더 보기" — 그 나라·그 피드만 다음 페이지를 이어붙인다. */
  document.querySelectorAll<HTMLButtonElement>('#browseMode .load-more').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const feed = btn.dataset.feed as 'trials' | 'research';
      const country = btn.dataset.country!;
      const shown = Number(btn.dataset.shown ?? '0');
      btn.disabled = true;
      try {
        const params = new URLSearchParams({ country, offset: String(shown), locale: LABELS.locale });
        const res = await fetch(`/api/${feed === 'trials' ? 'trials' : 'research'}?${params}`);
        const json = await res.json();
        const items = json.items ?? [];
        const panel = btn.closest(feed === 'trials' ? '.country-panel' : '.research-panel');
        const list = panel?.querySelector(feed === 'trials' ? '.trial-list' : '.research-list');
        if (list) list.insertAdjacentHTML('beforeend', items.map((it: any) => (feed === 'trials' ? trialCardHtml(it) : researchCardHtml(it))).join(''));
        const newShown = shown + items.length;
        const total = json.total ?? newShown;
        if (newShown >= total) {
          btn.remove();
        } else {
          btn.dataset.shown = String(newShown);
          btn.textContent = `${LABELS.ui.loadMore} (${newShown}/${total})`;
          btn.disabled = false;
        }
      } catch {
        btn.disabled = false;
      }
    });
  });

  /* 검색+필터 */
  const searchQuery = document.getElementById('searchQuery') as HTMLInputElement;
  const searchCountrySel = document.getElementById('searchCountry') as HTMLSelectElement;
  const searchSubmitBtn = document.getElementById('searchSubmit') as HTMLButtonElement;
  const searchClearBtn = document.getElementById('searchClear') as HTMLButtonElement;
  const filtersTrialsEl = document.getElementById('filtersTrials')!;
  const filtersResearchEl = document.getElementById('filtersResearch')!;
  const browseModeEl = document.getElementById('browseMode')!;
  const searchResultsEl = document.getElementById('searchResults')!;
  const searchResultListEl = document.getElementById('searchResultList')!;
  const searchResultCountEl = document.getElementById('searchResultCount')!;
  const searchEmptyEl = document.getElementById('searchEmpty') as HTMLParagraphElement;
  const searchLoadMoreBtn = document.getElementById('searchLoadMore') as HTMLButtonElement;

  /* 모바일 = 검색어 칸만 한 줄로 보이다가, 탭하면 나라·필터가 펼쳐진다(오너 지시 2026-08-08). */
  const searchBarEl = document.getElementById('searchBar')!;
  searchQuery.addEventListener('focus', () => {
    searchBarEl.classList.add('expanded');
  });

  function currentFeed(): 'trials' | 'research' {
    return document.querySelector<HTMLButtonElement>('#feedTabs .pill.active')?.dataset.feed === 'research' ? 'research' : 'trials';
  }

  /* 필터 패널도 임상시험/연구 전환에 맞춰 같이 바뀐다. */
  document.querySelectorAll<HTMLButtonElement>('#feedTabs .pill').forEach((btn) => {
    btn.addEventListener('click', () => {
      const feed = btn.dataset.feed;
      filtersTrialsEl.hidden = feed !== 'trials';
      filtersResearchEl.hidden = feed !== 'research';
    });
  });

  function buildParams(offset: number): URLSearchParams {
    const feed = currentFeed();
    const params = new URLSearchParams({ locale: LABELS.locale, country: searchCountrySel.value, offset: String(offset) });
    const q = searchQuery.value.trim();
    if (q) params.set('q', q);
    if (feed === 'trials') {
      const phase = (document.getElementById('filterPhase') as HTMLSelectElement).value;
      const dateFrom = (document.getElementById('filterDateFrom') as HTMLInputElement).value;
      const dateTo = (document.getElementById('filterDateTo') as HTMLInputElement).value;
      const sponsor = (document.getElementById('filterSponsor') as HTMLInputElement).value.trim();
      if (phase) params.set('phase', phase);
      if (dateFrom) params.set('date_from', dateFrom);
      if (dateTo) params.set('date_to', dateTo);
      if (sponsor) params.set('sponsor', sponsor);
    } else {
      const pubtype = (document.getElementById('filterPubtype') as HTMLSelectElement).value;
      const journal = (document.getElementById('filterJournal') as HTMLSelectElement).value;
      const yearFrom = (document.getElementById('filterYearFrom') as HTMLInputElement).value.trim();
      const yearTo = (document.getElementById('filterYearTo') as HTMLInputElement).value.trim();
      if (pubtype) params.set('pubtype', pubtype);
      if (journal) params.set('journal', journal);
      if (yearFrom) params.set('year_from', yearFrom);
      if (yearTo) params.set('year_to', yearTo);
    }
    return params;
  }

  let searchOffset = 0;

  async function runSearch(reset: boolean) {
    const feed = currentFeed();
    if (reset) {
      searchOffset = 0;
      searchResultListEl.innerHTML = '';
      // ⚠️ 결과 목록이 항상 .trial-list 고정이라 연구 결과에 임상시험 목록 간격(20px)이
      // 그대로 붙어서 "형식이 다르게 보인다"는 지적을 받았다(2026-08-08) — 피드에 맞는
      // 클래스로 매번 바꾼다.
      searchResultListEl.className = feed === 'trials' ? 'trial-list' : 'research-list';
    }
    const params = buildParams(searchOffset);
    const res = await fetch(`/api/${feed === 'trials' ? 'trials' : 'research'}?${params}`);
    const json = await res.json();
    const total = json.total ?? 0;
    const items = json.items ?? [];
    searchResultListEl.insertAdjacentHTML('beforeend', items.map((it: any) => (feed === 'trials' ? trialCardHtml(it) : researchCardHtml(it))).join(''));
    searchOffset += items.length;

    /* 피드 이름("임상시험"/"연구")은 검색 버튼을 누르기 전 이미 선택해 둔 탭이라 사용자가
       이미 아는 정보다 — 반면 "무엇을 검색해서 이 결과가 나왔는지"는 화면을 내리면 검색창이
       안 보여서 잊어버리기 쉽다(오너 지적 2026-08-08: "임상시험 탭이 중요한거냐 아니면
       검색어를 보여주는게 중요하겠냐"). 그래서 피드 이름 대신 검색어를 보여준다 — 검색어 없이
       필터만으로 검색했을 때는 검색어 자리를 비운다. */
    const query = searchQuery.value.trim();
    searchEmptyEl.hidden = total > 0;
    searchResultCountEl.textContent =
      total > 0
        ? query
          ? LABELS.ui.resultCountForQuery.replace('{q}', query).replace('{n}', String(total))
          : LABELS.ui.resultCount.replace('{n}', String(total))
        : '';
    searchLoadMoreBtn.hidden = searchOffset >= total;
    if (!searchLoadMoreBtn.hidden) searchLoadMoreBtn.textContent = `${LABELS.ui.loadMore} (${searchOffset}/${total})`;
  }

  searchSubmitBtn.addEventListener('click', () => {
    browseModeEl.hidden = true;
    searchResultsEl.hidden = false;
    searchClearBtn.hidden = false;
    runSearch(true);
  });
  searchQuery.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') searchSubmitBtn.click();
  });
  searchClearBtn.addEventListener('click', () => {
    browseModeEl.hidden = false;
    searchResultsEl.hidden = true;
    searchClearBtn.hidden = true;
    searchQuery.value = '';
    searchResultListEl.innerHTML = '';
  });
  searchLoadMoreBtn.addEventListener('click', () => runSearch(false));
</script>
