---
/*
 * 운동 영상 허브 (할 일 0-5, 2026-08-07).
 *
 * 다른 허브(소식·생활 요령·제도)와 달리 **글이 아니라 영상 목록**이다. 데이터는
 * `src/lib/exerciseVideos.ko.ts` — 출처·검증 근거는 그 파일 주석 참고.
 *
 * ⚠️ 영상은 <iframe> 으로 심지 않는다. **썸네일(정적 이미지) + 새 탭 링크**로만 연결한다.
 *   지금 이 사이트는 "쿠키 0개·분석/광고 스크립트 0개"가 실측된 상태이고
 *   (site-implementation.md "쿠키 동의·CMP"), YouTube iframe 을 심으면 그 상태가
 *   조용히 깨진다. Google 인증 CMP 를 켤 때(1-8) 같이 정리한다.
 *
 * 필터칩은 앱 전역 표준(VideoList 스타일)을 그대로 옮겼다 — 선택=주색 배경+흰 글자,
 * 비선택=흰 배경+테두리(오너가 기준 화면으로 확정한 스타일, memory
 * project_parkinon_filter_chip_standard). 새 스타일을 발명하지 않았다.
 */
import { getRelativeLocaleUrl } from 'astro:i18n';
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import AdBox from '../../../components/AdBox.astro';
import yogaImg from '../../../assets/images/yoga.jpg';
import { VIDEO_DATA, DIFFICULTIES } from '../../../lib/exerciseVideos.ko';
import { EXERCISE_SOURCE } from '../../../lib/exerciseSource.ko';
import ExerciseSourceNote from '../../../components/ExerciseSourceNote.astro';

const locale = Astro.currentLocale ?? 'ko';

const allVideos = DIFFICULTIES.flatMap((d) => VIDEO_DATA[d].map((v) => ({ ...v, difficulty: d })));
const youtubeUrl = (id: string) => `https://www.youtube.com/watch?v=${id}`;
const thumbUrl = (id: string) => `https://img.youtube.com/vi/${id}/hqdefault.jpg`;
---

<Layout
  title="운동 영상 — 파킨온"
  breadcrumbs={[
    { name: '홈', path: '/ko/' },
    { name: '운동 영상', path: '/ko/exercise/' },
  ]}
>
  <Header active="exercise" />

  <div class="layout">
    <aside class="ad-rail left">
      <AdBox minHeight="600px" />
    </aside>

    <main class="col">
      <section class="hub-hero-full" style={`background-image:url(${yogaImg.src});`}>
        <div class="hub-hero-full-inner">
          <h1>운동 영상</h1>
          <p>질병관리청 국립보건연구원과 대한파킨슨병및이상운동질환학회가 함께 만든, 효과가 확인된 운동입니다.</p>
        </div>
      </section>

      <nav class="breadcrumb">
        <a href={getRelativeLocaleUrl(locale, '')}>홈</a><span class="sep">/</span><span>운동 영상</span>
      </nav>

      <ExerciseSourceNote source={EXERCISE_SOURCE} />

      <div class="hub-tabs" id="diffTabs">
        <button class="tab active" data-diff="전체">전체</button>
        {DIFFICULTIES.map((d) => <button class="tab" data-diff={d}>{d}</button>)}
      </div>

      <div class="video-grid" id="videoGrid">
        {
          allVideos.map((v) => (
            <a
              class="video-card"
              data-diff={v.difficulty}
              href={youtubeUrl(v.videoId)}
              target="_blank"
              rel="noopener"
            >
              <span class="thumb">
                <img src={thumbUrl(v.videoId)} alt="" loading="lazy" width="336" height="188" />
                <span class="duration">{v.duration}</span>
                <span class="play" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
                </span>
              </span>
              <span class="badge">{v.difficulty}</span>
              <h3>{v.title}</h3>
              <p>{v.description}</p>
            </a>
          ))
        }
      </div>
    </main>

    <aside class="ad-rail right">
      <AdBox minHeight="600px" />
    </aside>
  </div>

  <Footer />
</Layout>

<style>
  .breadcrumb {
    font-size: 13px;
    color: var(--text-sub);
    margin-bottom: 18px;
  }
  .breadcrumb a:hover {
    color: var(--primary);
  }
  .breadcrumb .sep {
    margin: 0 6px;
    opacity: 0.6;
  }

  /*
   * 필터칩 = 앱 전역 표준 그대로(memory project_parkinon_filter_chip_standard).
   * 비선택: 흰 배경 + 테두리 1.5 + textSub. 선택: 주색 배경 + 흰 글자.
   * 렌더 높이 ≈40px, 세로 잘림 방지를 위해 고정 height 대신 padding 으로만 높이를 만든다.
   */
  .hub-tabs {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    margin: 22px 0 28px;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .hub-tabs::-webkit-scrollbar {
    display: none;
  }
  .tab {
    flex: 0 0 auto;
    font-size: 15px;
    font-weight: 600;
    color: var(--text-sub);
    background: var(--bg);
    border: 1.5px solid var(--outline);
    border-radius: 20px;
    padding: 8px 18px;
    white-space: nowrap;
  }
  .tab.active {
    background: var(--primary);
    border-color: var(--primary);
    color: #fff;
    font-weight: 700;
  }

  .video-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    /* 세로 간격만 22→40px 로 키웠다 — 카드 아래 두 줄 설명이 다음 줄 썸네일과 거의 붙어
       보였다는 지적(2026-08-07). 가로 간격은 그대로 둔다. */
    gap: 40px 18px;
    padding-bottom: 8px;
  }
  .video-card {
    display: block;
    color: var(--text);
  }
  .thumb {
    position: relative;
    display: block;
    border-radius: 10px;
    overflow: hidden;
    background: var(--surface-low);
    aspect-ratio: 16 / 9;
  }
  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .thumb .duration {
    position: absolute;
    right: 6px;
    bottom: 6px;
    background: rgba(0, 0, 0, 0.75);
    color: #fff;
    font-size: 11.5px;
    font-weight: 700;
    padding: 2px 6px;
    border-radius: 4px;
  }
  .thumb .play {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    opacity: 0.92;
  }
  .thumb .play svg {
    width: 46px;
    height: 46px;
    filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.5));
  }
  .video-card .badge {
    display: inline-block;
    margin-top: 10px;
    font-size: 11px;
    font-weight: 800;
    color: var(--primary);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .video-card h3 {
    font-size: 16px;
    margin-top: 4px;
    line-height: 1.4;
    /* 제목 길이가 들쭉날쭉해도 카드 높이를 맞춘다 */
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }
  .video-card p {
    margin-top: 6px;
    font-size: 13px;
    line-height: 1.6;
    color: var(--text-sub);
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }
  .video-card[hidden] {
    display: none;
  }

  @media (max-width: 480px) {
    .video-grid {
      grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
      gap: 32px 12px;
    }
  }
</style>

<script>
  // 순수 필터링 — 서버 재요청 없이 카드를 보이고 숨긴다. 프레임워크 없이 32개 정도는 이걸로 충분하다.
  const tabs = document.querySelectorAll<HTMLButtonElement>('#diffTabs .tab');
  const cards = document.querySelectorAll<HTMLAnchorElement>('#videoGrid .video-card');

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      tabs.forEach((t) => t.classList.remove('active'));
      tab.classList.add('active');
      const diff = tab.dataset.diff;
      cards.forEach((card) => {
        card.hidden = diff !== '전체' && card.dataset.diff !== diff;
      });
    });
  });
</script>
