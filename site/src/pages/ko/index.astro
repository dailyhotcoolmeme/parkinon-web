---
import { getCollection } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import AdFitBanner from '../../components/article/AdFitBanner.astro';
import { inLocale, inCategory, sortByDateDesc, slugOf, categoryOf, categoryLabel, formatDate } from '../../lib/articles';

import heroImg from '../../assets/images/hero.jpg';

import shot1 from '../../assets/images/appshots/parkinon1.png';
import shot2 from '../../assets/images/appshots/parkinon2.png';
import shot3 from '../../assets/images/appshots/parkinon3.png';
import shot4 from '../../assets/images/appshots/parkinon4.png';
import shot5 from '../../assets/images/appshots/parkinon5.png';
import shot6 from '../../assets/images/appshots/parkinon6.png';
import shot7 from '../../assets/images/appshots/parkinon7.png';
import shot8 from '../../assets/images/appshots/parkinon8.png';
import shotEtc from '../../assets/images/appshots/parkinon_etc.png';

import { PLAY_STORE_URL, appleStoreUrl } from '../../lib/links';
import { t, type DictKey } from '../../i18n';
const locale = Astro.currentLocale ?? 'ko';

const appShots = [
  { img: shot1, cap: '약 복용 기록', alt: '파킨온 앱 - 약복용 기록 화면' },
  { img: shot2, cap: '몸상태·기분 기록', alt: '파킨온 앱 - 몸상태·기분상태 기록 화면' },
  { img: shot3, cap: '운동 기록', alt: '파킨온 앱 - 운동 기록 화면' },
  { img: shot4, cap: '기록·관리', alt: '파킨온 앱 - 기록·관리 화면' },
  { img: shot5, cap: '복용약 등록·관리', alt: '파킨온 앱 - 복용약 등록·관리 화면' },
  { img: shot6, cap: '가족 연동', alt: '파킨온 앱 - 가족 연동 화면' },
  { img: shot7, cap: '복용시간 설정·알림', alt: '파킨온 앱 - 복용시간 설정·알림 화면' },
  { img: shot8, cap: '가족 일기', alt: '파킨온 앱 - 가족 일기 화면' },
  { img: shotEtc, cap: '정보·나눔 커뮤니티', alt: '파킨온 앱 - 정보·나눔 커뮤니티 화면' },
];

const featureList = [
  {
    emoji: '💊',
    title: '약 복용 기록',
    desc: '약 먹을 시간을 알림으로 챙겨드려요.<br/>드셨는지 체크만 하면 자동으로 기록이 쌓여요.',
  },
  {
    emoji: '😊',
    title: '몸상태·기분 기록',
    desc: '복용 후 몸상태, 기분상태를 복용약의 기준에 맞게 측정할 수 있어요.<br/>약효 추적 기록이 쌓이면 복용약 조절하는 데 보조지표가 될 수 있어요.',
  },
  {
    emoji: '🏃',
    title: '운동 기록',
    desc: '오늘 한 운동을 기록하면 꾸준히 이어갈 힘이 돼요.<br/>보호자도 얼마나 움직이셨는지 함께 확인할 수 있어요.',
  },
  {
    emoji: '👨‍👩‍👧',
    title: '가족 연동',
    desc: '환자가 기록하면 보호자에게도 알림이 가요.<br/>보호자는 환자의 복약 여부와 몸/기분 상태를 알 수 있어서 세심하게 도울 수 있어요.<br/>멀리 떨어져 지내도 환자의 상태를 알 수 있어서 안심이 돼요.',
  },
  {
    emoji: '📔',
    title: '가족 일기',
    desc: '하루의 소회를 짧게 남기면 나중에 E-Book으로 만들어 드려요.<br/>보호자도 함께 일기에 동참해서 서로 응원하면서 이겨낼 수 있어요.',
  },
  {
    emoji: '📋',
    title: '기록·관리',
    desc: '모든 기록을 한번에 볼 수 있어요.<br/>입력한 기록들을 그래프로 보여줘서 트렌드를 볼 수 있어요.',
  },
];

/*
 * 홈 "오늘의 파킨온 소식" — 예전엔 다섯 줄 다 손으로 지어낸 가짜 글이었다(제목도
 * href="#"도 실제로 없는 글). 오너 지시(2026-08-10: "이미 세부 메뉴들 컨텐츠 있으니까
 * 그걸로 갈아끼워야지") — 실제 글 컬렉션에서 가져온다.
 *
 * ⚠️ 메인 카드는 **무조건 소식(news) 카테고리**여야 한다 — 섹션 제목 자체가
 * "오늘의 파킨온 소식"이다. 처음엔 전체 카테고리 중 최신 글을 그냥 가져와서 제도·지원
 * 글이 메인에 뜨는 사고가 났다(오너 지적 2026-08-10: "왜 메인이 제도지원으로 바뀌었냐,
 * 소식이 메인이 되어야 하는데"). 옆 5줄은 소식이 아니어도 되니 전체 최신 글로 채운다.
 */
const allArticles = sortByDateDesc(await getCollection('articles', inLocale(locale)));
const newsArticles = sortByDateDesc(await getCollection('articles', inCategory(locale, 'news')));
const featured = newsArticles[0];
const newsRows = allArticles.filter((e) => e.id !== featured.id).slice(0, 5);

const tagLabel = (e: (typeof allArticles)[number]) =>
  categoryOf(e) === 'news' ? e.data.tag : `${categoryLabel(locale, categoryOf(e))} · ${e.data.tag}`;

const articleHref = (e: (typeof allArticles)[number]) => getRelativeLocaleUrl(locale, `${categoryOf(e)}/${slugOf(e)}`);

/*
 * 홈 "둘러보기" — 예전엔 제도·지원/생활 요령 2개만 있었다. 지금은 5개 메뉴가 다 실제
 * 콘텐츠를 갖췄으니 전부 보여준다(순서는 헤더·푸터와 같은 src/lib/nav.ts 기준).
 * 아이콘은 기존 두 카드(제도=Feather "home", 생활=Feather "heart")와 같은 선 아이콘
 * 세트(Feather Icons, MIT)에서 골라 통일했다.
 */
const axisCards = [
  {
    href: getRelativeLocaleUrl(locale, 'news'),
    cat: '최신 소식',
    desc: '국내외 파킨슨병 연구·치료 소식을 쉬운 말로 정리해 이틀에 한 번 전해드립니다.',
    icon: ['M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z', 'M14 2v6h6', 'M16 13H8', 'M16 17H8'],
  },
  {
    href: getRelativeLocaleUrl(locale, 'lifestyle'),
    cat: '생활 요령',
    desc: '낙상 예방, 식단·수면 관리부터 마음 건강, 보호자 번아웃 대처법까지 — 매일의 어려움을 덜어줄 실전 정보를 모았습니다.',
    icon: ['M12 21s-7-4.35-9.5-8.5C1 9 2.5 5.5 6 5c2-.3 3.5.8 6 3.5C14.5 5.8 16 4.7 18 5c3.5.5 5 4 3.5 7.5C19 16.65 12 21 12 21z'],
  },
  {
    href: getRelativeLocaleUrl(locale, 'clinical'),
    cat: '임상시험·연구',
    desc: '국내외에서 모집 중인 임상시험과 최신 연구 결과를 한 곳에서 확인하세요.',
    icon: ['M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2', 'M8 2h8v4H8z'],
  },
  {
    href: getRelativeLocaleUrl(locale, 'exercise'),
    cat: '운동 영상',
    desc: '걷기·균형·스트레칭까지 — 공식 기관이 만든 파킨슨병 맞춤 운동 영상을 모았습니다.',
    icon: ['M22 12h-4l-3 9L9 3l-3 9H2'],
  },
  {
    href: getRelativeLocaleUrl(locale, 'institutions'),
    cat: '제도·지원',
    desc: '희귀질환 산정특례부터 장애등록, 장기요양등급, 의료비 세금공제까지 — 신청 자격과 절차를 항목별로 정리해뒀습니다.',
    icon: ['M3 21h18', 'M5 21V9l7-5 7 5v12', 'M9 21v-6h6v6'],
  },
];
---

<Layout title="파킨온 — 오늘의 파킨슨병 생활 정보">
  <Header />

  <section class="hero-full" style={`background-image:url(${heroImg.src});`}>
    <div class="hero-full-inner">
      <h1>파킨슨병과 함께하는 하루하루, 조금 더 수월하게</h1>
      <p>약 복용 시간부터 낙상 예방, 제도 지원까지 — 환자와 가족에게 실제로 도움되는 정보만 정리했습니다.</p>
      <div class="actions">
        <a class="btn btn-primary" href={articleHref(featured)}>오늘의 추천 글 보기</a>
        <a class="btn btn-ghost-light" href={getRelativeLocaleUrl(locale, 'lifestyle')}>생활 요령 둘러보기</a>
      </div>
    </div>
  </section>

  <div class="layout">
    <main class="col">
      <section>
        <div class="news-head">
          <h2>오늘의 파킨온 소식</h2>
        </div>
        <div class="news-layout">
          <a class="feature-card" href={articleHref(featured)}>
            <div class="thumb">
              <Image src={featured.data.hero} alt={featured.data.heroAlt} />
              <span class="tag">{tagLabel(featured)}</span>
            </div>
            <h3>{featured.data.title}</h3>
            <p class="excerpt">{featured.data.description}</p>
            <p class="meta" id="featureDate" data-template={t(locale, 'home.todayDate' as DictKey)}></p>
          </a>
          <div class="news-list">
            {
              newsRows.map((row) => (
                <a class="news-row" href={articleHref(row)}>
                  <div class="thumb">
                    <Image src={row.data.thumbnail ?? row.data.hero} alt={row.data.heroAlt} />
                  </div>
                  <div>
                    <span class:list={['tag', { alt: categoryOf(row) === 'news' }]}>{tagLabel(row)}</span>
                    <h4>{row.data.title}</h4>
                  </div>
                </a>
              ))
            }
          </div>
        </div>
      </section>

      <div class="ad-slot-mobile">
        <AdFitBanner unit="DAN-3XSXyjQZO20EXhAU" width={300} height={250} />
      </div>
      <div class="ad-slot-pc">
        <AdFitBanner unit="DAN-uNXspgUS7sxUF0Xi" width={728} height={90} />
      </div>

      <section>
        <div class="axes-head">
          <h2>둘러보기</h2>
        </div>
        <div class="axes-grid">
          {
            axisCards.map((c) => (
              <a class="axis-card" href={c.href}>
                <div class="axis-ic">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    {c.icon.map((d) => <path d={d} />)}
                  </svg>
                </div>
                <div>
                  <div class="cat">{c.cat}</div>
                  <p class="desc">{c.desc}</p>
                  <div class="go">자세히 보기 →</div>
                </div>
              </a>
            ))
          }
        </div>
      </section>

      <section class="cta">
        <div class="cta-text">
          <h2>언제 어디서나, 파킨온 앱으로 관리하세요</h2>
          <p>손끝에서 관리하는 하루 기록과 알림 서비스. 큰 글씨와 명확한 디자인으로 시니어도 쉽게 사용할 수 있습니다.</p>
          <div class="store-badges">
            <a class="store-badge" href={PLAY_STORE_URL} target="_blank" rel="noopener">
              <svg class="icon" viewBox="0 0 24 24" fill="#fff"><polygon points="5,3 5,21 20,12"></polygon></svg>
              <span class="big">Google Play</span>
            </a>
            <a class="store-badge" href={appleStoreUrl(locale)} target="_blank" rel="noopener">
              <svg class="icon" viewBox="0 0 384 512" fill="#fff"
                ><path
                  d="M318 268c-1-56 46-83 48-84-26-38-67-43-81-44-34-3-67 20-84 20-18 0-44-20-73-19-37 1-72 22-91 55-39 68-10 168 28 223 19 27 41 57 71 56 28-1 39-18 74-18 34 0 45 18 74 18 31-1 50-27 69-54 22-31 31-61 31-63-1 0-59-23-60-90zM258 63c16-19 27-46 24-73-23 1-51 15-68 34-15 17-28 44-25 70 26 2 53-13 69-31z"
                ></path></svg
              >
              <span class="big">App Store</span>
            </a>
          </div>
          <div class="feature-list">
            {
              featureList.map((f) => (
                <div>
                  <div class="f-head">
                    <span class="f-emoji">{f.emoji}</span>
                    <b>{f.title}</b>
                  </div>
                  <p class="f-desc" set:html={f.desc} />
                </div>
              ))
            }
          </div>
          <button type="button" class="app-preview-toggle" id="appPreviewToggle" aria-expanded="false" aria-controls="appPreviewPanel">
            <span>앱화면 보기</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"></path></svg>
          </button>
          <div class="app-preview-panel" id="appPreviewPanel">
            <div class="app-shots">
              {
                appShots.map((s) => (
                  <div class="shot">
                    <div class="shot-cap">{s.cap}</div>
                    <Image src={s.img} alt={s.alt} />
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </section>
    </main>

    <aside class="ad-rail right">
      <AdFitBanner unit="DAN-gNuNjB3TJiRLLR61" width={160} height={600} />
    </aside>
  </div>

  <Footer />
</Layout>

<style>
  .ad-slot-mobile {
    display: block;
  }
  .ad-slot-pc {
    display: none;
  }
  @media (min-width: 1280px) {
    .ad-slot-mobile {
      display: none;
    }
    .ad-slot-pc {
      display: block;
    }
  }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border-radius: 8px;
    padding: 0 22px;
    font-weight: 800;
    font-size: 14px;
    white-space: nowrap;
    height: 42px;
    transition: opacity 0.15s;
  }
  .btn:hover {
    opacity: 0.88;
  }
  .btn-primary {
    background: var(--primary);
    color: #fff;
  }
  .btn-ghost-light {
    background: rgba(255, 255, 255, 0.16);
    color: #fff;
    border: 1.5px solid rgba(255, 255, 255, 0.55);
  }

  .hero-full {
    position: relative;
    width: 100%;
    min-height: 460px;
    display: flex;
    align-items: flex-end;
    background-size: cover;
    background-position: center;
    background-color: var(--surface-low);
  }
  .hero-full::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(10, 20, 12, 0.78), rgba(10, 20, 12, 0.15) 55%, rgba(10, 20, 12, 0) 80%);
  }
  .hero-full-inner {
    position: relative;
    z-index: 1;
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 var(--gutter) 52px;
    width: 100%;
    box-sizing: border-box;
  }
  .hero-full-inner h1 {
    font-size: 42px;
    font-weight: 800;
    color: #fff;
    line-height: 1.22;
    letter-spacing: -0.015em;
    max-width: 16ch;
  }
  .hero-full-inner p {
    margin-top: 16px;
    font-size: 16px;
    color: rgba(255, 255, 255, 0.92);
    max-width: 46ch;
    line-height: 1.65;
  }
  .hero-full-inner .actions {
    display: flex;
    gap: 10px;
    margin-top: 24px;
    flex-wrap: wrap;
  }
  .hero-full-inner .actions .btn {
    height: 46px;
    padding: 0 24px;
  }
  @media (max-width: 640px) {
    .hero-full {
      min-height: 400px;
    }
    .hero-full-inner h1 {
      font-size: 30px;
      max-width: 14ch;
    }
  }

  .news-head {
    margin-bottom: 20px;
  }
  .news-head h2 {
    font-size: 24px;
    color: var(--text);
  }
  .news-layout {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 28px;
    margin-bottom: 56px;
  }
  @media (max-width: 900px) {
    .news-layout {
      grid-template-columns: 1fr;
    }
  }

  .feature-card {
    display: block;
  }
  .feature-card :global(.thumb) {
    position: relative;
    border-radius: 8px;
    overflow: hidden;
    aspect-ratio: 16 / 10;
  }
  .feature-card :global(.thumb img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .feature-card .tag {
    position: absolute;
    top: 14px;
    left: 14px;
    background: #fff;
    color: var(--tertiary-dark);
    font-size: 11.5px;
    font-weight: 800;
    padding: 5px 12px;
    border-radius: 4px;
    letter-spacing: 0.02em;
  }
  .feature-card h3 {
    font-size: 24px;
    margin-top: 16px;
    color: var(--text);
    line-height: 1.4;
    letter-spacing: -0.005em;
  }
  .feature-card .excerpt {
    margin-top: 8px;
    font-size: 14.5px;
    color: var(--text-sub);
    line-height: 1.65;
    max-width: 56ch;
  }
  .feature-card .meta {
    margin-top: 12px;
    font-size: 12.5px;
    color: var(--text-sub);
    opacity: 0.8;
  }
  .news-list {
    display: flex;
    flex-direction: column;
  }
  .news-row {
    display: grid;
    grid-template-columns: 104px 1fr;
    gap: 16px;
    padding: 16px 0;
    border-bottom: 1px solid var(--outline);
  }
  .news-row:first-child {
    padding-top: 0;
  }
  .news-row:last-child {
    border-bottom: none;
  }
  .news-row :global(.thumb) {
    width: 104px;
    height: 78px;
    border-radius: 6px;
    overflow: hidden;
    flex-shrink: 0;
  }
  .news-row :global(.thumb img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .news-row .tag {
    font-size: 11px;
    font-weight: 800;
    color: var(--tertiary-dark);
    display: block;
    margin-bottom: 6px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .news-row h4 {
    font-size: 15px;
    line-height: 1.4;
    color: var(--text);
  }

  .axes-head {
    margin-bottom: 18px;
  }
  .axes-head h2 {
    font-size: 24px;
    color: var(--text);
  }
  .axes-grid {
    display: grid;
    /* 5개 카드라 2열은 마지막 줄이 1개만 남아 비대칭이 된다(2026-08-10, 5개로 늘어남) —
       3열로 3+2 로 나눠 덜 어색하게 한다. */
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-bottom: 56px;
  }
  @media (max-width: 1000px) {
    .axes-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 640px) {
    .axes-grid {
      grid-template-columns: 1fr;
    }
  }
  .axis-card {
    background: var(--surface);
    border: 1px solid var(--outline);
    border-radius: 8px;
    padding: 24px;
    display: flex;
    flex-direction: column;
