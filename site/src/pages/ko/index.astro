---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import AdBox from '../../components/AdBox.astro';

import heroImg from '../../assets/images/hero.jpg';
import pathImg from '../../assets/images/path.jpg';
import foodImg from '../../assets/images/food.jpg';
import yogaImg from '../../assets/images/yoga.jpg';
import sleepImg from '../../assets/images/sleep.jpg';
import familyImg from '../../assets/images/family.jpg';
import labImg from '../../assets/images/lab.jpg';

import shot1 from '../../assets/images/appshots/parkinon1.png';
import shot2 from '../../assets/images/appshots/parkinon2.png';
import shot3 from '../../assets/images/appshots/parkinon3.png';
import shot4 from '../../assets/images/appshots/parkinon4.png';
import shot5 from '../../assets/images/appshots/parkinon5.png';
import shot6 from '../../assets/images/appshots/parkinon6.png';
import shot7 from '../../assets/images/appshots/parkinon7.png';
import shot8 from '../../assets/images/appshots/parkinon8.png';
import shotEtc from '../../assets/images/appshots/parkinon_etc.png';

import { PLAY_STORE_URL, appleStoreUrl } from '../../lib/links';
const locale = Astro.currentLocale ?? 'ko';

const appShots = [
  { img: shot1, cap: '약 복용 기록', alt: '파킨온 앱 - 약복용 기록 화면' },
  { img: shot2, cap: '몸상태·기분 기록', alt: '파킨온 앱 - 몸상태·기분상태 기록 화면' },
  { img: shot3, cap: '운동 기록', alt: '파킨온 앱 - 운동 기록 화면' },
  { img: shot4, cap: '기록·관리', alt: '파킨온 앱 - 기록·관리 화면' },
  { img: shot5, cap: '복용약 등록·관리', alt: '파킨온 앱 - 복용약 등록·관리 화면' },
  { img: shot6, cap: '가족 연동', alt: '파킨온 앱 - 가족 연동 화면' },
  { img: shot7, cap: '복용시간 설정·알림', alt: '파킨온 앱 - 복용시간 설정·알림 화면' },
  { img: shot8, cap: '가족 일기', alt: '파킨온 앱 - 가족 일기 화면' },
  { img: shotEtc, cap: '정보·나눔 커뮤니티', alt: '파킨온 앱 - 정보·나눔 커뮤니티 화면' },
];

const featureList = [
  {
    emoji: '💊',
    title: '약 복용 기록',
    desc: '약 먹을 시간을 알림으로 챙겨드려요.<br/>드셨는지 체크만 하면 자동으로 기록이 쌓여요.',
  },
  {
    emoji: '😊',
    title: '몸상태·기분 기록',
    desc: '복용 후 몸상태, 기분상태를 복용약의 기준에 맞게 측정할 수 있어요.<br/>약효 추적 기록이 쌓이면 복용약 조절하는 데 보조지표가 될 수 있어요.',
  },
  {
    emoji: '🏃',
    title: '운동 기록',
    desc: '오늘 한 운동을 기록하면 꾸준히 이어갈 힘이 돼요.<br/>보호자도 얼마나 움직이셨는지 함께 확인할 수 있어요.',
  },
  {
    emoji: '👨‍👩‍👧',
    title: '가족 연동',
    desc: '환자가 기록하면 보호자에게도 알림이 가요.<br/>보호자는 환자의 복약 여부와 몸/기분 상태를 알 수 있어서 세심하게 도울 수 있어요.<br/>멀리 떨어져 지내도 환자의 상태를 알 수 있어서 안심이 돼요.',
  },
  {
    emoji: '📔',
    title: '가족 일기',
    desc: '하루의 소회를 짧게 남기면 나중에 E-Book으로 만들어 드려요.<br/>보호자도 함께 일기에 동참해서 서로 응원하면서 이겨낼 수 있어요.',
  },
  {
    emoji: '📋',
    title: '기록·관리',
    desc: '모든 기록을 한번에 볼 수 있어요.<br/>입력한 기록들을 그래프로 보여줘서 트렌드를 볼 수 있어요.',
  },
];

const newsRows = [
  { img: foodImg, tag: '생활 요령 · 식사', title: '파킨슨병 환자를 위한 식단 관리 기본', alt: '비빔밥과 여러 반찬이 차려진 한 상' },
  { img: yogaImg, tag: '생활 요령 · 운동', title: '보행 개선을 위한 하루 10분 스트레칭 습관', alt: '햇살 아래 돌돌 말아 세워둔 요가매트 두 개' },
  { img: sleepImg, tag: '생활 요령 · 수면', title: '숙면을 방해하는 습관, 무엇을 바꿔야 할까요', alt: '아침 햇살이 비치는 정돈된 침구' },
  { img: familyImg, tag: '생활 요령 · 보호자', title: '보호자의 번아웃, 혼자 견디지 마세요', alt: '담요와 머그컵 두 개가 놓인 아늑한 소파' },
  { img: labImg, tag: '파킨온 소식', title: '[파킨온 소식] 최근 발표된 연구, 쉽게 정리했습니다', alt: '실험실 시험관 랙', altTag: true },
];
---

<Layout title="파킨온 — 오늘의 파킨슨병 생활 정보">
  <Header />

  <section class="hero-full" style={`background-image:url(${heroImg.src});`}>
    <div class="hero-full-inner">
      <h1>파킨슨병과 함께하는 하루하루, 조금 더 수월하게</h1>
      <p>약 복용 시간부터 낙상 예방, 제도 지원까지 — 환자와 가족에게 실제로 도움되는 정보만 정리했습니다.</p>
      <div class="actions">
        <button class="btn btn-primary">오늘의 추천 글 보기</button>
        <a class="btn btn-ghost-light" href={getRelativeLocaleUrl(locale, 'lifestyle')}>생활 요령 둘러보기</a>
      </div>
    </div>
  </section>

  <div class="layout">
    <aside class="ad-rail left">
      <AdBox minHeight="600px" />
    </aside>

    <main class="col">
      <section>
        <div class="news-head">
          <h2>오늘의 파킨온 소식</h2>
          <span class="today" id="todayLabel"></span>
        </div>
        <div class="news-layout">
          <article class="feature-card">
            <div class="thumb">
              <Image src={pathImg} alt="낙엽이 깔린 가을 산책로" />
              <span class="tag">생활 요령 · 낙상 예방</span>
            </div>
            <h3>친구와 함께 걷는 것만으로도 낙상 위험이 줄어듭니다</h3>
            <p class="excerpt">
              혼자보다 둘, 셋이 걸을 때 보폭과 균형을 더 잘 챙기게 됩니다. 안전한 동행 산책을 위한 실전 팁을 정리했습니다.
            </p>
            <p class="meta" id="featureDate"></p>
            <button type="button" class="feature-toggle" id="featureToggle" aria-expanded="false" aria-controls="featureFull">
              <span>내용 전체 보기</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"></path></svg>
            </button>
            <div class="feature-full" id="featureFull">
              <p>
                파킨슨병 환자는 혼자 걸을 때 보폭이 좁아지고 팔 흔들림이 줄어드는 경향이 있습니다. 반면 동행이 있으면
                자연스럽게 속도를 맞추고 자세를 의식하게 되어 보행의 질이 개선된다는 보고가 있습니다.
              </p>
              <p>
                동행 산책 시에는 환자보다 반걸음 뒤, 계단이나 턱이 있는 방향에서 걷는 것이 좋습니다. 갑자기 방향을 트는
                대신 미리 말로 알려주면 예기치 못한 회전 동작으로 인한 낙상을 줄일 수 있습니다.
              </p>
              <p>
                산책로는 평탄하고 조명이 밝은 길을 우선으로 고르고, 약효가 안정적인 시간대를 택하는 것이 안전합니다.
                걷다가 어지러움이나 다리 힘 빠짐이 느껴지면 즉시 앉아서 쉬도록 서로 확인하는 습관을 들이세요.
              </p>
            </div>
          </article>
          <div class="news-list">
            {
              newsRows.map((row) => (
                <a class="news-row" href="#">
                  <div class="thumb">
                    <Image src={row.img} alt={row.alt} />
                  </div>
                  <div>
                    <span class:list={['tag', { alt: row.altTag }]}>{row.tag}</span>
                    <h4>{row.title}</h4>
                  </div>
                </a>
              ))
            }
          </div>
        </div>
      </section>

      <section>
        <div class="axes-head">
          <h2>둘러보기</h2>
        </div>
        <div class="axes-grid">
          <a class="axis-card" href={getRelativeLocaleUrl(locale, 'institutions')}>
            <div class="axis-ic">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"
                ><path d="M3 21h18"></path><path d="M5 21V9l7-5 7 5v12"></path><path d="M9 21v-6h6v6"></path></svg
              >
            </div>
            <div>
              <div class="cat">제도·지원</div>
              <p class="desc">
                희귀질환 산정특례부터 장애등록, 장기요양등급, 의료비 세금공제까지 — 신청 자격과 절차를 항목별로
                정리해뒀습니다.
              </p>
              <div class="go">자세히 보기 →</div>
            </div>
          </a>
          <a class="axis-card" href={getRelativeLocaleUrl(locale, 'lifestyle')}>
            <div class="axis-ic">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"
                ><path
                  d="M12 21s-7-4.35-9.5-8.5C1 9 2.5 5.5 6 5c2-.3 3.5.8 6 3.5C14.5 5.8 16 4.7 18 5c3.5.5 5 4 3.5 7.5C19 16.65 12 21 12 21z"
                ></path></svg
              >
            </div>
            <div>
              <div class="cat">생활 요령</div>
              <p class="desc">
                낙상 예방, 식단·수면 관리부터 마음 건강, 보호자 번아웃 대처법까지 — 매일의 어려움을 덜어줄 실전 정보를
                모았습니다.
              </p>
              <div class="go">자세히 보기 →</div>
            </div>
          </a>
        </div>
      </section>

      <section class="home-ad">
        <AdBox minHeight="110px" label="Advertisement · 광고 영역" />
      </section>

      <section class="cta">
        <div class="cta-text">
          <h2>언제 어디서나, 파킨온 앱으로 관리하세요</h2>
          <p>손끝에서 관리하는 하루 기록과 알림 서비스. 큰 글씨와 명확한 디자인으로 시니어도 쉽게 사용할 수 있습니다.</p>
          <div class="store-badges">
            <a class="store-badge" href={PLAY_STORE_URL} target="_blank" rel="noopener">
              <svg class="icon" viewBox="0 0 24 24" fill="#fff"><polygon points="5,3 5,21 20,12"></polygon></svg>
              <span class="big">Google Play</span>
            </a>
            <a class="store-badge" href={appleStoreUrl(locale)} target="_blank" rel="noopener">
              <svg class="icon" viewBox="0 0 384 512" fill="#fff"
                ><path
                  d="M318 268c-1-56 46-83 48-84-26-38-67-43-81-44-34-3-67 20-84 20-18 0-44-20-73-19-37 1-72 22-91 55-39 68-10 168 28 223 19 27 41 57 71 56 28-1 39-18 74-18 34 0 45 18 74 18 31-1 50-27 69-54 22-31 31-61 31-63-1 0-59-23-60-90zM258 63c16-19 27-46 24-73-23 1-51 15-68 34-15 17-28 44-25 70 26 2 53-13 69-31z"
                ></path></svg
              >
              <span class="big">App Store</span>
            </a>
          </div>
          <div class="feature-list">
            {
              featureList.map((f) => (
                <div>
                  <div class="f-head">
                    <span class="f-emoji">{f.emoji}</span>
                    <b>{f.title}</b>
                  </div>
                  <p class="f-desc" set:html={f.desc} />
                </div>
              ))
            }
          </div>
          <button type="button" class="app-preview-toggle" id="appPreviewToggle" aria-expanded="false" aria-controls="appPreviewPanel">
            <span>앱화면 보기</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"></path></svg>
          </button>
          <div class="app-preview-panel" id="appPreviewPanel">
            <div class="app-shots">
              {
                appShots.map((s) => (
                  <div class="shot">
                    <div class="shot-cap">{s.cap}</div>
                    <Image src={s.img} alt={s.alt} />
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </section>
    </main>

    <aside class="ad-rail right">
      <AdBox minHeight="600px" />
    </aside>
  </div>

  <Footer />
</Layout>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border-radius: 8px;
    padding: 0 22px;
    font-weight: 800;
    font-size: 14px;
    white-space: nowrap;
    height: 42px;
    transition: opacity 0.15s;
  }
  .btn:hover {
    opacity: 0.88;
  }
  .btn-primary {
    background: var(--primary);
    color: #fff;
  }
  .btn-ghost-light {
    background: rgba(255, 255, 255, 0.16);
    color: #fff;
    border: 1.5px solid rgba(255, 255, 255, 0.55);
  }

  .hero-full {
    position: relative;
    width: 100%;
    min-height: 460px;
    display: flex;
    align-items: flex-end;
    background-size: cover;
    background-position: center;
    background-color: var(--surface-low);
  }
  .hero-full::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(10, 20, 12, 0.78), rgba(10, 20, 12, 0.15) 55%, rgba(10, 20, 12, 0) 80%);
  }
  .hero-full-inner {
    position: relative;
    z-index: 1;
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 var(--gutter) 52px;
    width: 100%;
    box-sizing: border-box;
  }
  .hero-full-inner h1 {
    font-size: 42px;
    font-weight: 800;
    color: #fff;
    line-height: 1.22;
    letter-spacing: -0.015em;
    max-width: 16ch;
  }
  .hero-full-inner p {
    margin-top: 16px;
    font-size: 16px;
    color: rgba(255, 255, 255, 0.92);
    max-width: 46ch;
    line-height: 1.65;
  }
  .hero-full-inner .actions {
    display: flex;
    gap: 10px;
    margin-top: 24px;
    flex-wrap: wrap;
  }
  .hero-full-inner .actions .btn {
    height: 46px;
    padding: 0 24px;
  }
  @media (max-width: 640px) {
    .hero-full {
      min-height: 400px;
    }
    .hero-full-inner h1 {
      font-size: 30px;
      max-width: 14ch;
    }
  }

  .news-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 20px;
  }
  .news-head h2 {
    font-size: 24px;
    color: var(--text);
  }
  .news-head .today {
    font-size: 13px;
    color: var(--text-sub);
    font-weight: 600;
  }
  .news-layout {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 28px;
    margin-bottom: 56px;
  }
  @media (max-width: 900px) {
    .news-layout {
      grid-template-columns: 1fr;
    }
  }

  .feature-card {
    display: block;
  }
  .feature-card :global(.thumb) {
    position: relative;
    border-radius: 8px;
    overflow: hidden;
    aspect-ratio: 16 / 10;
  }
  .feature-card :global(.thumb img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .feature-card .tag {
    position: absolute;
    top: 14px;
    left: 14px;
    background: #fff;
    color: var(--tertiary-dark);
    font-size: 11.5px;
    font-weight: 800;
    padding: 5px 12px;
    border-radius: 4px;
    letter-spacing: 0.02em;
  }
  .feature-card h3 {
    font-size: 24px;
    margin-top: 16px;
    color: var(--text);
    line-height: 1.4;
    letter-spacing: -0.005em;
  }
  .feature-card .excerpt {
    margin-top: 8px;
    font-size: 14.5px;
    color: var(--text-sub);
    line-height: 1.65;
    max-width: 56ch;
  }
  .feature-card .meta {
    margin-top: 12px;
    font-size: 12.5px;
    color: var(--text-sub);
    opacity: 0.8;
  }
  .feature-toggle {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 14px;
    font-size: 13.5px;
    font-weight: 700;
    color: var(--primary);
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
  }
  .feature-toggle svg {
    width: 14px;
    height: 14px;
    transition: transform 0.2s;
  }
  .feature-toggle[aria-expanded='true'] svg {
    transform: rotate(180deg);
  }
  .feature-full {
    overflow: hidden;
    max-height: 0;
    transition: max-height 0.35s ease;
  }
  .feature-full.open {
    max-height: 640px;
    margin-top: 2px;
  }
  .feature-full :global(p) {
    margin-top: 12px;
    font-size: 14.5px;
    color: var(--text-sub);
    line-height: 1.7;
    max-width: 58ch;
  }

  .news-list {
    display: flex;
    flex-direction: column;
  }
  .news-row {
    display: grid;
    grid-template-columns: 104px 1fr;
    gap: 16px;
    padding: 16px 0;
    border-bottom: 1px solid var(--outline);
  }
  .news-row:first-child {
    padding-top: 0;
  }
  .news-row:last-child {
    border-bottom: none;
  }
  .news-row :global(.thumb) {
    width: 104px;
    height: 78px;
    border-radius: 6px;
    overflow: hidden;
    flex-shrink: 0;
  }
  .news-row :global(.thumb img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .news-row .tag {
    font-size: 11px;
    font-weight: 800;
    color: var(--tertiary-dark);
    display: block;
    margin-bottom: 6px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .news-row h4 {
    font-size: 15px;
    line-height: 1.4;
    color: var(--text);
  }

  .axes-head {
    margin-bottom: 18px;
  }
  .axes-head h2 {
    font-size: 24px;
    color: var(--text);
  }
  .axes-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    margin-bottom: 56px;
  }
  @media (max-width: 760px) {
    .axes-grid {
      grid-template-columns: 1fr;
    }
  }
  .axis-card {
    background: var(--surface);
    border: 1px solid var(--outline);
