<script>
  const today = new Date();
  const label = `${today.getMonth() + 1}월 ${today.getDate()}일의 추천`;
  document.getElementById('todayLabel')!.textContent = label;

  const pad = (n: number) => (n < 10 ? '0' + n : '' + n);
  document.getElementById('featureDate')!.textContent =
    `오늘 · ${today.getFullYear()}.${pad(today.getMonth() + 1)}.${pad(today.getDate())}`;

  const featureToggle = document.getElementById('featureToggle')!;
  const featureFull = document.getElementById('featureFull')!;
  featureToggle.addEventListener('click', () => {
    const open = featureFull.classList.toggle('open');
    featureToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    featureToggle.querySelector('span')!.textContent = open ? '접기' : '내용 전체 보기';
  });

  const appPreviewToggle = document.getElementById('appPreviewToggle')!;
  const appPreviewPanel = document.getElementById('appPreviewPanel')!;
  appPreviewToggle.addEventListener('click', () => {
    const open = appPreviewPanel.classList.toggle('open');
    appPreviewToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
  });
</script>
