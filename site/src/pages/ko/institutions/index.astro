---
import { getCollection } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import AdBox from '../../../components/AdBox.astro';
import ArticleSide from '../../../components/ArticleSide.astro';
import { slugOf, formatDate, sortByDateDesc } from '../../../lib/articles';
import familyImg from '../../../assets/images/family.jpg';

const locale = Astro.currentLocale ?? 'ko';

const tabs = ['전체', '산정특례', '장애등록', '장기요양', '의료비 공제', '보조기기'];

/*
 * 목록은 **글 파일에서 자동으로** 만든다. 손으로 배열을 적지 말 것 —
 * 예전에는 글을 하나 추가할 때 글 페이지·허브 목록·사이드 패널 세 군데를 고쳐야 했고,
 * 하나만 빠뜨려도 링크가 죽었다. (website-plan.md "글 저장 방식과 발행 흐름")
 */
const posts = sortByDateDesc(
  await getCollection('articles', ({ data, id }) => !data.draft && id.startsWith('institutions/'))
);

// 광고: 글 6개마다 한 줄(광고 상세 확정 사항). 글이 적으면 자연히 안 나온다.
type Row = { ad: true } | { ad?: false; post: (typeof posts)[number] };
const rows: Row[] = [];
posts.forEach((post, i) => {
  if (i > 0 && i % 6 === 0) rows.push({ ad: true });
  rows.push({ post });
});

const sideLinks = posts.slice(0, 6).map((e) => ({
  title: e.data.title,
  date: formatDate(e.data.publishedAt),
  href: getRelativeLocaleUrl(locale, `institutions/${slugOf(e)}`),
}));

---

<Layout
  title="제도·지원 — 파킨온"
  breadcrumbs={[
    { name: '홈', path: '/ko/' },
    { name: '제도·지원', path: '/ko/institutions/' },
  ]}
>
  <Header active="institutions" />

  <div class="layout">
    <aside class="ad-rail left">
      <AdBox minHeight="600px" />
    </aside>

    <main class="col">
      <section class="hub-hero-full" style={`background-image:url(${familyImg.src});`}>
        <div class="hub-hero-full-inner">
          <h1>제도·지원</h1>
          <p>
            파킨슨병 환자와 가족이 받을 수 있는 국가 지원 제도를 정리했습니다. 산정특례부터 장애등록, 장기요양등급,
            의료비 세금공제, 보조기기 지원까지 — 신청 자격과 절차를 확인하세요.
          </p>
        </div>
      </section>

      <nav class="breadcrumb">
        <a href={getRelativeLocaleUrl(locale, '')}>홈</a><span class="sep">/</span><span>제도·지원</span>
      </nav>

      <div class="hub-tabs">
        {tabs.map((t, i) => <a class:list={['tab', { active: i === 0 }]} href="#">{t}</a>)}
      </div>

      <div class="content-body">
        <div class="hub-list">
          {
            rows.map((row) =>
              row.ad ? (
                <div class="native-ad-row">
                  <span class="ad-label">광고</span>
                  <AdBox minHeight="90px" />
                </div>
              ) : (
                <a class="hub-row" href={getRelativeLocaleUrl(locale, `institutions/${slugOf(row.post)}`)}>
                  <span class="tag">{row.post.data.tag}</span>
                  <h3>{row.post.data.title}</h3>
                  <p>{row.post.data.description}</p>
                  <div class="hashtags">
                    {row.post.data.hashtags.map((h) => <span>{h}</span>)}
                  </div>
                  <p class="meta">{formatDate(row.post.data.publishedAt)}</p>
                </a>
              )
            )
          }
        </div>

        <ArticleSide links={sideLinks} linksTitle="제도·지원 다른 글" />
      </div>

    </main>

    <aside class="ad-rail right">
      <AdBox minHeight="600px" />
    </aside>
  </div>

  <Footer />
</Layout>

<style>
  .breadcrumb {
    font-size: 13px;
    color: var(--text-sub);
    margin-bottom: 18px;
  }
  .breadcrumb a:hover {
    color: var(--primary);
  }
  .breadcrumb .sep {
    margin: 0 6px;
    opacity: 0.6;
  }
  .hub-hero-full {
    position: relative;
    width: auto;
    margin: -28px calc(-1 * var(--gutter)) 24px;
    min-height: 240px;
    display: flex;
    /*
     * 위쪽 정렬 + 고정 padding-top 으로 제목 시작 위치를 못박는다(오너 지적 2026-08-06).
     * 아래쪽 정렬이면 설명이 몇 줄이냐에 따라 제목이 24px 씩 위아래로 움직여서
     * 허브 3개의 제목 높이가 서로 안 맞는다(제도·지원만 3줄이라 혼자 올라가 있었다).
     * 114px = 기존 2줄 화면의 제목 위치 그대로. 설명이 길어지면 아래로 늘어난다.
     */
    align-items: flex-start;
    background-size: cover;
    background-position: center;
    background-color: var(--surface-low);
  }
  .hub-hero-full::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(10, 20, 12, 0.75), rgba(10, 20, 12, 0.12) 60%, rgba(10, 20, 12, 0) 85%);
  }
  .hub-hero-full-inner {
    position: relative;
    z-index: 1;
    padding: 114px var(--gutter) 28px;
    width: 100%;
    box-sizing: border-box;
  }
  .hub-hero-full-inner h1 {
    font-size: 32px;
    font-weight: 800;
    color: #fff;
    line-height: 1.25;
  }
  .hub-hero-full-inner p {
    margin-top: 10px;
    font-size: 15px;
    color: rgba(255, 255, 255, 0.92);
    /*
     * 폭·최소높이는 허브 3개의 제목 시작 위치를 맞추려고 정한 값이다(오너 지적 2026-08-06).
     * 히어로는 아래쪽 정렬이라 설명이 3줄이 되면 제목만 24px 위로 올라간다.
     * 실측: 최대폭 560~719px 구간에서 세 페이지 설명이 모두 2줄 → 가운데값 640px 채택.
     * (500px 이면 제도·지원만 3줄, 720px 이면 생활 요령만 1줄이 되어 다시 어긋난다.)
     * min-height 는 앞으로 짧은 문구가 들어와도 2줄 자리를 유지시키는 안전장치.
     */
    max-width: 640px;
    line-height: 1.6;
    /*
     * 설명 영역 높이를 고정한다 — 메뉴를 옮겨 다닐 때 히어로 높이가 들쭉날쭉하면
     * 눈에 거슬린다는 오너 지적(2026-08-06). 줄 수는 폭·페이지마다 2~4줄로 갈리므로
     * 그 구간의 최대값만큼 자리를 미리 잡아 둔다(데스크톱 2줄=48px, 640px 이하 4줄=96px).
     * 실측 근거: 640px 초과에서는 세 페이지 모두 2줄, 320~430px 구간 최대 4줄.
     */
    height: 48px;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }
  @media (max-width: 640px) {
    /* 224px = padding 58 + 제목 32 + 여백 10 + 설명 4줄 96 + padding 28 */
    .hub-hero-full {
      min-height: 224px;
    }
    /* 모바일도 같은 이유로 고정. 58px = 기존 3줄 화면의 제목 위치 그대로 */
    .hub-hero-full-inner {
      padding-top: 58px;
    }
    .hub-hero-full-inner h1 {
      font-size: 26px;
    }
    .hub-hero-full-inner p {
      height: 96px;
      -webkit-line-clamp: 4;
    }
  }
  .hub-tabs {
    display: flex;
    gap: 6px;
    overflow-x: auto;
    border-bottom: 1px solid var(--outline);
    margin-bottom: 32px;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .hub-tabs::-webkit-scrollbar {
    display: none;
  }
  .tab {
    flex: 0 0 auto;
    font-size: 15px;
    font-weight: 700;
    color: var(--text-sub);
    padding: 12px 14px;
    border-bottom: 2.5px solid transparent;
    white-space: nowrap;
  }
  .tab.active {
    color: var(--primary);
    border-color: var(--primary);
  }
  .hub-list {
    display: flex;
    flex-direction: column;
  }
  .hub-row {
    display: block;
    padding: 24px 0;
    border-bottom: 1px solid var(--outline);
  }
  .hub-row:first-child {
    padding-top: 0;
  }
  .hub-row .tag {
    font-size: 11px;
    font-weight: 800;
    color: var(--primary);
    display: block;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .hub-row h3 {
    font-size: 18.5px;
    margin-top: 10px;
    color: var(--text);
    line-height: 1.4;
  }
  .hub-row p {
    margin-top: 6px;
    font-size: 14px;
    line-height: 1.65;
    color: var(--text-sub);
    max-width: 70ch;
  }
  .hub-row .meta {
    margin-top: 10px;
    font-size: 12px;
    color: var(--text-sub);
    opacity: 0.75;
  }
  .hashtags {
    margin-top: 8px;
    font-size: 12px;
    color: var(--text-sub);
    opacity: 0.7;
  }
  .hashtags span {
    margin-right: 7px;
  }
  .native-ad-row {
    padding: 24px 0;
    border-bottom: 1px solid var(--outline);
  }
  .native-ad-row .ad-label {
    font-size: 11px;
    font-weight: 800;
    color: var(--text-sub);
    background: var(--surface-high);
    padding: 3px 11px;
    border-radius: 4px;
    display: inline-block;
    margin-bottom: 10px;
  }
  .hub-more {
    display: flex;
    justify-content: center;
    margin-top: 36px;
  }
  .hub-more .btn {
    height: 48px;
    padding: 0 28px;
    background: var(--surface-low);
    color: var(--text);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    font-weight: 800;
    font-size: 14px;
  }
</style>
