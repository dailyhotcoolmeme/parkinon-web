---
// 도구 메뉴는 내비게이션(톱바·푸터·홈 "둘러보기")에서 의도적으로 숨겨져 있다.
// 2026-08-04 오너 지시: "도구 메뉴는 그냥 일단 숨겨놔라" — 페이지 자체는 지우지 않는다.
import { getRelativeLocaleUrl } from 'astro:i18n';
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import AdBox from '../../../components/AdBox.astro';

const locale = Astro.currentLocale ?? 'ko';

const tools = [
  {
    title: '복약 시간표 만들기',
    desc: '드시는 약과 시간을 입력하면 한눈에 보는 시간표를 만들어 인쇄까지 할 수 있습니다.',
    go: '만들기 시작 →',
    href: getRelativeLocaleUrl(locale, 'tools/medication-schedule'),
    icon: '<rect x="3" y="9" width="18" height="6" rx="3"/><line x1="12" y1="9" x2="12" y2="15"/>',
  },
  {
    title: '진료 전 질문 체크리스트',
    desc: '짧은 진료 시간에 놓치기 쉬운 질문들을 미리 정리해서 체크하며 물어볼 수 있습니다.',
    go: '만들기 시작 →',
    icon: '<path d="M9 6h11M9 12h11M9 18h11"/><path d="M4 6l1 1 2-2M4 12l1 1 2-2M4 18l1 1 2-2"/>',
  },
  {
    title: '기록 서식 다운로드',
    desc: '증상·복용·컨디션을 손으로 적을 수 있는 기록지를 PDF로 내려받아 인쇄할 수 있습니다.',
    go: '다운로드 →',
    icon: '<path d="M14 3H6a1 1 0 0 0-1 1v16a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V8z"/><path d="M14 3v5h5"/><path d="M12 12v6M9.5 15.5 12 18l2.5-2.5"/>',
  },
  {
    title: '낙상 위험 자가 체크리스트',
    desc: '집 안 환경과 최근 상태를 몇 가지 질문으로 점검해 낙상 위험도를 확인해봅니다.',
    go: '체크 시작 →',
    icon: '<circle cx="12" cy="4.5" r="1.8"/><path d="M12 8v5M12 13l-3 6M12 13l3 6M9 11l3-1 3 1"/>',
  },
  {
    title: '🇰🇷 의료비 세액공제 간이계산기',
    desc: '1년간 쓴 의료비를 입력하면 세액공제 예상 금액을 간단히 계산해드립니다.',
    go: '계산 시작 →',
    icon: '<rect x="5" y="2.5" width="14" height="19" rx="2"/><line x1="8" y1="6.5" x2="16" y2="6.5"/><circle cx="8.3" cy="11" r=".7" fill="currentColor" stroke="none"/><circle cx="12" cy="11" r=".7" fill="currentColor" stroke="none"/><circle cx="15.7" cy="11" r=".7" fill="currentColor" stroke="none"/><circle cx="8.3" cy="14.5" r=".7" fill="currentColor" stroke="none"/><circle cx="12" cy="14.5" r=".7" fill="currentColor" stroke="none"/><circle cx="15.7" cy="14.5" r=".7" fill="currentColor" stroke="none"/><circle cx="8.3" cy="18" r=".7" fill="currentColor" stroke="none"/><line x1="12" y1="17.3" x2="12" y2="18.7"/><line x1="15" y1="18" x2="16.4" y2="18"/>',
  },
  {
    title: '여행 준비 체크리스트',
    desc: '약, 진단서, 이동 시 챙길 것까지 — 여행 전 빠뜨리기 쉬운 항목을 확인합니다.',
    go: '체크 시작 →',
    icon: '<rect x="3" y="8" width="18" height="12" rx="2"/><path d="M9 8V5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v3"/><line x1="3" y1="13" x2="21" y2="13"/>',
  },
];
---

<Layout title="도구 — 파킨온">
  <Header />

  <div class="layout">
    <aside class="ad-rail left">
      <AdBox minHeight="600px" />
    </aside>

    <main class="col">
      <nav class="breadcrumb">
        <a href={getRelativeLocaleUrl(locale, '')}>홈</a><span class="sep">/</span><span>도구</span>
      </nav>

      <div class="hub-head">
        <h1>도구</h1>
        <p>병원 갈 때, 약 챙길 때 바로 꺼내 쓸 수 있는 도구입니다. 몇 가지만 입력하면 나만의 자료가 완성됩니다.</p>
      </div>

      <div class="tool-grid">
        {
          tools.map((tool) => (
            <a class="tool-card" href={tool.href ?? '#'}>
              <div class="ic">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={tool.icon} />
              </div>
              <h3>{tool.title}</h3>
              <p>{tool.desc}</p>
              <div class="go">{tool.go}</div>
            </a>
          ))
        }
      </div>

      <section class="home-ad">
        <AdBox minHeight="110px" />
      </section>
    </main>

    <aside class="ad-rail right">
      <AdBox minHeight="600px" />
    </aside>
  </div>

  <Footer />
</Layout>

<style>
  .breadcrumb {
    font-size: 13px;
    color: var(--text-sub);
    margin-bottom: 18px;
  }
  .breadcrumb a:hover {
    color: var(--primary);
  }
  .breadcrumb .sep {
    margin: 0 6px;
    opacity: 0.6;
  }
  .hub-head {
    margin-bottom: 24px;
  }
  .hub-head h1 {
    font-size: 30px;
    color: var(--text);
    line-height: 1.3;
  }
  .hub-head p {
    margin-top: 10px;
    font-size: 15px;
    line-height: 1.65;
    color: var(--text-sub);
    max-width: 64ch;
  }
  .tool-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
    margin-top: 8px;
  }
  @media (max-width: 900px) {
    .tool-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 600px) {
    .tool-grid {
      grid-template-columns: 1fr;
    }
  }
  .tool-card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--outline);
    border-radius: 8px;
    padding: 24px;
    transition: border-color 0.15s ease;
  }
  .tool-card:hover {
    border-color: var(--primary);
  }
  .tool-card .ic {
    width: 26px;
    height: 26px;
    color: var(--primary);
  }
  .tool-card .ic svg {
    width: 100%;
    height: 100%;
  }
  .tool-card h3 {
    font-size: 17px;
    color: var(--text);
    margin-top: 16px;
  }
  .tool-card p {
    margin-top: 10px;
    font-size: 13.5px;
    color: var(--text-sub);
    line-height: 1.6;
    flex: 1;
  }
  .tool-card .go {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 16px;
    font-size: 13.5px;
    font-weight: 800;
    color: var(--primary);
  }
  .home-ad {
    margin-top: 44px;
  }
</style>
