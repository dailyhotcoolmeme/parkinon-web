---
// 도구 메뉴는 내비게이션에서 숨겨져 있다 — tools/index.astro 상단 주석 참고.
import { getRelativeLocaleUrl } from 'astro:i18n';
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import AdBox from '../../../components/AdBox.astro';

const locale = Astro.currentLocale ?? 'ko';
---

<Layout title="복약 시간표 만들기 — 파킨온">
  <Header />

  <div class="layout">
    <aside class="ad-rail left">
      <AdBox minHeight="600px" />
    </aside>

    <main class="col">
      <nav class="breadcrumb">
        <a href={getRelativeLocaleUrl(locale, '')}>홈</a><span class="sep">/</span><a href={getRelativeLocaleUrl(locale, 'tools')}>도구</a><span class="sep">/</span>
        <span>복약 시간표 만들기</span>
      </nav>

      <div class="tool-head">
        <span class="tag">도구</span>
        <h1>복약 시간표 만들기</h1>
        <p>드시는 약과 복용 시간을 입력하면 한눈에 보는 시간표가 만들어집니다. 인쇄해서 냉장고나 약통 옆에 붙여두세요.</p>
      </div>

      <div class="tool-layout">
        <div class="tool-panel form-panel">
          <h2>약 추가하기</h2>
          <div class="field">
            <label for="medName">약 이름</label>
            <input type="text" id="medName" placeholder="예) 마도파" />
          </div>
          <div class="field">
            <label>복용 시간</label>
            <div class="time-checks">
              <label class="time-check"><input type="checkbox" value="아침" /><span>아침</span></label>
              <label class="time-check"><input type="checkbox" value="점심" /><span>점심</span></label>
              <label class="time-check"><input type="checkbox" value="저녁" /><span>저녁</span></label>
              <label class="time-check"><input type="checkbox" value="취침전" /><span>취침 전</span></label>
            </div>
          </div>
          <button type="button" class="add-btn" id="addMedBtn">+ 약 추가하기</button>

          <div class="med-list" id="medList"></div>
        </div>

        <div class="tool-panel preview-panel">
          <h2>내 복약 시간표</h2>
          <div id="scheduleWrap">
            <div class="schedule-empty" id="scheduleEmpty">아직 추가한 약이 없어요. 왼쪽에서 약을 추가해보세요.</div>
            <table class="schedule-table" id="scheduleTable" style="display:none;">
              <thead>
                <tr>
                  <th style="text-align:left;">약 이름</th><th>아침</th><th>점심</th><th>저녁</th><th>취침 전</th>
                </tr>
              </thead>
              <tbody id="scheduleBody"></tbody>
            </table>
          </div>
          <button type="button" class="print-btn" id="printBtn">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"
              ><path d="M6 9V2h12v7"></path><path
                d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path><path
                d="M6 14h12v8H6z"></path></svg
            >
            인쇄하기
          </button>
        </div>
      </div>
    </main>

    <aside class="ad-rail right">
      <AdBox minHeight="600px" />
    </aside>
  </div>

  <Footer />
</Layout>

<style>
  .breadcrumb {
    font-size: 13px;
    color: var(--text-sub);
    margin-bottom: 18px;
  }
  .breadcrumb a:hover {
    color: var(--primary);
  }
  .breadcrumb .sep {
    margin: 0 6px;
    opacity: 0.6;
  }
  .tool-head {
    max-width: 820px;
  }
  .tool-head .tag {
    font-size: 12px;
    font-weight: 800;
    color: var(--primary);
    background: var(--secondary-container);
    padding: 5px 13px;
    border-radius: 4px;
    display: inline-block;
  }
  .tool-head h1 {
    font-size: 28px;
    margin-top: 14px;
    color: var(--text);
  }
  .tool-head p {
    margin-top: 10px;
    font-size: 15px;
    color: var(--text-sub);
    line-height: 1.65;
    max-width: 64ch;
  }

  .tool-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-top: 32px;
    align-items: start;
  }
  @media (max-width: 860px) {
    .tool-layout {
      grid-template-columns: 1fr;
    }
  }

  .tool-panel {
    background: var(--surface);
    border: 1px solid var(--outline);
    border-radius: 8px;
    padding: 24px;
  }
  .tool-panel h2 {
    font-size: 17px;
    color: var(--text);
    margin-bottom: 16px;
  }

  .field {
    margin-bottom: 16px;
  }
  .field label {
    display: block;
    font-size: 13px;
    font-weight: 700;
    color: var(--text-sub);
    margin-bottom: 6px;
  }
  .field input[type='text'] {
    width: 100%;
    height: 48px;
    border-radius: 12px;
    border: 1.5px solid var(--outline);
    padding: 0 14px;
    font-size: 15px;
    background: var(--bg);
    color: var(--text);
    font-family: inherit;
    box-sizing: border-box;
  }
  .field input[type='text']:focus {
    outline: none;
    border-color: var(--primary);
  }

  .time-checks {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .time-check {
    position: relative;
  }
  .time-check input {
    position: absolute;
    opacity: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    cursor: pointer;
  }
  .time-check span {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 44px;
    padding: 0 16px;
    border-radius: 8px;
    border: 1.5px solid var(--outline);
    font-size: 14px;
    font-weight: 700;
    color: var(--text-sub);
  }
  .time-check input:checked + span {
    background: var(--primary);
    border-color: var(--primary);
    color: #fff;
  }

  .add-btn {
    width: 100%;
    height: 50px;
    border-radius: 12px;
    background: var(--primary);
    color: #fff;
    font-weight: 800;
    font-size: 15px;
    margin-top: 4px;
  }

  .med-list {
    margin-top: 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .med-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 14px;
    background: var(--surface-low);
    border-radius: 12px;
    gap: 10px;
  }
  .med-item .name {
    font-weight: 700;
    font-size: 14.5px;
    color: var(--text);
  }
  .med-item .times {
    font-size: 12.5px;
    color: var(--text-sub);
    margin-top: 2px;
  }
  .med-item button {
    width: 28px;
    height: 28px;
    border-radius: 999px;
    background: var(--surface-high);
    color: var(--text-sub);
    font-size: 14px;
    flex-shrink: 0;
  }

  .schedule-table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 4px;
  }
  .schedule-table th,
  .schedule-table td {
    border: 1px solid var(--outline);
    padding: 10px 8px;
    text-align: center;
    font-size: 13px;
  }
  .schedule-table th {
    background: var(--surface-low);
    color: var(--text-sub);
    font-weight: 700;
  }
  .schedule-table :global(td.name-cell) {
    text-align: left;
    font-weight: 700;
    color: var(--text);
  }
  .schedule-table :global(td.on) {
    color: var(--primary);
    font-size: 17px;
  }
  .schedule-empty {
    padding: 32px 0;
    text-align: center;
    color: var(--text-sub);
    font-size: 14px;
  }
  .print-btn {
    width: 100%;
    height: 50px;
    border-radius: 12px;
    background: var(--surface-low);
    color: var(--text);
    font-weight: 800;
    font-size: 15px;
    margin-top: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }

  @media print {
    :global(header.site),
    :global(footer.site),
    :global(.ad-rail),
    .form-panel,
    .breadcrumb,
    .tool-head,
    .print-btn {
      display: none !important;
    }
    :global(.layout) {
      padding: 0 !important;
    }
    :global(main.col) {
      padding: 0 !important;
    }
    .tool-layout {
      display: block;
      margin-top: 0;
    }
  }
</style>

<script>
  const TIMES = ['아침', '점심', '저녁', '취침전'];
  interface Med {
    name: string;
    times: string[];
  }
  const meds: Med[] = [];

  const medNameInput = document.getElementById('medName') as HTMLInputElement;
  const addMedBtn = document.getElementById('addMedBtn')!;
  const medList = document.getElementById('medList')!;
  const scheduleEmpty = document.getElementById('scheduleEmpty')!;
  const scheduleTable = document.getElementById('scheduleTable')!;
  const scheduleBody = document.getElementById('scheduleBody')!;

  function renderSchedule() {
    medList.innerHTML = '';
    meds.forEach((m, i) => {
      const row = document.createElement('div');
      row.className = 'med-item';
      const info = document.createElement('div');
      info.innerHTML = `<div class="name">${m.name}</div><div class="times">${m.times.join(' · ')}</div>`;
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.setAttribute('aria-label', `${m.name} 삭제`);
      btn.textContent = '×';
      btn.addEventListener('click', () => {
        meds.splice(i, 1);
        renderSchedule();
      });
      row.appendChild(info);
      row.appendChild(btn);
      medList.appendChild(row);
    });

    if (meds.length === 0) {
      scheduleEmpty.style.display = 'block';
      scheduleTable.style.display = 'none';
      return;
    }
    scheduleEmpty.style.display = 'none';
    scheduleTable.style.display = 'table';
    scheduleBody.innerHTML = '';
    meds.forEach((m) => {
      const tr = document.createElement('tr');
      let html = `<td class="name-cell">${m.name}</td>`;
      TIMES.forEach((t) => {
        const on = m.times.indexOf(t) > -1;
        html += `<td class="${on ? 'on' : ''}">${on ? '●' : ''}</td>`;
      });
      tr.innerHTML = html;
      scheduleBody.appendChild(tr);
    });
  }

  addMedBtn.addEventListener('click', () => {
    const name = medNameInput.value.trim();
    if (!name) {
      medNameInput.focus();
      return;
    }
    const checks = document.querySelectorAll<HTMLInputElement>('.time-check input:checked');
    const times = Array.prototype.map.call(checks, (el: HTMLInputElement) => el.value) as string[];
    if (times.length === 0) return;
    meds.push({ name, times });
    medNameInput.value = '';
    checks.forEach((el) => (el.checked = false));
    renderSchedule();
    medNameInput.focus();
  });

  medNameInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') addMedBtn.click();
  });

  document.getElementById('printBtn')!.addEventListener('click', () => {
    window.print();
  });

  renderSchedule();
</script>
