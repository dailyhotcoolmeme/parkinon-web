---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import AdBox from '../../components/AdBox.astro';

const related = [
  {
    tag: '파킨온 소식 #10',
    title: '조기 진단에 도움 되는 후각 검사 연구 결과',
    excerpt: '후각 저하가 파킨슨병의 초기 신호가 될 수 있다는 연구 내용을 정리했습니다.',
    hashtags: ['#조기진단', '#후각검사'],
    date: '2026.07.20',
  },
  {
    tag: '파킨온 소식 #9',
    title: '웨어러블 기기로 떨림 증상을 추적하는 기술',
    excerpt: '손목시계형 기기로 하루 종일 떨림 패턴을 기록하는 새로운 연구를 소개합니다.',
    hashtags: ['#웨어러블', '#떨림추적'],
    date: '2026.07.16',
  },
];

// 사이드 목차 — 본문 h2 의 id·문구와 정확히 일치시킬 것(여기만 고치면 링크가 깨진다).
const toc = [
  { id: 'findings', label: '이렇게 나왔습니다' },
  { id: 'for-patients', label: '환자분께' },
  { id: 'for-caregivers', label: '보호자분께' },
];

// 같은 카테고리 다른 글 — /news 허브 목록에서 이 글만 뺀 것.
// 실제 글이 없는 항목은 허브와 똑같이 href 없이 둔다(지어내지 말 것).
const sideLinks: { title: string; date: string; href?: string }[] = [
  { title: '장내세균과 파킨슨병의 연관성, 어디까지 밝혀졌나', date: '2026.07.24' },
  { title: '조기 진단에 도움 되는 후각 검사 연구 결과', date: '2026.07.20' },
  { title: '웨어러블 기기로 떨림 증상을 추적하는 기술', date: '2026.07.16' },
  { title: '수면과 파킨슨병 진행 속도의 상관관계', date: '2026.07.11' },
  { title: '새로운 도파민 보충 치료제 임상시험 소식', date: '2026.07.07' },
  { title: '지중해식 식단과 파킨슨병 위험도 연구', date: '2026.07.02' },
];
---

<Layout title="운동이 도파민 신경세포를 보호한다는 새 연구 — 파킨온">
  <Header active="news" />

  <div class="layout">
    <aside class="ad-rail left">
      <AdBox minHeight="600px" />
    </aside>

    <main class="col">
      <div class="detail-body">
        <nav class="breadcrumb">
          <a href="/">홈</a><span class="sep">/</span><a href="/news">파킨온 소식</a><span class="sep">/</span>
          <span>운동이 도파민 신경세포를 보호한다는 새 연구</span>
        </nav>

        <article>
          <div class="article-head">
            <span class="tag">파킨온 소식 #12</span>
            <h1>운동이 도파민 신경세포를 보호한다는 새 연구</h1>
            <div class="hashtags"><span>#운동</span><span>#도파민</span><span>#신경보호연구</span></div>
            <div class="meta">
              <span>2026.07.29 작성</span>
            </div>
          </div>

          <div class="article-lead">이 글은 최근 발표된 연구와 기사 내용을 파킨온이 쉬운 말로 정리해 다시 쓴 것입니다.</div>

          <div class="article-body">
            <p>
              최근 국제 학술지에 발표된 연구에서, 꾸준한 유산소 운동이 도파민을 만드는 신경세포의 손상 속도를 늦출 수
              있다는 결과가 나왔습니다. 파킨슨병 초기 환자를 대상으로 한 이번 연구는 운동이 약물치료를 보완하는
              역할을 할 수 있음을 보여줍니다.
            </p>

            <div class="article-ad">
              <AdBox minHeight="120px" />
            </div>

            <h2 id="findings">이렇게 나왔습니다</h2>
            <p>
              연구팀은 초기 파킨슨병 환자 200여 명을 두 그룹으로 나눠, 한쪽은 주 3회 이상 규칙적인 유산소 운동을,
              다른 쪽은 평소와 같은 생활을 하도록 하고 2년간 추적했습니다. 뇌 영상 검사 결과, 규칙적으로 운동한
              그룹은 도파민 신경세포 손상이 상대적으로 더디게 진행된 것으로 나타났습니다.
            </p>

            <h2 id="for-patients">환자분께</h2>
            <p>
              운동이 약을 대신할 수는 없지만, 이미 드시고 있는 치료와 함께 진행 속도를 늦추는 데 도움이 될 수
              있다는 뜻입니다. 격렬한 운동이 아니어도 괜찮습니다. 빠르게 걷기, 자전거 타기처럼 숨이 살짝 찰 정도의
              유산소 운동을 주 3회, 30분씩 꾸준히 하는 것이 핵심입니다.
            </p>

            <h2 id="for-caregivers">보호자분께</h2>
            <p>
              환자분이 운동을 시작하거나 꾸준히 이어가기 어려워하실 때, 함께 걷거나 스트레칭을 도와주시는 것만으로도
              큰 힘이 됩니다. 무리한 목표보다는 "오늘 10분만 같이 걷자"처럼 작은 단위로 권해보세요.
            </p>
          </div>

          <div class="article-comment-cta">여러분은 어떤 운동을 하고 계신가요? 댓글로 서로의 방법을 나눠보세요.</div>

          <div class="article-disclaimer">
            ⚠️ 이 글은 의학적 진단이나 치료를 대신하지 않습니다. 운동을 시작하기 전 담당 의료진과 상담하시기 바랍니다.
          </div>

          <div class="article-source">
            📰 <b>출처</b> · Journal of Neurology(2026), "Aerobic Exercise and Nigrostriatal Dopaminergic Neuron Preservation
            in Early Parkinson's Disease"
          </div>

          <div class="article-share">
            <span>공유하기</span>
            <a class="share-btn" href="#" aria-label="카카오톡 공유">
              <svg viewBox="0 0 24 24" fill="currentColor"
                ><path
                  d="M12 3C6.5 3 2 6.4 2 10.6c0 2.7 1.8 5 4.5 6.4-.2.7-.7 2.6-.8 3-.1.5.2.5.4.4.2-.1 2.6-1.7 3.6-2.4.7.1 1.5.2 2.3.2 5.5 0 10-3.4 10-7.6S17.5 3 12 3z"
                ></path></svg
              >
            </a>
            <a class="share-btn" href="#" aria-label="링크 복사">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                ><path d="M10 13a5 5 0 0 0 7.5.5l2-2a5 5 0 0 0-7-7l-1.5 1.5"></path><path
                  d="M14 11a5 5 0 0 0-7.5-.5l-2 2a5 5 0 0 0 7 7l1.5-1.5"></path></svg
              >
            </a>
          </div>

          <div class="article-related">
            <h3>이런 글도 봤어요</h3>
            <div class="hub-list">
              {
                related.map((row) => (
                  <a class="hub-row" href="#">
                    <span class="tag">{row.tag}</span>
                    <h3>{row.title}</h3>
                    <p>{row.excerpt}</p>
                    <div class="hashtags">
                      {row.hashtags.map((h) => <span>{h}</span>)}
                    </div>
                    <p class="meta">{row.date}</p>
                  </a>
                ))
              }
            </div>
          </div>
        </article>

        <aside class="hub-side">
          <div class="hub-side-panel toc-panel">
            <h3>이 글 순서</h3>
            <ul>
              {
                toc.map((t) => (
                  <li>
                    <a href={`#${t.id}`}>{t.label}</a>
                  </li>
                ))
              }
            </ul>
          </div>

          <div class="hub-side-panel">
            <h3>파킨온 소식 다른 글</h3>
            <ul>
              {
                sideLinks.map((row) => (
                  <li>
                    <a href={row.href ?? '#'}>{row.title}</a>
                    <span class="d">{row.date}</span>
                  </li>
                ))
              }
            </ul>
          </div>
        </aside>
      </div>
    </main>

    <aside class="ad-rail right">
      <AdBox minHeight="600px" />
    </aside>
  </div>

  <Footer />
</Layout>

<style>
  /*
   * 상세 페이지 셸 — 본문(760px) + 오른쪽 사이드 패널(목차 + 같은 카테고리 다른 글).
   * 허브의 .hub-body/.hub-side 와 같은 패턴이며, 넓은 화면에서 본문 오른쪽이 비어 있던 것을
   * 실제 콘텐츠로 채우기 위한 것이다(website-plan.md "확립된 디자인 규칙" 2번).
   * 본문·사이드가 같이 들어가기엔 본문이 너무 눌리는 1080px 이하에서는 사이드를 감춘다.
   */
  .detail-body {
    display: grid;
    grid-template-columns: minmax(0, 760px) 300px;
    grid-template-rows: auto 1fr;
    column-gap: 44px;
    justify-content: center;
  }
  .detail-body > .breadcrumb {
    grid-column: 1;
    grid-row: 1;
  }
  .detail-body > article {
    grid-column: 1;
    grid-row: 2;
  }
  .detail-body > .hub-side {
    grid-column: 2;
    grid-row: 1 / span 2;
    align-self: start;
  }
  .hub-side {
    position: sticky;
    top: 100px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  @media (max-width: 1080px) {
    .detail-body {
      grid-template-columns: minmax(0, 760px);
    }
    .detail-body > .hub-side {
      display: none;
    }
  }
  .hub-side-panel {
    background: var(--surface-low);
    border-radius: 8px;
    padding: 22px 20px;
  }
  .hub-side-panel h3 {
    font-size: 14px;
    color: var(--text);
  }
  .hub-side-panel ul {
    margin-top: 14px;
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .hub-side-panel li {
    padding-bottom: 14px;
    border-bottom: 1px solid var(--outline);
  }
  .hub-side-panel li:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }
  .hub-side-panel a {
    font-size: 13.5px;
    font-weight: 700;
    color: var(--text);
    line-height: 1.5;
    display: block;
  }
  .hub-side-panel a:hover {
    color: var(--primary);
  }
  .hub-side-panel .d {
    display: block;
    margin-top: 5px;
    font-size: 11.5px;
    color: var(--text-sub);
    opacity: 0.75;
  }
  .toc-panel ul {
    gap: 11px;
  }
  .toc-panel li {
    padding-bottom: 0;
    border-bottom: none;
  }
  .breadcrumb {
    font-size: 13px;
    color: var(--text-sub);
    max-width: 760px;
    margin: 0 0 18px;
  }
  .breadcrumb a:hover {
    color: var(--primary);
  }
  .breadcrumb .sep {
    margin: 0 6px;
    opacity: 0.6;
  }
  article {
    max-width: 760px;
  }
  .article-head {
    max-width: 760px;
  }
  .article-head .tag {
    font-size: 12px;
    font-weight: 800;
    color: var(--primary);
    background: var(--secondary-container);
    padding: 5px 13px;
    border-radius: 4px;
    display: inline-block;
  }
  .article-head h1 {
    font-size: 30px;
    line-height: 1.42;
    color: var(--text);
    margin-top: 14px;
  }
  .article-head .hashtags {
    margin-top: 10px;
  }
  .article-head .meta {
    margin-top: 14px;
    font-size: 13px;
    color: var(--text-sub);
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    align-items: center;
  }
  .hashtags {
    font-size: 12px;
    color: var(--text-sub);
    opacity: 0.7;
  }
  .hashtags span {
    margin-right: 7px;
  }
  .article-lead {
    max-width: 760px;
    margin-top: 20px;
    border-left: 3px solid var(--primary);
    padding: 14px 18px;
    background: var(--secondary-container);
    border-radius: 0 12px 12px 0;
    font-size: 14px;
    color: var(--on-secondary-container);
    line-height: 1.7;
  }
  .article-body {
    max-width: 760px;
    margin-top: 32px;
  }
  .article-body h2 {
    font-size: 21px;
    color: var(--text);
    margin-top: 40px;
    margin-bottom: 14px;
    /* 사이드 목차로 이동했을 때 sticky 헤더에 제목이 가리지 않도록 */
    scroll-margin-top: 88px;
  }
  .article-body h2:first-child {
    margin-top: 0;
  }
  .article-body p {
    font-size: 16px;
    line-height: 1.85;
    color: var(--text);
    margin-top: 16px;
  }
  .article-body p:first-of-type {
    margin-top: 0;
  }
  .article-ad {
    max-width: 760px;
    margin: 36px 0;
  }
  .article-comment-cta {
    max-width: 760px;
    margin-top: 28px;
    padding: 16px 20px;
    background: var(--surface-low);
    border-radius: 12px;
    font-size: 14.5px;
    color: var(--text);
    font-weight: 700;
    text-align: center;
  }
  .article-disclaimer {
    max-width: 760px;
    margin-top: 16px;
    padding: 14px 18px;
    background: var(--tertiary-container);
    border-radius: 12px;
    font-size: 12.5px;
    color: var(--tertiary-dark);
    line-height: 1.7;
  }
  .article-source {
    max-width: 760px;
    margin-top: 16px;
    padding: 18px 20px;
    background: var(--surface-low);
    border-radius: 14px;
    font-size: 13px;
    color: var(--text-sub);
    line-height: 1.7;
  }
  .article-source b {
    color: var(--text);
  }
  .article-share {
    max-width: 760px;
    margin-top: 36px;
    padding-top: 24px;
    border-top: 1px solid var(--outline);
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .article-share span {
    font-size: 13px;
    font-weight: 700;
    color: var(--text-sub);
  }
  .share-btn {
    width: 40px;
    height: 40px;
    border-radius: 999px;
    background: var(--surface-low);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-sub);
  }
  .share-btn:hover {
    background: var(--surface-high);
  }
  .share-btn svg {
    width: 18px;
    height: 18px;
  }
  .article-related {
    max-width: 760px;
    margin-top: 48px;
  }
  .article-related > h3 {
    font-size: 17px;
    color: var(--text);
    margin-bottom: 12px;
  }
  .hub-list {
    display: flex;
    flex-direction: column;
  }
  .hub-row {
    display: block;
    padding: 24px 0;
    border-bottom: 1px solid var(--outline);
  }
  .hub-row:first-child {
    padding-top: 0;
  }
  .hub-row .tag {
    font-size: 11px;
    font-weight: 800;
    color: var(--primary);
    display: block;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .hub-row h3 {
    font-size: 18.5px;
    margin-top: 10px;
    color: var(--text);
    line-height: 1.4;
  }
  .hub-row p {
    margin-top: 6px;
    font-size: 14px;
    line-height: 1.65;
    color: var(--text-sub);
    max-width: 70ch;
  }
  .hub-row .hashtags {
    margin-top: 8px;
  }
  .hub-row .meta {
    margin-top: 10px;
    font-size: 12px;
    color: var(--text-sub);
    opacity: 0.75;
  }
</style>
